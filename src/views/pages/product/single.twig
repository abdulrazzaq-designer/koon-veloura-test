      backdrop-filter: var(--veloura-header-glass-filter, blur(20px) saturate(200%)) !important;
      filter: none !important;
      border-top: 1px solid var(--veloura-header-glass-edge-top, rgba(100, 116, 139, .10)) !important;
      box-shadow: 0 -8px 24px var(--veloura-header-glass-shadow, rgba(15, 23, 42, .10)) !important;
