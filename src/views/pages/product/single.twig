    /* لا طبقة معتمة فوق الزجاج من قواعد أقدم. */
    .veloura-product-page.veloura-product-mobile-sticky-enabled .veloura-product-sticky-bar::before,
    .veloura-product-page.veloura-product-mobile-sticky-enabled .veloura-product-sticky-bar::after {
      background: transparent !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }
  }

  /* 10) عمود التعريف في تقسيم الجوال: تدرّج واضح — اسم بارز، وما حوله أهدأ. */
  @media (max-width: 767px) {
    .veloura-product-page.veloura-product-mobile-split .veloura-pp-split__info { gap: 6px !important; }
    .veloura-product-page.veloura-product-mobile-split .veloura-pp-split__info .veloura-product-brand {
