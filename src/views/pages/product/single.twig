<script id="veloura-product-order-v22">
(function(){function init(){
var page=document.querySelector('.veloura-product-page');if(!page)return;
var wrap=page.querySelector('[id^="product-"]'),main=wrap&&wrap.querySelector(':scope > .main-content'),sidebar=wrap&&wrap.querySelector(':scope > .sidebar');if(!main||!sidebar)return;
var touched=[];
function rank(key,fallback){var raw=page.getAttribute(key),n=raw===null?fallback:Number(raw);return Number.isFinite(n)?Math.max(1,Math.min(10,n)):fallback}
function place(node,row,column){if(!node)return;node.style.setProperty('grid-row',String(row),'important');node.style.setProperty('grid-column',column,'important');touched.push(node)}
function apply(){
touched.forEach(function(n){n.style.removeProperty('grid-row');n.style.removeProperty('grid-column')});touched=[];
var enabled=innerWidth<=767&&page.getAttribute('data-v42-order-enabled')==='true';wrap.classList.toggle('veloura-ordered-layout',enabled);if(!enabled)return;
var info=wrap.querySelector(':scope > .veloura-pp-split__info'),split=!!info;
var entries=[{nodes:split?[sidebar,info]:[sidebar],rank:rank(split?'data-v22-split-order-identity':'data-v22-order-image',1),identity:true}];
Array.from(main.children).forEach(function(n){if(['SCRIPT','STYLE','TEMPLATE'].includes(n.tagName))return;var group=n.getAttribute('data-v42-group');var key=(split?'data-v22-split-order-':'data-v42-order-')+group;entries.push({nodes:[n],rank:rank(key,rank('data-v42-order-'+group,10))})});
entries.sort(function(a,b){return a.rank-b.rank});entries.forEach(function(entry,i){entry.nodes.forEach(function(n,j){place(n,i+1,entry.identity&&split?String(j+1):'1 / -1')})});
}
apply();window.addEventListener('resize',function(){requestAnimationFrame(apply)});window.addEventListener('load',apply,{once:true});
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();})();
</script>



<script id="veloura-description-fold-v6">
(function () {
  function boot() {
    var card = document.querySelector('[data-veloura-description-fold="true"]');
    if (!card || card.dataset.foldBound) return;
    var article = card.querySelector('#more-content');
    var button = card.querySelector('.veloura-description-toggle');
    if (!article || !button) return;
    card.dataset.foldBound = 'true';
    var expanded = false;
    var limit = 220;
    var finishTimer;
    var animating = false;
    function finish() {
      clearTimeout(finishTimer);
      animating = false;
      button.textContent = expanded ? 'عرض أقل' : 'عرض المزيد';
      button.removeAttribute('aria-busy');
      if (!expanded && button.getBoundingClientRect().top < 0) {
        button.scrollIntoView({block: 'center', behavior: 'smooth'});
      }
    }
    function update() {
      var long = article.scrollHeight > limit + 2;
      button.hidden = !long;
      card.classList.toggle('v-description-fold-ready', long);
      card.classList.toggle('is-description-expanded', expanded);
      card.style.setProperty('--veloura-description-surface', getComputedStyle(card).backgroundColor);
      article.style.setProperty('max-height', (long && !expanded ? limit : article.scrollHeight) + 'px', 'important');
      button.setAttribute('aria-expanded', String(!long || expanded));
      if (!animating) button.textContent = expanded ? 'عرض أقل' : 'عرض المزيد';
    }
    button.addEventListener('click', function () {
      clearTimeout(finishTimer);
      animating = true;
      button.setAttribute('aria-busy', 'true');
      expanded = !expanded;
      update();
      finishTimer = setTimeout(finish, matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 450);
    });
    article.addEventListener('transitionend', function (event) {
      if (event.target === article && event.propertyName === 'max-height' && animating) finish();
    });
    update();
    var lastWidth = article.clientWidth;
    if ('ResizeObserver' in window) new ResizeObserver(function () {
      if (article.clientWidth !== lastWidth) { lastWidth = article.clientWidth; update(); }
    }).observe(article);
    new MutationObserver(update).observe(article, {childList: true, subtree: true, characterData: true});
    var themeObserver = new MutationObserver(update);
    themeObserver.observe(document.documentElement, {attributes: true, attributeFilter: ['class']});
    themeObserver.observe(document.body, {attributes: true, attributeFilter: ['class']});
    article.addEventListener('load', update, true);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(update);
    window.addEventListener('resize', update);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, {once:true});
  else boot();
})();
</script>


