    .veloura-product-page.veloura-product-mobile-split .veloura-pp-split__info .veloura-product-brand .brand-logo img {
      width: 20px !important;
      height: 20px !important;
      min-width: 20px !important;
      max-width: 20px !important;
      max-height: 20px !important;
    }
    .veloura-product-page.veloura-product-mobile-split .veloura-pp-split__info h1 {
      order: 1 !important;
      font-size: 18px !important;
      font-weight: 800 !important;
      line-height: 1.55 !important;
      padding-bottom: 8px !important;
      border-bottom: 1px solid color-mix(in srgb, currentColor 14%, transparent) !important;
    }
    .veloura-product-page.veloura-product-mobile-split .veloura-pp-split__info .veloura-product-header-price { order: 2 !important; }
    .veloura-product-page.veloura-product-mobile-split .veloura-pp-split__info salla-rating-stars { order: 3 !important; }
    .veloura-product-page.veloura-product-mobile-split .veloura-pp-split__info .veloura-product-stock-radar {
      order: 4 !important;
      margin: 0 !important;
    }
    /* التصنيف آخر العمود وبحجم أصغر حتى لا ينافس الاسم. */
    .veloura-product-page.veloura-product-mobile-split .veloura-pp-split__info .veloura-product-category-under-title {
      order: 5 !important;
      margin: 0 !important;
      padding: 0 !important;
      background: none !important;
      font-size: 12px !important;
      opacity: .85 !important;
    }
  }
  /* 8ب) قائمة المشاركة العمودية (النسخة غير المنبثقة): سلة ترسمها بيضاء
     بحواف 1.5rem ثابتة — لهذا كانت تظهر قطعة بيضاء ثم الأيقونات. */
  .veloura-product-page salla-social-share .s-social-share-list,
  salla-social-share .s-social-share-list {
    background-color: var(--veloura-product-bg-inline, var(--veloura-site-bg, #ffffff)) !important;
    border-radius: var(--veloura-product-radius-final, var(--veloura-product-radius, 28px)) !important;
    box-shadow: none !important;
    border: 1px solid rgba(15, 23, 42, .08) !important;
    overflow: hidden !important;
  }
  html.dark salla-social-share .s-social-share-list,
  body.dark salla-social-share .s-social-share-list {
    background-color: var(--veloura-product-dark-secondary-bg-inline, var(--veloura-dark-secondary-bg, #161b22)) !important;
    border-color: rgba(255, 255, 255, .10) !important;
  }
  salla-social-share .s-social-share-list a svg { fill: currentColor !important; }
  html.dark salla-social-share .s-social-share-list a,
  body.dark salla-social-share .s-social-share-list a {
    color: var(--veloura-dark-primary-text, #ffffff) !important;
  }
  /* زر المشاركة/الإغلاق يتبع الحواف أيضًا. */
  .veloura-product-page salla-social-share .s-social-share-btn,
  .veloura-product-page .veloura-product-media-share {
    border-radius: min(var(--veloura-product-radius, 28px), 50%) !important;
  }

  /* 11) ويدجتات سلة الخارجية (التقسيط والعروض): داخل بطاقة بحواف الصفحة
     بدل شريط ممتد بعرض الصفحة. */
  .veloura-product-page salla-installment,
  .veloura-product-page salla-offer {
    display: block !important;
    border-radius: var(--veloura-product-radius-final, var(--veloura-product-radius, 28px)) !important;
    overflow: hidden !important;
  }
  .veloura-product-page salla-installment iframe,
  .veloura-product-page salla-offer iframe {
    border-radius: inherit !important;
    display: block !important;
    max-width: 100% !important;
  }
  /* 12) فتح الوصف: تثبيت المرساة. المتصفح يعيد ضبط التمرير عند تغيّر ارتفاع
     عنصر داخل الصفحة (scroll anchoring)، وهو سبب قفزة «اقرأ المزيد». */
  .veloura-product-page,
  .veloura-product-page .main-content,
  .veloura-product-page .product__description,
  .veloura-product-page #more-content,
  .veloura-product-page .article--main {
    overflow-anchor: none !important;
  }
  /* 13) بعد إلغاء زر «اقرأ المزيد»: لا حاجة للفراغ الذي كان مخصصًا له،
     والوصف يظهر كاملًا بلا قصّ. */
  .veloura-product-page .product__description {
    margin-bottom: 16px !important;
    padding-bottom: 16px !important;
  }
  .veloura-product-page .product__description .article--main,
  .veloura-product-page .product__description #more-content {
    max-height: none !important;
    overflow: visible !important;
  }
</style>
