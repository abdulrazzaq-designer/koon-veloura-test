<div
  data-veloura-recovered="true"
  data-veloura-product-data-build="v98"

  data-v22-order-image="{{ _self.veloura_select(theme.settings.get('veloura_product_order_image_2026', 1), 1)|trim }}"
  data-v22-split-order-identity="{{ _self.veloura_select(theme.settings.get('veloura_product_split_order_identity_2026', 1), 1)|trim }}"
  data-v22-split-order-status="{{ _self.veloura_select(theme.settings.get('veloura_product_split_order_status_2026', 3), 3)|trim }}"
  data-v22-split-order-description="{{ _self.veloura_select(theme.settings.get('veloura_product_split_order_description_2026', 5), 5)|trim }}"
  data-v22-split-order-data="{{ _self.veloura_select(theme.settings.get('veloura_product_split_order_data_2026', 6), 6)|trim }}"
  data-v22-split-order-extras="{{ _self.veloura_select(theme.settings.get('veloura_product_split_order_extras_2026', 7), 7)|trim }}"
  data-v22-split-order-options="{{ _self.veloura_select(theme.settings.get('veloura_product_split_order_options_2026', 8), 8)|trim }}"
  data-v22-split-order-quick="{{ _self.veloura_select(theme.settings.get('veloura_product_split_order_quick_2026', 9), 9)|trim }}"
  data-v22-split-order-payments="{{ _self.veloura_select(theme.settings.get('veloura_product_split_order_payments_2026', 10), 10)|trim }}"
  data-v42-order-enabled="{{ vpp_details_order_enabled ? 'true' : 'false' }}"
  data-v96-stock-pulse="{{ vpp_show_stock_radar ? 'true' : 'false' }}"
  data-v42-order-title="{{ vpp_order_title }}"
  data-v42-order-price="{{ vpp_order_price }}"
  data-v42-order-status="{{ vpp_order_status }}"
  data-v42-order-description="{{ vpp_order_description }}"
  data-v42-order-data="{{ vpp_order_data }}"
  data-v42-order-extras="{{ vpp_order_extras }}"
  data-v42-order-options="{{ vpp_order_options }}"
  data-v42-order-quick="{{ vpp_order_quick }}"
  data-v42-order-payments="{{ vpp_order_payments }}"
  data-veloura-sticky="{{ vpp_mobile_sticky_cart ? 'true' : 'false' }}"
     data-veloura-product-build="v100-native-related-recent" data-veloura-stock-radar="{{ vpp_show_stock_radar ? 'pulse' : 'simple' }}" data-veloura-images-zoom="{{ vpp_images_zoom ? 'true' : 'false' }}" data-veloura-quantity-style="{{ vpp_mobile_quantity_style }}" class="container veloura-product-page {{ vpp_center_details ? 'veloura-product-center-details' : '' }} {{ vpp_enabled ? 'veloura-product-enabled' : '' }} {{ vpp_hide_breadcrumb ? 'veloura-product-hide-breadcrumb' : '' }} {{ vpp_hide_thumbnails ? 'veloura-product-hide-thumbs' : '' }} veloura-product-images-{{ vpp_images_height_mode }} {{ vpp_images_zoom ? 'veloura-product-zoom-enabled' : '' }} {{ vpp_enabled and vpp_hide_short_description ? 'veloura-product-desc-collapsed' : '' }} {{ vpp_mobile_sticky_cart ? 'veloura-product-mobile-sticky-enabled' : 'veloura-product-mobile-sticky-disabled' }} {{ vpp_mobile_sticky_price ? 'veloura-product-mobile-sticky-price' : '' }} veloura-product-qty-{{ vpp_mobile_quantity_style }} {{ vpp_mobile_buttons_compact ? 'veloura-product-buttons-compact' : '' }} {{ vpp_hide_discount_value ? 'veloura-product-hide-discount' : '' }} {{ vpp_hide_tags_visual_only ? 'veloura-product-tags-visual-hidden' : '' }} {{ vpp_mobile_split ? 'veloura-product-mobile-split' : '' }}" style="--veloura-pp-split: {{ vpp_mobile_split_ratio }}%; --veloura-product-bg-inline: {{ vpp_basic_bg }}; --veloura-product-secondary-bg-inline: {{ vpp_second_bg }}; --veloura-product-dark-bg-inline: {{ vpp_dark_basic_bg }}; --veloura-product-dark-secondary-bg-inline: {{ vpp_dark_second_bg }}; --veloura-product-radius: {{ vpp_general_radius }};" >

        {# add breadcumbs container in pages to make a space in case breadcrumbs is off #}
        {% if not (vpp_enabled and vpp_hide_breadcrumb) %}
            <nav class="breadcrumbs w-full py-5 veloura-product-breadcrumb">
                <salla-breadcrumb></salla-breadcrumb>
            </nav>
        {% endif %}
        <div class="flex flex-col items-start md:flex-row" id="product-{{ product.id }}">
            <div class="sidebar md:sticky top-24 w-full md:!w-2/4 rtl:ml-8 ltr:mr-8 pb-8 md:pb-16 overflow-hidden shrink-0">
                {% set has_many_images = product.images|length > 1 %}
                <salla-slider
                        id="details-slider-{{ product.id }}"
                        class="details-slider rounded-md image-slider"
                        type="thumbs"
                        loop="false"
                        {{ vpp_images_height_mode == 'fixed_all' ? '' : 'auto-height' }}
                        listen-to-thumbnails-option
                thumbs-config='{
                  "slidesPerView": 4,
                  "slidesPerGroup": 1,
                  "spaceBetween": 10,
                  "freeMode": true,
                  "watchSlidesProgress": true,
                  "allowTouchMove": true,
                  "roundLengths": true,
                  "breakpoints": {
                    "768": {"slidesPerView": 5, "slidesPerGroup": 1, "spaceBetween": 12}
                  }
                }'
                show-thumbs-controls="false">
                    {% if vpp_media_actions_position == 'image' %}
                    <div class="veloura-product-media-actions">
                        <div class="veloura-product-media-actions__left">
                            <button type="button"
                                    class="veloura-product-media-action-btn veloura-product-media-wishlist"
                                    data-id="{{ product.id }}"
                                    onclick="salla.wishlist.toggle('{{ product.id }}')"
                                    aria-label="add to wishlist">
                                <i class="sicon-heart"></i>
                            </button>

                            <salla-social-share
                                    class="veloura-product-media-action-btn veloura-product-media-share"
                                    aria-label="social share">
                            </salla-social-share>
                        </div>


                    </div>
                    {% endif %}

                    {% if product.promotion_title %}
                      <div class="veloura-product-media-actions veloura-product-promo-fixed">
                        <div class="promotion-title veloura-product-media-promo">{{ product.promotion_title }}</div>
                      </div>
                    {% endif %}

                    {# Calories Badge #}
                    {% if product.calories %}
                        <div class="absolute z-[2] top-4 rtl:left-4 ltr:right-4 shadow-sm flex flex-col justify-center items-center rounded-full w-20 h-20 md:w-24 md:h-24 veloura-product-calories-badge">
                            <span class="text-red-500 text-xl leading-none font-bold">{{ product.calories }}</span>
                            <span class="text-xs text-gray-500">{{ trans('pages.products.calories') }}</span>
                        </div>
                    {% endif %}

                    <div slot="items">
                        {% for image in product.images %}
                            {% if image.three_d_image_url %}
                                <model-viewer style="min-height: 500px;" class="swiper-slide model-entry w-full h-full"
                                    loading="eager" camera-controls
                                    touch-action="pan-y" auto-rotate
                                    poster="{{ image.url }}"
                                    src="{{ image.three_d_image_url }}"
                                    shadow-intensity="1" alt="{{ image.alt }}">
                                </model-viewer>
                                    {% else %}
                                <a data-fslightbox="product_{{ product.id }}"
                                   data-img-id="{{ image.id }}"
                                   data-slid-index="{{ loop.index-1 }}"{% if image.video_url %} data-video-src="{{ image.video_url }}"{% endif %}
                                   data-caption="{{ image.alt }}"
                                   data-infinite="false"
                                   data-type="{{ image.video_url?'youtube':'image' }}"
                                   href="{{ (image.video_url is iterable ? image.video_url|first : image.video_url)|default(image.url) }}"
                                   aria-label="{{ product.name }}"
                                   class="swiper-slide magnify-wrapper homeslider__slide {{ image.video_url?'video-entry':'' }}">
                                    {% if loop.first %}
                                        <img id="{{image.id}}" fetchpriority="high" loading="eager" src="{{ image.url }}"
                                             alt="{{ image.alt }}"
                                             class="h-full object-{{ theme.settings.get('slider_background_size') }} w-full {{ image.three_d_image_url ? 'model-poster' : '' }}">
                                    {% else %}
                                        <img id="{{image.id}}" src="{{ image.url }}"
                                             loading="lazy"
