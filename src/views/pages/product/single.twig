  }
  .s-social-share-modal-handle { background: currentColor !important; opacity: .25 !important; }
  .veloura-product-page salla-social-share .s-social-share-btn {
    border-radius: min(var(--veloura-product-radius, 28px), 50%) !important;
  }

  /* 9) الشريط السفلي الثابت: نفس زجاج الهيدر حرفيًا — نفس الخلفية ونفس البلور
        ونفس الحواف، عبر متغيّرات الهيدر ذاتها حتى لا يختلفا أبدًا. */
  @media (max-width: 767px) {
    .veloura-product-page.veloura-product-mobile-sticky-enabled .sticky-product-bar,
    .veloura-product-page.veloura-product-mobile-sticky-enabled .veloura-product-sticky-bar {
      background: var(--veloura-header-glass-background, color-mix(in srgb, var(--veloura-site-second-bg, #e4e7eb) 65%, transparent)) !important;
