  {% set vfab_labels = _self.veloura_dm_value(theme.settings.get('veloura_fab_labels_2026', true), true)|trim in [true, 1, '1', 'true', 'on'] %}
  {% set vfab_desktop = _self.veloura_dm_value(theme.settings.get('veloura_fab_desktop_2026', false), false)|trim in [true, 1, '1', 'true', 'on'] %}
  {% set vfab_glass = _self.veloura_dm_value(theme.settings.get('veloura_fab_glass_2026', false), false)|trim in [true, 1, '1', 'true', 'on'] %}
  {% set vfab_show_top = _self.veloura_dm_value(theme.settings.get('veloura_fab_show_top_2026', true), true)|trim in [true, 1, '1', 'true', 'on'] %}

  {% set vfab_top_after = _self.veloura_dm_value(theme.settings.get('veloura_fab_top_after_2026', 420), 420)|trim + 0 %}
