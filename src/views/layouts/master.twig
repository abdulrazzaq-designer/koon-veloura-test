{# ==========================================================================
   الفوتر: منصة واحدة مرة واحدة (فيلورا)

   The same account entered twice in the dashboard — with and without the www,
   or with a trailing slash — comes back from <salla-social> as two links, and
   the footer showed both side by side. The de-duplication lives in the bundled
   script as well, but that goes through a build and a CDN; this runs the
   moment the Twig is published.

   Nothing is removed: the extra link is hidden, so if Salla re-renders the row
   the original markup is still whole underneath.
   ========================================================================== #}
<script data-cfasync="false" id="veloura-footer-social-dedupe-2026">
(function () {
  var PLATFORMS = [
    ['whatsapp', /wa\.me|whatsapp|واتساب/],
    ['snapchat', /snapchat|snap\.com|سناب/],
    ['instagram', /instagram|انستقرام|انستغرام/],
    ['tiktok', /tiktok|تيك/],
    ['twitter', /twitter\.com|x\.com|إكس/],
    ['telegram', /t\.me|telegram|تلجرام|تيليجرام/],
    ['youtube', /youtube|youtu\.be|يوتيوب/],
    ['facebook', /facebook|fb\.com|فيسبوك/],
    ['pinterest', /pinterest/],
    ['linkedin', /linkedin/],
    ['email', /mailto:/],
    ['phone', /tel:/]
  ];

  var platformOf = function (link) {
    var haystack = [
      link.getAttribute('href') || '',
      link.getAttribute('aria-label') || '',
      link.getAttribute('title') || '',
      link.className || '',
      (link.innerHTML || '').slice(0, 400)
    ].join(' ').toLowerCase();

    for (var i = 0; i < PLATFORMS.length; i++) {
      if (PLATFORMS[i][1].test(haystack)) return PLATFORMS[i][0];
    }

    return '';
  };

  var dedupe = function () {
    document.querySelectorAll('[data-veloura-footer-social]').forEach(function (row) {
      /* The theme builds its own cards from the native links; where it has,
         the native row is the same accounts a second time — that is the pair of
         identical groups standing side by side, not a duplicate account. */
      var cards = row.querySelector('.veloura-footer-social-cards');

      row.querySelectorAll('salla-social').forEach(function (native) {
        if (cards && cards.querySelector('a[href]')) {
          native.style.setProperty('display', 'none', 'important');
        } else {
          native.style.removeProperty('display');
        }
      });

      var seen = {};

      row.querySelectorAll('a[href]').forEach(function (link) {
        var platform = platformOf(link);
        if (!platform) return;

        /* The card the theme builds and the native link it was built from are
           the same account twice over; only their own row is compared. */
        var card = link.closest('.veloura-footer-social-card') || link;
        var host = card.closest('.veloura-footer-social-cards') ? 'cards' : 'native';
        var key = host + ':' + platform;

        if (!seen[key]) {
          seen[key] = true;
          card.removeAttribute('data-veloura-dupe');
          return;
        }

        card.setAttribute('data-veloura-dupe', '1');
        card.style.setProperty('display', 'none', 'important');
      });
    });
  };

  /* <salla-social> fills itself in after the page, and the theme's own footer
     script rebuilds the row on top of that — so this is run again a few times
     rather than once, and then left alone. */
  var runs = 0;

  var schedule = function () {
    dedupe();
    if (++runs > 6) return;
    setTimeout(schedule, runs * 600);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', schedule);
  } else {
    schedule();
  }

  window.addEventListener('load', dedupe);
})();
</script>

{# ==========================================================================
   القائمة الجانبية: الزجاج يبقى زجاجًا في الوضع الداكن (فيلورا)

   The dark palette was winning over the glass: a later rule painted the
   drawer's surface with the side-menu dark background and dropped the blur,
   so a menu the merchant had set to glass came back opaque the moment the
   store went dark. This block is written after everything else and carries
   both the class on <html> and one on <body>, which is heavier than anything
   in the built stylesheet — and it only ever applies while the glass option is
   actually on.

   The inner panels are cleared as well: a blurred surface shows nothing if the
   lists on top of it are painted solid.
