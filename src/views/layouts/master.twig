  <script data-cfasync="false" id="veloura-fab-script-2026">
  (function () {
    /* The bottom bar is hidden while the side menu is open and put back when
       the menu's own close runs. Closing it any other way — the backdrop, the
       drawer's own button, the back gesture — never reaches that code, and the
       bar stayed gone for the rest of the visit.

       The check runs on a short timer that exists ONLY while the menu is open,
       and stops itself the moment the bar is back. An observer over the whole
       document was the first attempt and it was far too expensive: every class
       change anywhere on a busy page woke a document-wide query. */
    var restoreBottomNav = function () {
      if (document.querySelector('.mm-ocd.mm-ocd--open')) return false;

      var nav = document.querySelector('[data-vbn]');

      if (nav && nav.classList.contains('is-side-menu-suppressed')) {
        nav.classList.remove('is-side-menu-suppressed');
        nav.removeAttribute('aria-hidden');
      }

      if (document.body.classList.contains('veloura-bottom-nav-categories-open')) {
        document.body.classList.remove('veloura-bottom-nav-categories-open');
      }

      return true;
    };

