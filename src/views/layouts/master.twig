<style>
  /* ========================================================================
     نقاط الشرائح — الشكل الموحّد

     تُطبَّق على نقاط سلة الأصلية وعلى نقاطنا معاً، فيخرج كل شريط في المتجر
     بنفس الشكل. الكلاس مكرّر ثلاثاً عن قصد: القالب المبني يلوّن هذه النقاط
     في كل قسم على حدة بقواعد important وانتقائية أعلى، وبدون هذا التكرار
     كان العرض وحده يتغيّر ويبقى اللون لقاعدة القسم — وهو ما جعل النقاط
     تبدو كلها فاتحة في بعض الأقسام.

     الخامل ليس «نشطاً شفافاً»: له لون خافت وحد داخلي رفيع يجعله يُقرأ كخانة
     فارغة تنتظر دورها، والنشط له عمق خفيف تحته. هذا ما يفرق بين نقاط
     افتراضية ونقاط مصمّمة.
     ======================================================================== */
  html body {
    --veloura-dot-size: {{ vdots_size }}px;
    --veloura-dot-on: {{ vdots_color }};
    --veloura-dot-off: {{ vdots_idle }};
  }

  html body .swiper-pagination-bullet,
  html body .veloura-dots__dot {
    width: var(--veloura-dot-size) !important;
    height: var(--veloura-dot-size) !important;
    min-width: var(--veloura-dot-size) !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    border-radius: 999px !important;
    background: color-mix(in srgb, var(--veloura-dot-off) 24%, transparent) !important;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--veloura-dot-off) 34%, transparent) !important;
    opacity: 1 !important;
    transform: none !important;
    transition: width .34s cubic-bezier(.4, 0, .2, 1),
                background-color .34s ease,
                box-shadow .34s ease,
                transform .34s cubic-bezier(.34, 1.4, .64, 1) !important;
    cursor: pointer;
  }

  html body .swiper-pagination-bullet-active,
  html body .veloura-dots__dot.is-on {
    background: var(--veloura-dot-on) !important;
    box-shadow: 0 3px 10px color-mix(in srgb, var(--veloura-dot-on) 38%, transparent) !important;
  }

  html body .swiper-pagination,
  html body .veloura-dots {
    display: flex !important;
    gap: calc(var(--veloura-dot-size) * .85) !important;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }

  html body .veloura-dots { margin-top: 16px; }

{% if vdots_style == 'bar' %}
  /* شريط يتمدد: الخامل خانة قصيرة، والنشط يمتد ويأخذ تدرّجاً خفيفاً يوحي
     بالاتجاه. أوضح مؤشر موضع بأقل ضجيج. */
  html body .swiper-pagination-bullet,
  html body .veloura-dots__dot {
    width: calc(var(--veloura-dot-size) * 2.4) !important;
    min-width: calc(var(--veloura-dot-size) * 2.4) !important;
    height: calc(var(--veloura-dot-size) * .72) !important;
  }

  html body .swiper-pagination-bullet-active,
  html body .veloura-dots__dot.is-on {
    width: calc(var(--veloura-dot-size) * 5.2) !important;
    min-width: calc(var(--veloura-dot-size) * 5.2) !important;
    background: linear-gradient(to left,
      var(--veloura-dot-on),
      color-mix(in srgb, var(--veloura-dot-on) 62%, transparent)) !important;
  }
{% elseif vdots_style == 'ring' %}
  /* حلقة حول النشطة: النقطة تصغر قليلاً وتحيطها هالة، فتبدو كأنها محدّدة. */
  html body .swiper-pagination-bullet-active,
  html body .veloura-dots__dot.is-on {
    transform: scale(.82) !important;
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--veloura-dot-on) 26%, transparent),
      0 2px 8px color-mix(in srgb, var(--veloura-dot-on) 30%, transparent) !important;
  }
{% elseif vdots_style == 'diamond' %}
  html body .swiper-pagination, html body .veloura-dots {
    padding-block: calc(var(--veloura-dot-size, 8px) * .75) !important;
    min-height: calc(var(--veloura-dot-size, 8px) * 3) !important;
    height: auto !important; overflow: visible !important; box-sizing: border-box;
  }

  html body .swiper-pagination-bullet,
  html body .veloura-dots__dot {
    border-radius: 0 !important;
    transform: rotate(45deg) !important;
