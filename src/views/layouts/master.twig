<head>
    <script data-veloura-dark-bootstrap>
      (function () {
        var root = document.documentElement;
        var config = {
          enabled: {{ vdm_enabled ? 'true' : 'false' }},
          mode: {{ vdm_mode|json_encode|raw }},
          toggleEnabled: {{ vdm_toggle_enabled ? 'true' : 'false' }},
          storageKey: 'veloura_dark_mode'
        };

        function readSavedMode() {
          if (!config.toggleEnabled) return null;
          try {
            var saved = localStorage.getItem(config.storageKey);
            return saved === 'dark' || saved === 'light' ? saved : null;
          } catch (error) {
            return null;
          }
        }

        var savedMode = readSavedMode();
        var systemDark = false;

        try {
          systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        } catch (error) {}

        var dark = false;

        if (config.enabled) {
          if (savedMode) {
            dark = savedMode === 'dark';
          } else if (config.mode === 'auto') {
            dark = systemDark;
          } else {
            dark = config.mode === 'dark';
          }
        }

        root.classList.toggle('dark', dark);
        root.setAttribute('data-theme', dark ? 'dark' : 'light');
        root.style.colorScheme = dark ? 'dark' : 'light';

        window.velouraDarkConfig = config;
        window.__velouraDarkInitial = dark;
      })();
    </script>
