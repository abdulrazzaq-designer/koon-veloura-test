    .veloura-fab--glass .veloura-fab__btn {
      background: var(--veloura-glass-surface, rgba(230, 232, 235, .72));
      background-color: var(--veloura-glass-surface, rgba(230, 232, 235, .72));
      color: var(--vfab-color, #004956);
      border-top: 1px solid var(--veloura-glass-edge-top, rgba(100, 116, 139, .11));
      border-bottom: 1px solid var(--veloura-glass-edge-bottom, rgba(100, 116, 139, .05));
