  {% set vfab_map = {
    'whatsapp':  {'icon': 'sicon-whatsapp', 'color': '#25D366', 'label': 'واتساب',   'prefix': 'https://wa.me/'},
    'phone':     {'icon': 'sicon-phone',    'color': '#0ea5e9', 'label': 'اتصل بنا', 'prefix': 'tel:'},
    'instagram': {'icon': 'sicon-instagram','color': '#E1306C', 'label': 'انستقرام', 'prefix': 'https://instagram.com/'},
    'snapchat':  {'icon': 'sicon-snapchat', 'color': '#FFC400', 'label': 'سناب شات', 'prefix': 'https://snapchat.com/add/', 'ink': '#1f2937'},
    'tiktok':    {'icon': 'sicon-tiktok',   'color': '#111111', 'label': 'تيك توك',  'prefix': 'https://tiktok.com/@'},
    'x':         {'icon': 'sicon-twitter',  'color': '#111111', 'label': 'إكس',      'prefix': 'https://x.com/'},
    'telegram':  {'icon': 'sicon-telegram', 'color': '#229ED9', 'label': 'تيليجرام', 'prefix': 'https://t.me/'},
    'email':     {'icon': 'sicon-email',    'color': '#6366f1', 'label': 'راسلنا',   'prefix': 'mailto:'},
    'maps':      {'icon': 'sicon-location', 'color': '#16a34a', 'label': 'موقعنا',   'prefix': 'https://maps.google.com/?q='},
    'sizes':     {'icon': 'sicon-ruler',    'color': '#005369', 'label': 'دليل المقاسات', 'prefix': ''},
    'loyalty':   {'icon': 'sicon-star',     'color': '#d97706', 'label': 'ولاء العملاء', 'prefix': ''},
    'custom':    {'icon': 'sicon-link',     'color': '#004956', 'label': 'رابط',     'prefix': ''}
