{# VELOURA HOME TAB ASSIGNMENT START #}
{% set veloura_home_tab_key = component.veloura_home_tab_name_2026|default('') %}
{% if veloura_home_tab_key.value is defined %}{% set veloura_home_tab_key = veloura_home_tab_key.value %}{% endif %}
{% if not veloura_home_tab_key %}{% set veloura_home_tab_key = 'always' %}{% endif %}
{# VELOURA HOME TAB ASSIGNMENT END #}

{% set radius_map = {
  'sharp': '0px',
  'soft': '8px',
  'medium': '14px',
  'large': '22px',
  'round': '999px',
  '40': '999px'
} %}

{% if not component.veloura_faq_hide_section %}

{% set faq_classes = [
  's-block',
  'veloura-faq',
  component.veloura_faq_enable_custom_spacing ? 'has-spacing' : '',
  component.veloura_faq_custom_classes ?: ''
] %}

{% if component.veloura_faq_show_mobile_only %}
  {% set faq_classes = faq_classes|merge(['veloura-faq-mobile-only']) %}
{% endif %}

{% if component.veloura_faq_show_desktop_only %}
  {% set faq_classes = faq_classes|merge(['veloura-faq-desktop-only']) %}
{% endif %}

<style>
/* الأسئلة الشائعة — تُكتب هنا لا في ملف الستايل، فالملف المبني قد يكون على
   المتجر نسخة أقدم من القالب. */

/* عمودان على اللابتوب: العناصر أبناء مباشرون للغلاف، فيكفي أن يصير شبكة
   ويمتد العنوان على العمودين. */
@media (min-width: 1024px) {
  .veloura-faq .veloura-faq__inner {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 16px 20px !important;
    align-items: start !important;
  }

  /* الانتقائية أعلى عن قصد: القاعدة العامة للعنوان مكتوبة بعد هذا الاستعلام،
     ولو تساوت الانتقائيتان لفازت هي. */
  .veloura-faq .veloura-faq__inner > .veloura-faq__heading {
    grid-column: 1 / -1 !important;
    /* فجوة الشبكة تُضاف للهامش، فيُقلَّص هنا حتى تبقى المسافة الكلية واحدة. */
    margin-bottom: 8px !important;
  }

  /* الفجوة صارت من الشبكة، فالهوامش القديمة تتضاعف معها. */
  .veloura-faq .veloura-faq__item { margin-bottom: 0 !important; }
}

/* الجواب بدرجة مختلفة قليلاً عن السؤال: كانت rgba(255,255,255,.08) — بياض
   ثابت لا علاقة له باللون المختار، فهو يختفي تماماً على بطاقة فاتحة. الآن
   الدرجة تُشتق من لون البطاقة نفسه بمزج خفيف من لون نصّها: على بطاقة داكنة
   تخرج أفتح، وعلى بطاقة فاتحة جداً تخرج أعمق قليلاً — إذ لا يوجد أفتح من
   الأبيض — فتبقى مرئية مع أي لون يختاره التاجر. */
.veloura-faq .veloura-faq__answer {
  background: color-mix(in srgb, var(--faq-text, #323232) 7%, var(--faq-bg, #eeeeee)) !important;
  box-shadow: inset 0 1px 0 color-mix(in srgb, var(--faq-text, #323232) 10%, transparent) !important;
}

/* الدارك: ألوان القسم مكتوبة inline من إعدادات التاجر وهي مختارة للّايت،
   فتبقى البطاقة فاتحة على صفحة داكنة. important يغلب inline، فتتحوّل هنا
   إلى لون الخلفية الثانوي للدارك ونصوصه — والجواب يتبعها تلقائياً لأنه
   مشتقّ من المتغيّرين نفسيهما. */
html.dark .veloura-faq {
  --faq-bg: var(--veloura-dark-secondary-bg, #010612) !important;
  --faq-text: var(--veloura-dark-primary-text, #ffffff) !important;
  --faq-title-color: var(--veloura-dark-primary-text, #ffffff) !important;
{% if not component.veloura_faq_hide_border %}
  --faq-border: color-mix(in srgb, var(--veloura-dark-primary-text, #ffffff) 14%, transparent) !important;
{% endif %}
}

/* العنوان: قريب من الأسئلة (على اللابتوب تُضاف له فجوة الشبكة 16px). */
.veloura-faq .veloura-faq__heading { margin-bottom: 20px !important; }
.veloura-faq .veloura-faq__heading h2 { margin-bottom: 6px !important; }
.veloura-faq .veloura-faq__heading p { margin-top: 0 !important; }
html.dark .veloura-faq .veloura-faq__heading p { color: var(--veloura-dark-secondary-text, #ededed) !important; }
/* ---------- السؤال وزر الفتح ---------- */
.veloura-faq .veloura-faq__question {
  gap: 16px;
  padding: 18px 24px !important;
}

.veloura-faq .veloura-faq__question-text {
  flex: 1 1 auto;
  min-width: 0;
  text-align: right;
}

/* علامة + القديمة من ملف الستايل تُلغى، والزر الجديد يحل محلها. */
.veloura-faq .veloura-faq__question::after,
.veloura-faq .veloura-faq__question::before {
  content: none !important;
  display: none !important;
}

/* الزر بلون المتجر، وحوافه نصف حواف السؤال: حاد مع الحاد، ودائري مع الدائري. */
.veloura-faq .veloura-faq__toggle {
  --faq-toggle-size: 34px;
  position: relative;
  flex: 0 0 var(--faq-toggle-size);
  width: var(--faq-toggle-size);
  height: var(--faq-toggle-size);
  border-radius: min(calc(var(--faq-radius, 22px) * .5), 50%);
  background: var(--color-primary, #004956);
  color: var(--color-primary-reverse, #ffffff);
  box-shadow: 0 4px 12px color-mix(in srgb, var(--color-primary, #004956) 30%, transparent);
  transition: transform .45s cubic-bezier(.34, 1.56, .64, 1), background-color .3s ease, box-shadow .3s ease;
}

/* خطّان يرسمان +، وعند الفتح يدور العمودي وينطبق على الأفقي فيصير −. */
.veloura-faq .veloura-faq__toggle::before,
.veloura-faq .veloura-faq__toggle::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 14px;
  height: 2px;
  border-radius: 2px;
  background: currentColor;
  transform: translate(-50%, -50%);
  transition: transform .45s cubic-bezier(.34, 1.56, .64, 1), opacity .3s ease;
}

.veloura-faq .veloura-faq__toggle::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

.veloura-faq .veloura-faq__question:hover .veloura-faq__toggle {
  transform: scale(1.08);
}

.veloura-faq .veloura-faq__item.is-open .veloura-faq__toggle {
  transform: rotate(180deg);
  background: color-mix(in srgb, var(--color-primary, #004956) 82%, #000);
  box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-primary, #004956) 22%, transparent);
}

.veloura-faq .veloura-faq__item.is-open .veloura-faq__toggle::after {
  transform: translate(-50%, -50%) rotate(0deg);
  opacity: 0;
}

.veloura-faq .veloura-faq__question:focus-visible .veloura-faq__toggle {
  outline: 2px solid var(--color-primary, #004956);
  outline-offset: 3px;
}

/* ---------- الجواب: مسافة متناسقة من كل الجهات ---------- */
.veloura-faq .veloura-faq__answer-inner {
  padding: 18px 24px 20px !important;
}

@media (max-width: 767px) {
  .veloura-faq .veloura-faq__question { padding: 16px 18px !important; gap: 12px; }
  .veloura-faq .veloura-faq__toggle { --faq-toggle-size: 30px; }
  .veloura-faq .veloura-faq__answer-inner { padding: 16px 18px 18px !important; }
}

@media (prefers-reduced-motion: reduce) {
  .veloura-faq .veloura-faq__toggle,
  .veloura-faq .veloura-faq__toggle::before,
  .veloura-faq .veloura-faq__toggle::after { transition: none; }
}
</style>

<section data-veloura-home-tab="{{ veloura_home_tab_key|e }}"
  class="{{ faq_classes|join(' ') }}"
  
  style="
    --faq-title-color: {{ component.veloura_faq_title_color|default('#383838') }};
    --faq-bg: {{ component.veloura_faq_background_color|default('#eeeeee') }};
    --faq-text: {{ component.veloura_faq_text_color|default('#323232') }};
    --faq-border: {{ component.veloura_faq_hide_border ? 'transparent' : component.veloura_faq_border_color|default('#323232') }};
    --faq-radius: {{ radius_map[component.veloura_faq_radius|default('large')]|default((component.veloura_faq_radius|default('large') ~ '' == '' ? '22' : component.veloura_faq_radius|default('large')) ~ 'px') }};
    --faq-spacing: {{ component.veloura_faq_enable_custom_spacing ? component.veloura_faq_custom_spacing|default(0) : 0 }}px;
  "
>

{% if component.veloura_faq_enable_custom_spacing %}
  <div class="veloura-faq__container">
{% else %}
  <div class="container veloura-faq__container">
{% endif %}
  <div class="veloura-faq__inner">

    {% if component.veloura_faq_title or component.veloura_faq_subtitle %}
      <div class="veloura-faq__heading veloura-component-title" data-veloura-section-heading>
        {% if component.veloura_faq_title %}
          <h2>{{ component.veloura_faq_title }}</h2>
        {% endif %}

        {% if component.veloura_faq_subtitle %}
          <p>{{ component.veloura_faq_subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% for item in component.veloura_faq_items %}
      <div class="veloura-faq__item">
        <button type="button" class="veloura-faq__question">
          <span class="veloura-faq__question-text">{{ item.veloura_faq_question }}</span>
          <span class="veloura-faq__toggle" aria-hidden="true"></span>
        </button>

        <div class="veloura-faq__answer">
          <div class="veloura-faq__answer-inner">
            {{ item.veloura_faq_answer }}

            {% if item.veloura_faq_button_text %}
              <a href="{{ item.veloura_faq_url ?: '#' }}" class="veloura-faq__button">
                {{ item.veloura_faq_button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}

  </div>
  </div>
</section>

{% endif %}
<script>
/* VELOURA_FAQ_INLINE_FIX */
(function () {
  if (window.__velouraFaqInlineFix) return;
  window.__velouraFaqInlineFix = true;

  function prepareFaq() {
    document.querySelectorAll('.veloura-faq__item').forEach(function (item) {
      var button = item.querySelector('.veloura-faq__question');
      var answer = item.querySelector('.veloura-faq__answer');

      if (!button || !answer) return;

      var opened = item.classList.contains('is-open');

      button.setAttribute(
        'aria-expanded',
        opened ? 'true' : 'false'
      );

      if (!opened) {
        answer.style.height = '0px';
      }
    });
  }

  document.addEventListener('click', function (event) {
    var button = event.target.closest('.veloura-faq__question');

    if (!button) return;

    event.preventDefault();
    event.stopImmediatePropagation();

    var item = button.closest('.veloura-faq__item');

    if (!item) return;

    var answer = item.querySelector('.veloura-faq__answer');

    if (!answer) return;

    var opened = item.classList.contains('is-open');

    if (opened) {
      answer.style.height = answer.scrollHeight + 'px';

      requestAnimationFrame(function () {
        item.classList.remove('is-open');
        button.setAttribute('aria-expanded', 'false');
        answer.style.height = '0px';
      });

      return;
    }

    item.classList.add('is-open');
    button.setAttribute('aria-expanded', 'true');
    answer.style.height = answer.scrollHeight + 'px';

    answer.addEventListener('transitionend', function done() {
      if (item.classList.contains('is-open')) {
        answer.style.height = 'auto';
      }

      answer.removeEventListener('transitionend', done);
    });
  }, true);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', prepareFaq);
  } else {
    prepareFaq();
  }
})();
</script>