{% if veloura_home_tab_key.value is defined %}{% set veloura_home_tab_key = veloura_home_tab_key.value %}{% endif %}
{% if not veloura_home_tab_key %}{% set veloura_home_tab_key = 'always' %}{% endif %}
{# VELOURA HOME TAB ASSIGNMENT END #}

{% if not component.veloura_fp_hide %}

{# ==========================================================================
   المنتج المميز (فيلورا)

   Built to the sketch. Desktop: the row is split into exactly three parts —
   the details (phrase, name, description ending in its own "عرض المزيد", the
   price at one edge with the discount at the other, the buy button), then the
   photo with a horizontal strip of thumbnails and an arrow at each end beneath
   it, then the features stacked down the last third. Phone: the photo at the
   start edge with the same strip standing beside it at the photo's full
   height, the details underneath, the features last as one line each.

   The stylesheet is inline and the classes carry their own names: on this
   store the published Twig and the built app.css have repeatedly been a
   version apart, and new markup under old rules is how a layout breaks with
   nobody touching it.
   ========================================================================== #}
<style>
/* ==========================================================================
   المنتج المميز (فيلورا) — scoped entirely to .veloura-fp2
   ========================================================================== */
.veloura-fp2 {
  --fp2-radius: 22px;
  --fp2-accent: #004956;
  --fp2-title: var(--fp2-title-light, #0f172a);
  --fp2-text: var(--fp2-text-light, #52606d);
  --fp2-surface: var(--fp2-card-light, #ffffff);
  --fp2-border: rgba(15, 23, 42, .10);
  --fp2-glass: rgba(255, 255, 255, .55);
  --fp2-glass-edge: rgba(255, 255, 255, .65);
  --fp2-thumb: 68px;
  padding-inline: var(--fp2-spacing, 0);
}

/* [hidden] has to keep working: the browser hides it from its own stylesheet
   with display:none, and any author display rule outranks that. */
.veloura-fp2 [hidden], .fp2-sticky[hidden] { display: none !important; }

.veloura-fp2 .fp2__heading { margin-bottom: 18px; }
.veloura-fp2.is-centered .fp2__heading { text-align: center; }
.veloura-fp2.is-centered .fp2__heading > * { margin-inline: auto; justify-content: center; }

.veloura-fp2 .fp2__card {
  display: flex !important;
  flex-direction: column !important;
  gap: 16px;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--fp2-text);
}

/* ============================== the stage ================================
   Phone: the photo at the start edge (the right, in Arabic) with the strip of
   thumbnails beside it, then the details, then the features.
   Desktop: three columns of exactly one third each — details, photo, features
   — and the strip of thumbnails sitting across the photo's bottom edge. */
.veloura-fp2 .fp2__stage {
  display: grid !important;
  grid-template-columns: minmax(0, 78%) minmax(0, 22%);
  grid-template-areas:
    "media gallery"
    "info  info"
    "side  side";
  align-items: stretch;
  gap: 14px 10px;
}

.veloura-fp2 .fp2__gallery { grid-area: gallery; min-width: 0; }
.veloura-fp2 .fp2__media { grid-area: media; position: relative; min-width: 0; }
.veloura-fp2 .fp2__info { grid-area: info; min-width: 0; }
.veloura-fp2 .fp2__side { grid-area: side; min-width: 0; }

@media (min-width: 768px) {
  .veloura-fp2 .fp2__stage {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-areas:
      "info media   side"
      "info gallery side";
    grid-template-rows: auto auto;
    gap: 0 28px;
  }

  /* The photo keeps its natural height and the two side columns keep theirs —
     what is asked of them is to match each other, which the grid does by
     centring their content in a shared row rather than stretching the boxes. */
  .veloura-fp2 .fp2__media { align-self: start; }
}

/* --------------------------------------------------------------- photo -- */
.veloura-fp2 .fp2__frame {
  display: block;
  position: relative;
  height: 100%;
  overflow: hidden;
  border-radius: calc(var(--fp2-radius) - 4px);
  background: rgba(15, 23, 42, .04);
}

.veloura-fp2 .fp2__img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
.veloura-fp2.fp2--full .fp2__img { object-fit: contain; }
.veloura-fp2.fp2--square .fp2__frame { aspect-ratio: 1 / 1; height: auto; }

@media (hover: hover) and (pointer: fine) {
  .veloura-fp2 .fp2__frame:hover .fp2__img { transform: scale(1.04); }
}

/* The phrase is a pane of glass on the picture: small, blurred, out of the way
   of the product itself. */
.veloura-fp2 .fp2__chip {
  position: absolute;
  inset-block-start: 12px;
  inset-inline-start: 12px;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  max-width: calc(100% - 24px);
  padding: 5px 11px;
  border: 1px solid var(--fp2-glass-edge);
  border-radius: 999px;
  background: var(--fp2-glass);
  -webkit-backdrop-filter: blur(14px) saturate(160%);
  backdrop-filter: blur(14px) saturate(160%);
  box-shadow: 0 6px 18px rgba(15, 23, 42, .12);
  color: var(--fp2-title);
  font-size: 11.5px;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.veloura-fp2 .fp2__crown { width: 13px; height: 13px; flex: 0 0 auto; color: var(--fp2-accent); }

/* ------------------------------------------------------------- gallery --
   One element, two directions. On a phone it is a column beside the photo,
   stretched by the grid to the photo's full height, so however many images the
   product has the strip scrolls instead of growing past it. On a desktop the
   same strip lies flat across the photo's bottom edge, inside its own pane of
   glass. */
.veloura-fp2 .fp2__gallery { position: relative; height: 100%; min-height: 0; }

.veloura-fp2 .fp2__strip {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  min-height: 0;
}

.veloura-fp2 .fp2__nav {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 22px;
  padding: 0;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--fp2-title);
  cursor: pointer;
  opacity: .75;
  transition: opacity .2s ease;
}

.veloura-fp2 .fp2__nav:hover { opacity: 1; }
.veloura-fp2 .fp2__nav[disabled] { opacity: .22; cursor: default; }
.veloura-fp2 .fp2__nav svg { width: 16px; height: 16px; }

.veloura-fp2 .fp2__thumbs {
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1 1 auto;
  width: 100%;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: none;
  scroll-behavior: smooth;
  overscroll-behavior: contain;
}

.veloura-fp2 .fp2__thumbs::-webkit-scrollbar { display: none; }

.veloura-fp2 .fp2__thumb {
  flex: 0 0 auto;
  width: 100%;
  height: var(--fp2-thumb);
  padding: 0;
  overflow: hidden;
  border: 1px solid var(--fp2-border);
  border-radius: 12px;
  background: transparent;
  cursor: pointer;
}

.veloura-fp2 .fp2__thumb.is-active { border-color: var(--fp2-accent); border-width: 2px; }
.veloura-fp2 .fp2__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

@media (min-width: 768px) {
  /* Half the strip's height is pulled back over the photo, which puts its
     middle exactly on the picture's bottom edge — and leaves the other half
     as the second row, so nothing overlaps what comes after the section. */
  .veloura-fp2 .fp2__gallery {
    height: auto;
    justify-self: center;
    max-width: 100%;
    margin-top: calc((var(--fp2-thumb) + 18px) / -2);
    z-index: 2;
  }

  .veloura-fp2 .fp2__strip {
    position: static;
    flex-direction: row;
    gap: 6px;
    /* Hugs the thumbnails when they fit and stops at the column's width when
       they don't, so the pane is never a wide empty bar behind three pictures. */
    width: max-content;
    max-width: 100%;
    padding: 8px;
    border: 1px solid var(--fp2-glass-edge);
    border-radius: 999px;
    background: var(--fp2-glass);
    -webkit-backdrop-filter: blur(16px) saturate(170%);
    backdrop-filter: blur(16px) saturate(170%);
    box-shadow: 0 12px 30px rgba(15, 23, 42, .16);
  }

  .veloura-fp2 .fp2__thumbs {
    flex-direction: row;
    width: auto;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    /* Dragged and flicked as well as clicked. */
    cursor: grab;
  }

  .veloura-fp2 .fp2__thumbs.is-dragging { cursor: grabbing; scroll-behavior: auto; }
  .veloura-fp2 .fp2__thumbs.is-dragging .fp2__thumb { pointer-events: none; }
  .veloura-fp2 .fp2__thumb { width: var(--fp2-thumb); height: var(--fp2-thumb); border-radius: 14px; }
  .veloura-fp2 .fp2__thumb img { border-radius: inherit; }

  /* The same chevron turned a quarter: pointing at the start edge for "back"
     and the end edge for "forward", which in Arabic is right then left. */
  .veloura-fp2 .fp2__nav { width: 24px; height: var(--fp2-thumb); }
  .veloura-fp2 .fp2__nav svg { transform: rotate(90deg); }
  html[dir="ltr"] .veloura-fp2 .fp2__nav svg { transform: rotate(-90deg); }
}

/* ---------------------------------------------------------------- info -- */
.veloura-fp2 .fp2__info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12px;
  text-align: center;
  align-items: center;
}

@media (min-width: 768px) {
  .veloura-fp2 .fp2__info { text-align: start; align-items: flex-start; }
}

.veloura-fp2 .fp2__name { margin: 0; font-size: 24px; font-weight: 900; line-height: 1.35; }
.veloura-fp2 .fp2__name a { color: var(--fp2-title); }

@media (min-width: 768px) { .veloura-fp2 .fp2__name { font-size: 28px; } }

/* Two lines by default; the button below unfolds the rest in place. */
.veloura-fp2 .fp2__desc { width: 100%; max-width: 46ch; }

.veloura-fp2 .fp2__excerpt {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin: 0;
  font-size: 14px;
  line-height: 1.9;
  opacity: .85;
}

.veloura-fp2 .fp2__desc.is-open .fp2__excerpt { -webkit-line-clamp: 99; }

.veloura-fp2 .fp2__more {
  display: inline-block;
  margin-top: 4px;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--fp2-accent);
  font-size: 13.5px;
  font-weight: 800;
  cursor: pointer;
}

.veloura-fp2 .fp2__more:hover { text-decoration: underline; }

.veloura-fp2 .fp2__rating { display: flex; align-items: center; gap: 6px; font-size: 13px; }
.veloura-fp2 .fp2__stars { color: #f59e0b; letter-spacing: 2px; }
.veloura-fp2 .fp2__rating-count { opacity: .7; }

/* One row pushed to both edges: the price with its currency at the start, the
   discount at the far end. */
.veloura-fp2 .fp2__pricerow {
  display: flex;
  align-items: center;
  gap: 14px;
  width: 100%;
  justify-content: space-between;
}

.veloura-fp2 .fp2__prices { display: flex; align-items: baseline; gap: 10px; }
.veloura-fp2 .fp2__price { font-size: 28px; font-weight: 900; color: var(--fp2-title); }
.veloura-fp2 .fp2__old-price { font-size: 16px; opacity: .5; }

.veloura-fp2 .fp2__sale {
  padding: 7px 14px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--fp2-accent) 13%, transparent);
  color: var(--fp2-accent);
  font-size: 13.5px;
  font-weight: 900;
  unicode-bidi: isolate;
}

.veloura-fp2 .fp2__add { width: 100%; }

/* ------------------------------------------------------------ features --
   Each one reads top to bottom — the icon, then its name — three across on a
   phone with any further ones falling onto the next row, and one under another
   down the last third of the desktop row. */
.veloura-fp2 .fp2__side {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  width: 100%;
  margin: 0;
  padding: 0;
  list-style: none;
}

.veloura-fp2 .fp2__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 7px;
  padding: 12px 8px;
  border: 1px solid var(--fp2-border);
  border-radius: 16px;
  background: var(--fp2-surface);
  text-align: center;
  font-size: 12px;
  line-height: 1.45;
  color: var(--fp2-text);
}

.veloura-fp2 .fp2__item b { display: block; font-weight: 700; color: var(--fp2-title); }
.veloura-fp2 .fp2__item small { display: none; }
.veloura-fp2 .fp2__item i { color: var(--fp2-accent); font-size: 20px; line-height: 1; flex: 0 0 auto; }

@media (min-width: 768px) {
  .veloura-fp2 .fp2__side {
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    gap: 12px;
    height: 100%;
  }

  .veloura-fp2 .fp2__item { padding: 16px 14px; font-size: 13px; }
  .veloura-fp2 .fp2__item i { font-size: 22px; }
  .veloura-fp2 .fp2__item small { display: block; margin-top: 2px; opacity: .75; font-size: 11.5px; }
}

/* ----------------------------------------------------------- countdown --- */
.veloura-fp2 .fp2__countdown {
  display: inline-block;
  padding: 10px 14px;
  border: 1px solid color-mix(in srgb, var(--fp2-accent) 28%, transparent);
  border-radius: 14px;
  background: color-mix(in srgb, var(--fp2-accent) 7%, transparent);
}

.veloura-fp2 .fp2__countdown-label { display: block; margin-bottom: 6px; font-size: 12px; font-weight: 700; opacity: .85; }
.veloura-fp2 .fp2__units { display: flex; gap: 8px; }

.veloura-fp2 .fp2__unit {
  display: flex; flex-direction: column; align-items: center;
  min-width: 52px; padding: 7px 6px; border-radius: 10px;
  border: 1px solid var(--fp2-border); background: var(--fp2-surface);
}

.veloura-fp2 .fp2__unit b { font-size: 18px; font-weight: 900; line-height: 1; color: var(--fp2-accent); font-variant-numeric: tabular-nums; }
.veloura-fp2 .fp2__unit small { margin-top: 4px; font-size: 10px; opacity: .7; }

/* ---------------------------------------------------------- sticky bar --- */
.fp2-sticky {
  position: fixed; inset-inline: 0; bottom: 0; z-index: 2147483000;
  display: flex; align-items: center; gap: 12px;
  padding: 10px 14px calc(10px + env(safe-area-inset-bottom, 0px));
  background: var(--fp2-surface, #fff);
  border-top: 1px solid rgba(15, 23, 42, .1);
  box-shadow: 0 -8px 24px rgba(15, 23, 42, .12);
  transform: translateY(100%); transition: transform .25s ease;
}

.fp2-sticky.is-visible { transform: translateY(0); }
.fp2-sticky__info { display: flex; flex-direction: column; min-width: 0; flex: 1 1 auto; }
.fp2-sticky__name { font-size: 13px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fp2-sticky__price { font-size: 15px; font-weight: 900; color: var(--fp2-accent, #004956); }
@media (min-width: 768px) { .fp2-sticky { display: none; } }

/* ---------------------------------------------------------------- dark --- */
html.dark .veloura-fp2, html body.dark .veloura-fp2 {
  --fp2-surface: var(--fp2-card-dark, #0f172a);
  --fp2-title: #f8fafc;
  --fp2-text: #cbd5e1;
  --fp2-border: rgba(255, 255, 255, .12);
  --fp2-glass: rgba(15, 23, 42, .5);
  --fp2-glass-edge: rgba(255, 255, 255, .16);
  --fp2-accent-text: color-mix(in srgb, var(--fp2-accent) 45%, #ffffff);
}

/* The accent is picked against a white card, so as TEXT on a dark one it turns
   unreadable. Backgrounds keep the real accent; only text is mixed. */
html.dark .veloura-fp2 :is(.fp2__more, .fp2__sale, .fp2__unit b, .fp2__item i, .fp2__crown),
html body.dark .veloura-fp2 :is(.fp2__more, .fp2__sale, .fp2__unit b, .fp2__item i, .fp2__crown) {
  color: var(--fp2-accent-text);
}

@media (prefers-reduced-motion: reduce) {
  .veloura-fp2 .fp2__img, .fp2-sticky, .veloura-fp2 .fp2__nav { transition: none; }
  .veloura-fp2 .fp2__thumbs { scroll-behavior: auto; }
}
</style>

  {% set fp_image_fit = component.veloura_fp_image_fit|default('') %}
  {% if fp_image_fit.selected is defined %}{% set fp_image_fit = fp_image_fit.selected %}{% endif %}
  {% if fp_image_fit is iterable and fp_image_fit.value is not defined %}{% set fp_image_fit = fp_image_fit|first %}{% endif %}
  {% if fp_image_fit.value is defined %}{% set fp_image_fit = fp_image_fit.value %}{% endif %}
  {% set fp_image_fit = fp_image_fit|default('square') %}
  {% if fp_image_fit is iterable or fp_image_fit == '' %}{% set fp_image_fit = 'square' %}{% endif %}
  {% set fp_image_fit = fp_image_fit|trim %}

  {% set fp_fallback = component.veloura_fp_fallback|default('') %}
  {% if fp_fallback.selected is defined %}{% set fp_fallback = fp_fallback.selected %}{% endif %}
  {% if fp_fallback is iterable and fp_fallback.value is not defined %}{% set fp_fallback = fp_fallback|first %}{% endif %}
  {% if fp_fallback.value is defined %}{% set fp_fallback = fp_fallback.value %}{% endif %}
  {% set fp_fallback = fp_fallback|default('sales') %}
  {% if fp_fallback is iterable or fp_fallback == '' %}{% set fp_fallback = 'sales' %}{% endif %}
  {% set fp_fallback = fp_fallback|trim %}

  {% set fp_radius_key = component.veloura_fp_radius|default('') %}
  {% if fp_radius_key.selected is defined %}{% set fp_radius_key = fp_radius_key.selected %}{% endif %}
  {% if fp_radius_key is iterable and fp_radius_key.value is not defined %}{% set fp_radius_key = fp_radius_key|first %}{% endif %}
  {% if fp_radius_key.value is defined %}{% set fp_radius_key = fp_radius_key.value %}{% endif %}
  {% set fp_radius_key = fp_radius_key|default('medium') %}
  {% if fp_radius_key is iterable or fp_radius_key == '' %}{% set fp_radius_key = 'medium' %}{% endif %}
  {% set fp_radius_map = {'sharp':'0px','soft':'12px','medium':'22px','large':'34px'} %}

  {# |first, never a {% for %}: Twig scopes a loop body, so a {% set %} inside
     one is gone at {% endfor %} — the chosen product's id came out empty and
     the section silently fell back to the automatic source. #}
  {% set fp_chosen = component.veloura_fp_product|first %}
  {% set fp_product_id = fp_chosen.id|default(fp_chosen.value|default('')) %}

  <section
    data-veloura-home-tab="{{ veloura_home_tab_key|e }}"
    data-veloura-featured-product
    data-vfp-product-id="{{ fp_product_id }}"
    data-vfp-fallback="{{ fp_fallback }}"
    data-vfp-sticky-enabled="{{ component.veloura_fp_sticky_enabled ? '1' : '0' }}"
    data-vfp-countdown-date="{{ component.veloura_fp_countdown_date }}"
    data-vfp-countdown-fallback="{{ component.veloura_fp_countdown_use_product_date ? '1' : '0' }}"
    data-vfp-countdown-hide="{{ component.veloura_fp_countdown_hide_after ? '1' : '0' }}"
    id="veloura-featured-product-{{ position }}"
    class="s-block veloura-fp2
      fp2--{{ fp_image_fit }}
      {{ component.veloura_fp_center_titles ? 'is-centered' : '' }}
      {{ component.veloura_fp_mobile_only ? 'veloura-mobile-only' : '' }}
      {{ component.veloura_fp_desktop_only ? 'veloura-desktop-only' : '' }}
      {{ component.veloura_fp_custom_classes }}"
    style="
      --fp2-radius: {{ fp_radius_map[fp_radius_key]|default('22px') }};
      --fp2-accent: {{ component.veloura_fp_accent_color|default('#004956') }};
      {# The merchant's colours are written as *-light custom properties, not as
         the ones the component paints with: an inline style outranks any
         stylesheet rule, so writing --fp2-title here would leave the dark-mode
         block unable to override it and the name near-black on a near-black
         card. #}
      --fp2-title-light: {{ component.veloura_fp_title_color|default('#0f172a') }};
      --fp2-text-light: {{ component.veloura_fp_text_color|default('#52606d') }};
      --fp2-card-light: {{ component.veloura_fp_card_bg|default('#ffffff') }};
      --fp2-card-dark: {{ component.veloura_fp_dark_card_bg|default('#0f172a') }};
      --fp2-spacing: {{ component.veloura_fp_custom_spacing ? component.veloura_fp_spacing|default(0) : 0 }}px;
    "
  >
    <div class="container">

      {% if component.veloura_fp_title or component.veloura_fp_subtitle %}
        <div class="fp2__heading veloura-component-title" data-veloura-section-heading>
          <div data-veloura-section-heading-text>
            {% if component.veloura_fp_title %}<h2>{{ component.veloura_fp_title }}</h2>{% endif %}
            {% if component.veloura_fp_subtitle %}<p>{{ component.veloura_fp_subtitle|raw }}</p>{% endif %}
          </div>
        </div>
      {% endif %}

      <div class="fp2__card" data-vfp-card>
        <div class="fp2__stage">

          {% if component.veloura_fp_show_gallery %}
            <div class="fp2__gallery" data-vfp-gallery hidden>
              {# The arrows and the strip live in a box of their own: on a phone
                 it is lifted out of flow so the row's height is set by the
                 photo alone and the strip is stretched to match it, instead of
                 six thumbnails pushing the row taller than the picture. #}
              <div class="fp2__strip">
              <button type="button" class="fp2__nav" data-vfp-thumb-prev aria-label="السابق">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 15 6-6 6 6"/></svg>
              </button>
              <div class="fp2__thumbs" data-vfp-thumbs></div>
              <button type="button" class="fp2__nav" data-vfp-thumb-next aria-label="التالي">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              </div>
            </div>
          {% endif %}

          <div class="fp2__media">
            <a class="fp2__frame" data-vfp-link href="#" aria-label="{{ component.veloura_fp_title|default('المنتج المميز') }}">
              <img class="fp2__img" data-vfp-image src="" alt="" loading="lazy" decoding="async">
              {# The phrase rides the photo as a small pane of glass rather than
                 taking a row of its own above the name. #}
              {% if component.veloura_fp_eyebrow %}
                <span class="fp2__chip">
                  {% if component.veloura_fp_crown %}<svg class="fp2__crown" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 8.5 6.6 12l3.1-5.2a2.7 2.7 0 0 0 4.6 0L17.4 12 21 8.5l-1.6 9.2a2 2 0 0 1-2 1.7H6.6a2 2 0 0 1-2-1.7L3 8.5Z"/></svg>{% endif %}
                  {{ component.veloura_fp_eyebrow }}
                </span>
              {% endif %}
            </a>
          </div>

          <div class="fp2__info">
            <h3 class="fp2__name"><a data-vfp-link data-vfp-name href="#"></a></h3>

            {% if component.veloura_fp_show_excerpt %}
              {# Two lines under the name, and "عرض المزيد" unfolds the rest here
                 instead of sending the visitor to another page — the buy button
                 stays the only thing that takes them away. #}
              <div class="fp2__desc" data-vfp-excerpt-wrap hidden>
                <p class="fp2__excerpt" data-vfp-excerpt></p>
                {% if component.veloura_fp_show_link %}
                  <button type="button" class="fp2__more" data-vfp-more
                    data-more="{{ component.veloura_fp_link_text|default('عرض المزيد') }}"
                    data-less="{{ component.veloura_fp_less_text|default('عرض أقل') }}"
                    hidden>{{ component.veloura_fp_link_text|default('عرض المزيد') }}</button>
                {% endif %}
              </div>
            {% endif %}

            {% if component.veloura_fp_show_rating %}
              <div class="fp2__rating" data-vfp-rating hidden></div>
            {% endif %}

            {% if component.veloura_fp_show_price %}
              <div class="fp2__pricerow">
                <div class="fp2__prices">
                  <span class="fp2__price" data-vfp-price></span>
                  <del class="fp2__old-price" data-vfp-old hidden></del>
                </div>
                <span class="fp2__sale" data-vfp-discount hidden></span>
              </div>
            {% endif %}

            {% if component.veloura_fp_countdown_enabled %}
              <div class="fp2__countdown" data-vfp-countdown hidden>
                <span class="fp2__countdown-label">{{ component.veloura_fp_countdown_label|default('ينتهي العرض خلال') }}</span>
                <div class="fp2__units">
                  <span class="fp2__unit"><b data-vfp-days>0</b><small>يوم</small></span>
                  <span class="fp2__unit"><b data-vfp-hours>0</b><small>ساعة</small></span>
                  <span class="fp2__unit"><b data-vfp-minutes>0</b><small>دقيقة</small></span>
                  <span class="fp2__unit"><b data-vfp-seconds>0</b><small>ثانية</small></span>
                </div>
              </div>
            {% endif %}

            <salla-add-product-button
              class="fp2__add"
              data-vfp-add
              product-id=""
              product-status="sale"
              product-type="product"
              width="wide"
            >{{ component.veloura_fp_button_text|default('أضف للسلة') }}</salla-add-product-button>

          </div>

          {# The features are their own third of the row on a desktop, so they
             are a child of the stage, not of the details column. #}
          {% if component.veloura_fp_features %}
            <ul class="fp2__side">
              {% for feature in component.veloura_fp_features %}
                {% if feature.text %}
                  <li class="fp2__item">
                    <i class="{{ feature.icon|default('sicon-check') }}" aria-hidden="true"></i>
                    <span><b>{{ feature.text }}</b>{% if feature.note %}<small>{{ feature.note }}</small>{% endif %}</span>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </div>

    {% if component.veloura_fp_sticky_enabled %}
      {# Moved to <body> by the script: a fixed bar inside a section that may sit
         in a transformed ancestor is positioned against that ancestor. #}
      <div class="fp2-sticky" data-vfp-sticky hidden aria-hidden="true">
        <div class="fp2-sticky__info">
          <span class="fp2-sticky__name" data-vfp-name></span>
          <span class="fp2-sticky__price" data-vfp-price></span>
        </div>
        <salla-add-product-button data-vfp-add product-id="" product-status="sale" product-type="product">{{ component.veloura_fp_button_text|default('أضف للسلة') }}</salla-add-product-button>
      </div>
    {% endif %}
  </section>
{% endif %}