{# VELOURA HOME TAB ASSIGNMENT START #}
{% set veloura_home_tab_key = component.veloura_home_tab_name_2026|default('') %}
{% if veloura_home_tab_key.value is defined %}{% set veloura_home_tab_key = veloura_home_tab_key.value %}{% endif %}
{% if not veloura_home_tab_key %}{% set veloura_home_tab_key = 'always' %}{% endif %}
{# VELOURA HOME TAB ASSIGNMENT END #}

{% if not component.veloura_steps_hide %}

{# ==========================================================================
   خطوات الشراء (فيلورا)

   A numbered path rather than a row of cards: one line runs through the
   circles, each step wears its number on the edge of its own circle, and the
   words sit under it. Nothing is boxed and nothing is framed — the only
   surfaces are the circles themselves, and they take the theme's secondary
   colour so the section belongs to the store in both light and dark.

   The line is only drawn where it can be honest: across a row when the steps
   all fit one, and down the page when the phone shows them one under another.
   With more steps than columns there is no line to mislead anyone.

   The stylesheet and the little observer are inline: on this store the
   published Twig and the built app.css have repeatedly been a version apart,
   and new markup under old rules is how a layout breaks with nobody touching
   it.
   ========================================================================== #}
<style>
/* ==========================================================================
   خطوات الشراء (فيلورا) — scoped entirely to .veloura-stp
   ========================================================================== */
.veloura-stp {
  --stp-accent: #004956;
  --stp-title: var(--stp-title-light, #0f172a);
  --stp-text: var(--stp-text-light, #52606d);
  --stp-second: var(--veloura-site-second-bg, var(--color-secondary, #f4f5f7));
  --stp-page: var(--veloura-site-bg, #ffffff);
  --stp-line: color-mix(in srgb, var(--stp-accent) 26%, transparent);
  --stp-tile: 104px;
  --stp-badge: 34px;
  --stp-col-gap: 18px;

  background: transparent !important;
  padding-inline: 0 !important;
}

.veloura-stp [hidden] { display: none !important; }

/* The gutter, read from the theme's own variables so an untouched section is
   the same box as every other block; the custom number is a phone and tablet
   affair, which is where the setting says it belongs. */
body .veloura-stp.veloura-stp > .container {
  width: 100%;
  margin-inline: auto !important;
  box-sizing: border-box;
  max-width: var(--veloura-global-container, 1280px) !important;
  padding-inline: var(--veloura-global-spacing, 10px) !important;
}

@media (max-width: 1023px) {
  body .veloura-stp.veloura-stp > .container {
    max-width: none !important;
    padding-inline: var(--stp-gutter, var(--veloura-site-spacing, var(--veloura-global-spacing, 10px))) !important;
  }
}

@media (min-width: 1024px) {
  body .veloura-stp.veloura-stp > .container {
    max-width: var(--veloura-site-container-width, var(--veloura-global-container, 1280px)) !important;
    padding-inline: var(--veloura-global-spacing, 10px) !important;
  }
}

/* ---------------------------------------------------------- the heading -- */
.veloura-stp .stp__heading { margin-bottom: 36px; text-align: center; }
.veloura-stp .stp__kicker {
  display: block;
  margin-bottom: 10px;
  color: color-mix(in srgb, var(--stp-accent) 65%, var(--stp-text));
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .38em;
  text-transform: uppercase;
}
.veloura-stp .stp__heading h2 { margin: 0 0 8px; font-size: 26px; font-weight: 900; color: var(--stp-title); }
.veloura-stp .stp__heading p { margin: 0; font-size: 14px; opacity: .75; color: var(--stp-text); }

@media (min-width: 768px) { .veloura-stp .stp__heading h2 { font-size: 34px; } }

/* -------------------------------------------------------------- the row -- */
.veloura-stp .stp__row {
  display: grid !important;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--stp-step-gap, 26px) var(--stp-col-gap);
  margin: 0;
  padding: 0;
  list-style: none;
}

@media (min-width: 768px) {
  .veloura-stp .stp__row { grid-template-columns: repeat(var(--stp-cols, 4), minmax(0, 1fr)); }
}

.veloura-stp .stp__step {
  position: relative;
  display: flex;
  align-items: center;
  gap: 14px;
  color: var(--stp-text);
}

/* ------------------------------------------------------------- the tile --
   A rounded square holding the icon, with the number riding its outer top
   corner — the two together are the thing the eye lands on, so everything else
   stays quiet around them. */
.veloura-stp .stp__dot {
  position: relative;
  z-index: 1;
  display: grid;
  place-items: center;
  width: var(--stp-tile);
  height: var(--stp-tile);
  flex: 0 0 auto;
  border-radius: var(--stp-radius, 26px);
  background: var(--stp-second);
  color: var(--step-color, var(--stp-accent));
  transition: transform .35s ease, box-shadow .35s ease, background-color .35s ease;
}

.veloura-stp .stp__dot i { font-size: calc(var(--stp-tile) * .4); line-height: 1; }
.veloura-stp .stp__dot img { width: 54%; height: 54%; object-fit: contain; }

@media (hover: hover) and (pointer: fine) {
  .veloura-stp .stp__step:hover .stp__dot {
    transform: translateY(-6px);
    box-shadow: 0 16px 30px color-mix(in srgb, var(--step-color, var(--stp-accent)) 18%, transparent);
  }
}

.veloura-stp .stp__num {
  position: absolute;
  top: calc(var(--stp-badge) / -2.6);
  inset-inline-start: calc(var(--stp-badge) / -2.6);
  display: grid;
  place-items: center;
  width: var(--stp-badge);
  height: var(--stp-badge);
  border-radius: 999px;
  border: 3px solid var(--stp-page);
  background: var(--step-color, var(--stp-accent));
  color: #fff;
  font-size: 13px;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

/* ------------------------------------------------------------- the words -- */
.veloura-stp .stp__text { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.veloura-stp .stp__text h3 { margin: 0; font-size: 16px; font-weight: 800; color: var(--stp-title); }
.veloura-stp .stp__text p { margin: 0; font-size: 13px; line-height: 1.75; opacity: .72; }

/* ====================================================== desktop: one row ==
   Tile above, words beneath, and between every two tiles a hairline with a
   chevron sitting in the middle of it — drawn only where the steps really are
   neighbours, which is when they all fit a single row. */
@media (min-width: 768px) {
  .veloura-stp .stp__step {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
  }

  .veloura-stp:not(.is-centered) .stp__step { text-align: start; }
  .veloura-stp .stp__text { align-items: center; }
  .veloura-stp:not(.is-centered) .stp__text { align-items: flex-start; }
  .veloura-stp .stp__text h3 { font-size: 17px; }
  .veloura-stp .stp__text p { max-width: 30ch; }

  .veloura-stp.has-line .stp__step::after {
    content: "";
    position: absolute;
    top: calc(var(--stp-tile) / 2 - 1px);
    inset-inline-end: 50%;
    width: calc(100% + var(--stp-col-gap));
    height: 2px;
    background: var(--stp-line);
    opacity: 0;
    transition: opacity .7s ease calc(var(--i, 0) * .12s);
  }

  /* The chevron: a corner of a square turned a quarter, so it points along the
     reading direction without an image or a font behind it. */
  .veloura-stp.has-line .stp__step::before {
    content: "";
    position: absolute;
    top: calc(var(--stp-tile) / 2 - 5px);
    inset-inline-end: calc(100% + var(--stp-col-gap) / 2 - 5px);
    width: 9px;
    height: 9px;
    /* Physical borders on purpose: the corner they make points up and to the
       right, and the rotation that turns it along the reading direction is a
       different one in each — 225° to point left in Arabic, 45° to point right
       in English. Logical borders would flip the corner as well and the two
       would cancel out. */
    border-top: 2px solid var(--stp-line);
    border-right: 2px solid var(--stp-line);
    transform: rotate(225deg);
    opacity: 0;
    transition: opacity .7s ease calc(var(--i, 0) * .12s);
  }

  html[dir="ltr"] .veloura-stp.has-line .stp__step::before { transform: rotate(45deg); }

  .veloura-stp.has-line .stp__step:first-child::after,
  .veloura-stp.has-line .stp__step:first-child::before { content: none; }
  .veloura-stp.has-line.is-inview .stp__step::after,
  .veloura-stp.has-line.is-inview .stp__step::before { opacity: 1; }

  .veloura-stp:not(.has-line) .stp__step::after,
  .veloura-stp:not(.has-line) .stp__step::before { content: none; }
}

/* ======================================================= phone: a staircase ==
   The tile keeps one edge and the words sit beside it, and the sides swap on
   every step. Between them a diagonal runs from one tile's middle to the next
   one's, with a small ring where it crosses the halfway mark — the same idea as
   the desktop chevron, turned on its side. */
@media (max-width: 767px) {
  .veloura-stp { --stp-tile: 76px; --stp-badge: 28px; --stp-step-gap: 30px; }

  .veloura-stp .stp__step:nth-child(even) { flex-direction: row-reverse; text-align: end; }
  .veloura-stp .stp__step:nth-child(even) .stp__text { align-items: flex-end; }
  .veloura-stp .stp__step:nth-child(even) .stp__num { inset-inline-start: auto; inset-inline-end: calc(var(--stp-badge) / -2.6); }

  .veloura-stp.has-path .stp__step::before {
    content: "";
    position: absolute;
    bottom: calc(100% - 6px);
    inset-inline: calc(var(--stp-tile) / 2) calc(var(--stp-tile) / 2);
    height: calc(var(--stp-step-gap, 30px) + 12px);
    opacity: 0;
    transition: opacity .6s ease calc(var(--i, 0) * .12s);
  }

  /* Odd steps carry their tile at the start edge, so the step above them has
     its own at the other end: the diagonal falls one way, then the other. */
  .veloura-stp.has-path .stp__step:nth-child(odd)::before {
    background: linear-gradient(to bottom right,
      transparent calc(50% - 1.1px), var(--stp-line) calc(50% - 1.1px),
      var(--stp-line) calc(50% + 1.1px), transparent calc(50% + 1.1px));
  }

  .veloura-stp.has-path .stp__step:nth-child(even)::before {
    background: linear-gradient(to bottom left,
      transparent calc(50% - 1.1px), var(--stp-line) calc(50% - 1.1px),
      var(--stp-line) calc(50% + 1.1px), transparent calc(50% + 1.1px));
  }

  html[dir="ltr"] .veloura-stp.has-path .stp__step:nth-child(odd)::before {
    background: linear-gradient(to bottom left,
      transparent calc(50% - 1.1px), var(--stp-line) calc(50% - 1.1px),
      var(--stp-line) calc(50% + 1.1px), transparent calc(50% + 1.1px));
  }

  html[dir="ltr"] .veloura-stp.has-path .stp__step:nth-child(even)::before {
    background: linear-gradient(to bottom right,
      transparent calc(50% - 1.1px), var(--stp-line) calc(50% - 1.1px),
      var(--stp-line) calc(50% + 1.1px), transparent calc(50% + 1.1px));
  }

  /* The ring sits on the crossing point and wears the page's own colour, so
     the line stops at it instead of running through. */
  .veloura-stp.has-path .stp__step::after {
    content: "";
    position: absolute;
    bottom: calc(100% + var(--stp-step-gap, 30px) / 2 - 5px);
    left: 50%;
    width: 11px;
    height: 11px;
    margin-inline-start: -5.5px;
    border: 2px solid var(--stp-line);
    border-radius: 999px;
    background: var(--stp-page);
    opacity: 0;
    transition: opacity .6s ease calc(var(--i, 0) * .12s);
  }

  .veloura-stp.has-path .stp__step:first-child::before,
  .veloura-stp.has-path .stp__step:first-child::after { content: none; }
  .veloura-stp.has-path.is-inview .stp__step::before,
  .veloura-stp.has-path.is-inview .stp__step::after { opacity: 1; }

  .veloura-stp .stp__step:nth-child(odd) { transform: translate(-14px, 8px); }
  .veloura-stp .stp__step:nth-child(even) { transform: translate(14px, 8px); }
  .veloura-stp.is-inview .stp__step { transform: none; }
}

/* ---------------------------------------------------------- the reveal --- */
.veloura-stp .stp__step {
  opacity: 0;
  transition: opacity .6s ease calc(var(--i, 0) * .12s), transform .6s ease calc(var(--i, 0) * .12s);
}

.veloura-stp.is-inview .stp__step { opacity: 1; }

/* No script, no observer, no reveal — the section must still be readable. */
.veloura-stp.no-js .stp__step { opacity: 1; transform: none; }

@media (prefers-reduced-motion: reduce) {
  .veloura-stp .stp__step, .veloura-stp .stp__dot { transition: none; }
  .veloura-stp .stp__step { opacity: 1; transform: none; }
  .veloura-stp .stp__step::before,
  .veloura-stp .stp__step::after { opacity: 1 !important; transition: none; }
}

/* ------------------------------------------------------------ the dark -- */
html.dark .veloura-stp, html body.dark .veloura-stp {
  --stp-title: #f8fafc;
  --stp-text: #cbd5e1;
  --stp-second: var(--veloura-dark-secondary-bg, #010612);
  --stp-page: var(--veloura-dark-bg, #05070f);
  --stp-line: color-mix(in srgb, #ffffff 20%, transparent);
}

html.dark .veloura-stp .stp__dot,
html body.dark .veloura-stp .stp__dot {
  color: color-mix(in srgb, var(--step-color, var(--stp-accent)) 45%, #ffffff);
}
</style>

  {% set stp_radius_key = component.veloura_steps_radius|default('') %}
  {% if stp_radius_key.selected is defined %}{% set stp_radius_key = stp_radius_key.selected %}{% endif %}
  {% if stp_radius_key is iterable and stp_radius_key.value is not defined %}{% set stp_radius_key = stp_radius_key|first %}{% endif %}
  {% if stp_radius_key.value is defined %}{% set stp_radius_key = stp_radius_key.value %}{% endif %}
  {% if stp_radius_key is iterable or stp_radius_key == '' %}{% set stp_radius_key = 'medium' %}{% endif %}
  {% set stp_radius_map = {'sharp':'0px','soft':'10px','medium':'20px','large':'30px','round':'999px'} %}

  {% set stp_items = component.veloura_steps_collection|default([]) %}
  {% set stp_cols = component.veloura_steps_desktop_columns|default(4) %}

  {# The line is only honest while the steps really are neighbours: across one
     row on a desktop, and down a single column on a phone. #}
  {% set stp_line = component.veloura_steps_show_connectors and stp_items|length <= stp_cols %}

  <section
    data-veloura-home-tab="{{ veloura_home_tab_key|e }}"
    data-veloura-steps
    id="veloura-purchase-steps-{{ position }}"
    class="s-block veloura-stp no-js
      {{ component.veloura_steps_center_text ? 'is-centered' : '' }}
      {{ stp_line ? 'has-line' : '' }}
      {{ component.veloura_steps_show_connectors ? 'has-path' : '' }}
      {{ component.veloura_steps_mobile_only ? 'veloura-mobile-only' : '' }}
      {{ component.veloura_steps_desktop_only ? 'veloura-desktop-only' : '' }}
      {{ component.veloura_steps_custom_classes }}"
    style="
      --stp-radius: {{ stp_radius_map[stp_radius_key]|default('20px') }};
      --stp-accent: {{ component.veloura_steps_accent_color|default('#004956') }};
      {# The merchant's colours are written as *-light properties, never as the
         ones the component paints with: an inline style outranks any rule, and
         would leave the dark block unable to lighten the text. #}
      --stp-title-light: {{ component.veloura_steps_title_color|default('#0f172a') }};
      --stp-text-light: {{ component.veloura_steps_text_color|default('#52606d') }};
      --stp-cols: {{ stp_cols }};
      {% if component.veloura_steps_custom_spacing %}--stp-gutter: {{ component.veloura_steps_spacing|default(0) }}px;{% endif %}
    "
  >
    <div class="container">

      {% if component.veloura_steps_title or component.veloura_steps_subtitle %}
        <div class="stp__heading veloura-component-title" data-veloura-section-heading>
          <div data-veloura-section-heading-text>
            {% if component.veloura_steps_kicker %}<span class="stp__kicker">{{ component.veloura_steps_kicker }}</span>{% endif %}
            {% if component.veloura_steps_title %}<h2>{{ component.veloura_steps_title }}</h2>{% endif %}
            {% if component.veloura_steps_subtitle %}<p>{{ component.veloura_steps_subtitle }}</p>{% endif %}
          </div>
        </div>
      {% endif %}

      {% if stp_items %}
        <ol class="stp__row">
          {% for step in stp_items %}
            {% set step_image = step.step_image.url|default(step.step_image) %}
            <li class="stp__step" style="--i: {{ loop.index0 }}; {% if step.step_color %}--step-color: {{ step.step_color }};{% endif %}">
              <span class="stp__dot">
                {% if step_image %}
                  <img src="{{ step_image }}" alt="{{ step.step_title|default('') }}" loading="lazy" decoding="async">
                {% elseif step.step_icon %}
                  <i class="{{ step.step_icon }}" aria-hidden="true"></i>
                {% endif %}
                <span class="stp__num">{{ loop.index }}</span>
              </span>

              <span class="stp__text">
                {% if step.step_title %}<h3>{{ step.step_title }}</h3>{% endif %}
                {% if step.step_description %}<p>{{ step.step_description }}</p>{% endif %}
              </span>
            </li>
          {% endfor %}
        </ol>
      {% endif %}

    </div>
  </section>

  {# Inline on purpose: the bundled script goes through a build and a CDN, and
     this section has to reveal itself the moment the Twig is published. The
     class is dropped first so that, with no JavaScript at all, the steps are
     simply visible. #}
  <script>
  (function () {
    var section = document.getElementById('veloura-purchase-steps-{{ position }}');
    if (!section) return;
    section.classList.remove('no-js');

    if (!('IntersectionObserver' in window)) { section.classList.add('is-inview'); return; }

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-inview');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.2, rootMargin: '0px 0px -10% 0px' });

    observer.observe(section);
  })();
  </script>
{% endif %}