{# VELOURA HOME TAB ASSIGNMENT START #}
{% set veloura_home_tab_key = component.veloura_home_tab_name_2026|default('') %}
{% if veloura_home_tab_key.value is defined %}{% set veloura_home_tab_key = veloura_home_tab_key.value %}{% endif %}
{% if not veloura_home_tab_key %}{% set veloura_home_tab_key = 'always' %}{% endif %}
{# VELOURA HOME TAB ASSIGNMENT END #}

{% if not component.veloura_steps_hide %}

{# ==========================================================================
   خطوات الشراء (فيلورا)

   A numbered path rather than a row of cards: one line runs through the
   circles, each step wears its number on the edge of its own circle, and the
   words sit under it. Nothing is boxed and nothing is framed — the only
   surfaces are the circles themselves, and they take the theme's secondary
   colour so the section belongs to the store in both light and dark.

   The line is only drawn where it can be honest: across a row when the steps
   all fit one, and down the page when the phone shows them one under another.
   With more steps than columns there is no line to mislead anyone.

   The stylesheet and the little observer are inline: on this store the
   published Twig and the built app.css have repeatedly been a version apart,
   and new markup under old rules is how a layout breaks with nobody touching
   it.
   ========================================================================== #}
{% set stp_radius_key = component.veloura_steps_radius|default('') %}
  {% if stp_radius_key.selected is defined %}{% set stp_radius_key = stp_radius_key.selected %}{% endif %}
  {% if stp_radius_key is iterable and stp_radius_key.value is not defined %}{% set stp_radius_key = stp_radius_key|first %}{% endif %}
  {% if stp_radius_key.value is defined %}{% set stp_radius_key = stp_radius_key.value %}{% endif %}
  {% if stp_radius_key is iterable or stp_radius_key == '' %}{% set stp_radius_key = 'medium' %}{% endif %}
  {% set stp_radius_map = {'sharp':'0px','soft':'10px','medium':'20px','large':'30px','round':'999px','40':'999px'} %}

  {% set stp_items = component.veloura_steps_collection|default([]) %}
  {% set stp_cols = component.veloura_steps_desktop_columns|default(4) %}

  {# حركة الشريط الواصل: ومضة تمشي من الخطوة الأولى إلى الأخيرة وتتكرر.
     كل مقطع له خانة زمنية من الدورة، والدورة = عدد المقاطع + خانة توقف.
     نسب المفاتيح تُحسب هنا لأن @keyframes لا تقرأ متغيرات CSS. #}
  {% set stp_n = stp_items|length %}
  {% set stp_x_slots = max(stp_n, 2) %}
  {% set stp_y_slots = stp_n + 1 %}
  {% set stp_x_pct = (100 / stp_x_slots)|round(3) %}
  {% set stp_y_pct = (100 / stp_y_slots)|round(3) %}
  {% set stp_y_half = (50 / stp_y_slots)|round(3) %}
  {% set stp_anim = 'stp' ~ (position|default(0)) %}

  {# The connector used to be withheld whenever there were more steps than
     columns — which is why a five-step section with four columns showed no
     join at all. It is drawn between neighbours instead, and the first card of
     every row is told to skip it (see the nth-child rule in the desktop block,
     which counts by the merchant's own column setting). #}
  {% set stp_line = component.veloura_steps_show_connectors %}

  {# The laptop has one shape now — icon above the words — so this setting only
     decides how a phone step is put together: the words beside the icon, or
     beneath it. Either way the phone keeps its alternating spine and the
     laptop its track. #}
  {% set stp_dir = component.veloura_steps_direction|default('') %}
  {% if stp_dir.selected is defined %}{% set stp_dir = stp_dir.selected %}{% endif %}
  {% if stp_dir is iterable and stp_dir.value is not defined %}{% set stp_dir = stp_dir|first %}{% endif %}
  {% if stp_dir.value is defined %}{% set stp_dir = stp_dir.value %}{% endif %}
  {% if stp_dir not in ['h', 'v'] %}{% set stp_dir = 'v' %}{% endif %}

<style>
/* ==========================================================================
   خطوات الشراء (فيلورا) — scoped entirely to .veloura-stp
   ========================================================================== */
.veloura-stp {
  --stp-accent: #004956;
  --stp-title: var(--stp-title-light, #0f172a);
  --stp-text: var(--stp-text-light, #52606d);
  --stp-second: var(--veloura-site-second-bg, var(--color-secondary, #f4f5f7));
  --stp-page: var(--veloura-site-bg, #ffffff);
  --stp-line: color-mix(in srgb, var(--stp-accent) 62%, transparent);
  --stp-line-w: 6px;
  --stp-cap: 13px;
  --stp-tile: 104px;
  --stp-col-gap: 18px;

  background: transparent !important;
  padding-inline: 0 !important;
}

.veloura-stp [hidden] { display: none !important; }

/* The gutter, read from the theme's own variables so an untouched section is
   the same box as every other block; the custom number is a phone and tablet
   affair, which is where the setting says it belongs. */
body .veloura-stp.veloura-stp > .container {
  width: 100%;
  margin-inline: auto !important;
  box-sizing: border-box;
  max-width: var(--veloura-global-container, 1280px) !important;
  padding-inline: var(--veloura-global-spacing, 10px) !important;
}

@media (max-width: 1023px) {
  body .veloura-stp.veloura-stp > .container {
    max-width: none !important;
    padding-inline: var(--stp-gutter, var(--veloura-site-spacing, var(--veloura-global-spacing, 10px))) !important;
  }
}

@media (min-width: 1024px) {
  body .veloura-stp.veloura-stp > .container {
    max-width: var(--veloura-site-container-width, var(--veloura-global-container, 1280px)) !important;
    padding-inline: var(--veloura-global-spacing, 10px) !important;
  }
}

/* ---------------------------------------------------------- the heading -- */
.veloura-stp .stp__heading { margin-bottom: 36px; text-align: center; }
.veloura-stp .stp__kicker {
  display: block;
  margin-bottom: 10px;
  color: color-mix(in srgb, var(--stp-accent) 65%, var(--stp-text));
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .38em;
  text-transform: uppercase;
}
.veloura-stp .stp__heading h2 { margin: 0 0 8px; font-size: 26px; font-weight: 900; color: var(--stp-title); }
.veloura-stp .stp__heading p { margin: 0; font-size: 14px; opacity: .75; color: var(--stp-text); }

@media (min-width: 768px) { .veloura-stp .stp__heading h2 { font-size: 34px; } }

/* -------------------------------------------------------------- the row -- */
/* padding forced to nothing: this is an <ol>, and a list keeps a start padding
   of its own in most stylesheets — which would move the steps off the centre
   the spine is measured against. */
.veloura-stp .stp__row {
  display: grid !important;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--stp-step-gap, 26px) var(--stp-col-gap);
  margin: 0;
  padding: 0 !important;
  list-style: none;
  box-sizing: border-box;
}

.veloura-stp .stp__step { box-sizing: border-box; max-width: 100%; }

@media (min-width: 768px) {
  .veloura-stp .stp__row { grid-template-columns: repeat(var(--stp-cols, 4), minmax(0, 1fr)); }
}

.veloura-stp .stp__step {
  position: relative;
  display: flex;
  align-items: center;
  gap: 14px;
  color: var(--stp-text);
}

/* ------------------------------------------------------------- the tile --
   A rounded square holding the icon, with the number riding its outer top
   corner — the two together are the thing the eye lands on, so everything else
   stays quiet around them. */
.veloura-stp .stp__dot {
  position: relative;
  z-index: 1;
  display: grid;
  place-items: center;
  width: var(--stp-tile);
  height: var(--stp-tile);
  flex: 0 0 auto;
  border-radius: var(--stp-radius, 26px);
  background: var(--step-icon-bg, var(--stp-second));
  color: var(--step-color, var(--stp-accent));
  transition: transform .35s ease, box-shadow .35s ease, background-color .35s ease;
}

/* The square is the merchant's to keep or drop; without it the icon simply
   stands on the page and is drawn a size larger to hold the row. */
.veloura-stp.stp--bare .stp__dot {
  background: transparent !important;
  box-shadow: none !important;
}

.veloura-stp.stp--bare .stp__dot i { font-size: calc(var(--stp-tile) * .52); }

.veloura-stp .stp__dot i { font-size: calc(var(--stp-tile) * .4); line-height: 1; }
.veloura-stp .stp__dot img { width: 54%; height: 54%; object-fit: contain; }

@media (hover: hover) and (pointer: fine) {
  .veloura-stp .stp__step:hover .stp__dot {
    transform: translateY(-6px);
    box-shadow: 0 16px 30px color-mix(in srgb, var(--step-color, var(--stp-accent)) 18%, transparent);
  }
}

/* The step used to wear its order on a badge. The line carries the sequence
   now, and on a phone the spine's own dot marks the step — nothing written
   inside it. The pin only exists on a phone. */
.veloura-stp .stp__pin { display: none; }

/* ------------------------------------------------------------- the words -- */
.veloura-stp .stp__text { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.veloura-stp .stp__text h3 { margin: 0; font-size: 16px; font-weight: 800; color: var(--stp-title); }
.veloura-stp .stp__text p { margin: 0; font-size: 13px; line-height: 1.75; opacity: .72; }

/* ==================================================== the laptop: one shape ==
   The icon on top and the words beneath it — always, whatever the direction
   setting says; that setting is a phone affair now. Through the row runs a
   thick track, tile centre to tile centre, with a cap at each end so the
   sequence has a beginning and an end instead of a line that fades in from
   nowhere.
   ========================================================================== */
@media (min-width: 768px) {
  .veloura-stp .stp__row {
    grid-template-columns: repeat(var(--stp-cols, 4), minmax(0, 1fr));
    row-gap: 48px;
  }

  .veloura-stp .stp__step {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
  }

  .veloura-stp .stp__text { align-items: center; }
  .veloura-stp .stp__text h3 { font-size: 17px; }
  .veloura-stp .stp__text p { max-width: 30ch; }

  /* The words may be set to the start of their column, but the tiles stay
     centred: the track is drawn through their centres and would miss them. */
  .veloura-stp:not(.is-centered) .stp__text { text-align: start; align-items: flex-start; }

  /* ----------------------------------------------------------- the track -- */
  /* One segment per gap, tile edge to tile edge, on the tiles' own centre
     line. The ends are square where they meet a tile, so the segments read as
     one line passing through the row rather than as dashes. */
  .veloura-stp.has-line .stp__step::after {
    content: "";
    position: absolute;
    top: calc(var(--stp-tile) / 2 - var(--stp-line-w) / 2);
    inset-inline-end: calc(50% + var(--stp-tile) / 2 - 3px);
    width: calc(100% + var(--stp-col-gap) - var(--stp-tile) + 6px);
    height: var(--stp-line-w);
    background: var(--stp-line);
    opacity: 0;
    transition: opacity .7s ease calc(var(--i, 0) * .1s);
  }

  /* Nothing arrives at the first card of a row — the segment would leave from
     the far edge of the grid and come from nowhere. The count is the
     merchant's own column setting. */
  .veloura-stp.has-line .stp__step:first-child::after,
  .veloura-stp.has-line .stp__step:nth-child({{ stp_cols }}n + 1)::after { content: none; }

  /* ------------------------------------------------------------ the ends -- */
  .veloura-stp.has-line .stp__step:first-child::before,
  .veloura-stp.has-line .stp__step:last-child::before {
    content: "";
    position: absolute;
    top: calc(var(--stp-tile) / 2 - var(--stp-cap) / 2);
    width: 36px;
    height: var(--stp-cap);
    border-radius: 999px;
    background: var(--stp-line);
    opacity: 0;
    transition: opacity .7s ease;
  }

  .veloura-stp.has-line .stp__step:first-child::before { inset-inline-end: calc(50% + var(--stp-tile) / 2 - 3px); }
  .veloura-stp.has-line .stp__step:last-child::before { inset-inline-start: calc(50% + var(--stp-tile) / 2 - 3px); }

  .veloura-stp.has-line.is-inview .stp__step::after,
  .veloura-stp.has-line.is-inview .stp__step::before { opacity: 1; }

  .veloura-stp:not(.has-line) .stp__step::after,
  .veloura-stp:not(.has-line) .stp__step::before { content: none; }
}
/* ==================================================== the phone: one shape ==
   The spine runs down the middle and a step hangs from each side of it in
   turn, with a plain dot on the line for each — the order is in the reading,
   not in a number printed on the page.

   The line is drawn by the steps themselves, one segment each, and not by the
   list around them: a list carries padding of its own in more stylesheets than
   it is worth arguing with, and a spine measured against a box the steps are
   not sitting in is a spine that misses the middle.

   Left to itself each step leans on the outer margin, icon hard against the
   edge. With «توسيط النصوص» on, it is centred in its half instead — which is
   what makes the two columns balance.
   ========================================================================== */
@media (max-width: 767px) {
  .veloura-stp {
    --stp-tile: 56px;
    --stp-step-gap: 12px;
    --stp-pin-y: 50%;
  }

  /* With the words under the icon the step's middle falls on the title, so the
     dot — and the ends of the spine — are measured to the icon's own line. */
  .veloura-stp.stp--v { --stp-pin-y: calc(var(--stp-tile) / 2); }

  /* A lifted tile becomes the containing block for whatever is positioned
     inside it, and on a phone that is a fight nobody wins. No lift. */
  .veloura-stp .stp__step:hover .stp__dot { transform: none; }

  .veloura-stp .stp__row {
    position: relative;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--stp-step-gap);
  }

  .veloura-stp .stp__step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    transform: translateY(10px);
  }

  .veloura-stp.is-inview .stp__step { transform: none; }

  /* Half the row, less the little the spine and its dot need: the words live
     in what is left, so not a pixel more is reserved. */
  .veloura-stp .stp__step:nth-child(odd) { padding-inline-end: calc(47% + 16px); }
  .veloura-stp .stp__step:nth-child(even) { padding-inline-start: calc(47% + 16px); }

  /* ------------------------------------------------------------ the spine -- */
  /* One segment per step, centred on the step itself — the same box the two
     halves are measured from, so the line cannot drift off the middle. The
     segments overlap the row gap, and the first and last stop at their own dot
     so the run has a visible beginning and end. */
  .veloura-stp.has-line .stp__step::before {
    content: "";
    position: absolute;
    inset-inline-start: 50%;
    margin-inline-start: calc(var(--stp-line-w) / -2);
    top: calc(var(--stp-step-gap) / -2 - 1px);
    bottom: calc(var(--stp-step-gap) / -2 - 1px);
    width: var(--stp-line-w);
    border-radius: 999px;
    background: var(--stp-line);
    transform: scaleY(0);
    transform-origin: 50% 0;
    transition: transform .5s ease calc(var(--i, 0) * .1s);
  }

  .veloura-stp.has-line .stp__step:first-child::before { top: var(--stp-pin-y); }
  .veloura-stp.has-line .stp__step:last-child::before { bottom: calc(100% - var(--stp-pin-y)); }
  .veloura-stp.has-line.is-inview .stp__step::before { transform: scaleY(1); }

  .veloura-stp .stp__step::after { content: none; }
  .veloura-stp:not(.has-line) .stp__step::before { content: none; }

  /* ------------------------------------------------------- the two halves -- */
  /* Beside the icon: the tile is pushed out to the margin and the words come
     back towards the spine. */
  .veloura-stp.stp--h .stp__text { flex: 1 1 auto; }
  .veloura-stp.stp--h .stp__step:nth-child(odd) { flex-direction: row; text-align: start; }
  .veloura-stp.stp--h .stp__step:nth-child(even) { flex-direction: row-reverse; text-align: end; }
  .veloura-stp.stp--h .stp__step:nth-child(odd) .stp__text { align-items: flex-start; }
  .veloura-stp.stp--h .stp__step:nth-child(even) .stp__text { align-items: flex-end; }

  /* Above the words: the whole block leans on the outer margin. */
  .veloura-stp.stp--v .stp__step { flex-direction: column; gap: 8px; }
  .veloura-stp.stp--v .stp__step:nth-child(odd) { align-items: flex-start; text-align: start; }
  .veloura-stp.stp--v .stp__step:nth-child(even) { align-items: flex-end; text-align: end; }
  .veloura-stp.stp--v .stp__step:nth-child(odd) .stp__text { align-items: flex-start; }
  .veloura-stp.stp--v .stp__step:nth-child(even) .stp__text { align-items: flex-end; }

  /* ------------------------------------------------------------- centred -- */
  /* The setting is worth something on a phone too: each step sits in the
     middle of its own half, and the two columns answer each other exactly. */
  /* The two halves above are addressed per nth-child, so these have to be as
     well or they lose the tie and nothing moves. */
  .veloura-stp.is-centered .stp__step:nth-child(odd),
  .veloura-stp.is-centered .stp__step:nth-child(even),
  .veloura-stp.is-centered .stp__step:nth-child(odd) .stp__text,
  .veloura-stp.is-centered .stp__step:nth-child(even) .stp__text { text-align: center; }

  .veloura-stp.stp--v.is-centered .stp__step:nth-child(odd),
  .veloura-stp.stp--v.is-centered .stp__step:nth-child(even),
  .veloura-stp.stp--v.is-centered .stp__step:nth-child(odd) .stp__text,
  .veloura-stp.stp--v.is-centered .stp__step:nth-child(even) .stp__text { align-items: center; }

  .veloura-stp.stp--h.is-centered .stp__step:nth-child(odd),
  .veloura-stp.stp--h.is-centered .stp__step:nth-child(even) { justify-content: center; }

  .veloura-stp.stp--h.is-centered .stp__step:nth-child(odd) .stp__text,
  .veloura-stp.stp--h.is-centered .stp__step:nth-child(even) .stp__text { flex: 0 1 auto; align-items: center; }

  /* ------------------------------------------------------------- the rest -- */
  .veloura-stp .stp__text p { max-width: none; font-size: 12px; }
  .veloura-stp .stp__text h3 { font-size: 15px; }

  /* static, not relative: the dot is pinned to the STEP, and a positioned tile
     would catch it and hold it against its own edge instead. */
  .veloura-stp .stp__dot {
    position: static;
    z-index: auto;
    overflow: visible;
    background: var(--step-icon-bg, var(--stp-second));
  }

  .veloura-stp.stp--bare .stp__dot { background: transparent !important; }

  .veloura-stp .stp__pin {
    display: block;
    position: absolute;
    inset-inline-start: 50%;
    top: var(--stp-pin-y);
    transform: translate(50%, -50%);
    width: 12px;
    height: 12px;
    border-radius: 999px;
    border: 3px solid var(--stp-page);
    background: var(--step-color, var(--stp-accent));
  }
}

/* ---------------------------------------------------------- the reveal --- */
.veloura-stp .stp__step {
  opacity: 0;
  transition: opacity .6s ease calc(var(--i, 0) * .12s), transform .6s ease calc(var(--i, 0) * .12s);
}

.veloura-stp.is-inview .stp__step { opacity: 1; }

/* No script, no observer, no reveal — the section must still be readable. */
.veloura-stp.no-js .stp__step { opacity: 1; transform: none; }

@media (prefers-reduced-motion: reduce) {
  .veloura-stp .stp__step, .veloura-stp .stp__dot { transition: none; }
  .veloura-stp .stp__step { opacity: 1; transform: none; }
  .veloura-stp .stp__step::before,
  .veloura-stp .stp__step::after { opacity: 1 !important; transition: none; }
}

/* ------------------------------------------------------------ the dark -- */
html.dark .veloura-stp, html body.dark .veloura-stp {
  --stp-page: var(--veloura-dark-body-bg, var(--veloura-dark-bg, #010202));
}

html.dark .veloura-stp .stp__dot,
html body.dark .veloura-stp .stp__dot {
  color: var(--step-color, var(--stp-accent));
}
/* ============================================================ the flow ====
   ومضة ضوء تمشي على الشريط الواصل من الخطوة الأولى إلى الأخيرة، ثم تتوقف
   لحظة وتعيد — على اللابتوب أفقياً وعلى الجوال نزولاً على العمود. كل مقطع
   يأخذ دوره بالتأخير (--i)، فتبدو ومضة واحدة متصلة. وعند وصولها لخطوة
   تتوهّج أيقونتها (لابتوب) أو تنبض دائرتها (جوال). */
.veloura-stp {
  --stp-flow-step: .9s;
  --stp-flow: color-mix(in srgb, var(--stp-accent) 35%, #ffffff);
}

html.dark .veloura-stp, html body.dark .veloura-stp {
  --stp-flow: color-mix(in srgb, var(--stp-accent) 30%, #ffffff);
}

@keyframes {{ stp_anim }}-x {
  0% { background-position: 170% 0; }
  {{ stp_x_pct }}% { background-position: -70% 0; }
  100% { background-position: -70% 0; }
}

@keyframes {{ stp_anim }}-y {
  0% { background-position: 0 -100%; }
  {{ stp_y_pct }}% { background-position: 0 200%; }
  100% { background-position: 0 200%; }
}

@keyframes {{ stp_anim }}-tile {
  0%, {{ (stp_x_pct * 0.2)|round(3) }}% { box-shadow: 0 0 0 0 transparent; }
  {{ stp_x_pct }}% { box-shadow: 0 0 0 5px color-mix(in srgb, var(--step-color, var(--stp-accent)) 35%, transparent), 0 10px 26px color-mix(in srgb, var(--step-color, var(--stp-accent)) 30%, transparent); }
  {{ (stp_x_pct * 1.9)|round(3) }}%, 100% { box-shadow: 0 0 0 0 transparent; }
}

@keyframes {{ stp_anim }}-pin {
  0%, {{ (stp_y_half * 0.3)|round(3) }}% { transform: translate(50%, -50%) scale(1); box-shadow: 0 0 0 0 transparent; }
  {{ stp_y_half }}% { transform: translate(50%, -50%) scale(1.3); box-shadow: 0 0 0 6px color-mix(in srgb, var(--step-color, var(--stp-accent)) 30%, transparent); }
  {{ stp_y_pct }}%, 100% { transform: translate(50%, -50%) scale(1); box-shadow: 0 0 0 0 transparent; }
}

@media (min-width: 768px) {
  /* تذهب الومضة من يمين المقطع إلى يساره (من الخطوة السابقة إلى التالية). */
  .veloura-stp.has-line .stp__step::after {
    background-image: linear-gradient(90deg, transparent, var(--stp-flow) 35%, #ffffff 50%, var(--stp-flow) 65%, transparent);
    background-size: 45% 100%;
    background-repeat: no-repeat;
    background-position: 170% 0;
  }
  html[dir="ltr"] .veloura-stp.has-line .stp__step::after { transform: scaleX(-1); }

  .veloura-stp.has-line.is-inview .stp__step::after {
    animation: {{ stp_anim }}-x calc(var(--stp-flow-step) * {{ stp_x_slots }}) linear infinite;
    animation-delay: calc((var(--i, 1) - 1) * var(--stp-flow-step));
  }

  .veloura-stp.has-line.is-inview .stp__dot {
    animation: {{ stp_anim }}-tile calc(var(--stp-flow-step) * {{ stp_x_slots }}) ease-out infinite;
    animation-delay: calc((var(--i, 0) - 1) * var(--stp-flow-step));
  }
}

@media (max-width: 767px) {
  /* دائرة أكبر، وإطارها بلون خلفية المتجر (فاتح وداكن) لتندمج معها. */
  .veloura-stp .stp__pin {
    width: 18px !important;
    height: 18px !important;
    border: 4px solid var(--stp-page) !important;
    box-sizing: border-box;
    z-index: 2;
  }

  .veloura-stp.has-line .stp__step::before {
    background-image: linear-gradient(180deg, transparent, var(--stp-flow) 35%, #ffffff 50%, var(--stp-flow) 65%, transparent);
    background-size: 100% 60%;
    background-repeat: no-repeat;
    background-position: 0 -100%;
  }

  .veloura-stp.has-line.is-inview .stp__step::before {
    animation: {{ stp_anim }}-y calc(var(--stp-flow-step) * {{ stp_y_slots }}) linear infinite;
    animation-delay: calc(var(--i, 0) * var(--stp-flow-step));
  }

  .veloura-stp.has-line.is-inview .stp__pin {
    animation: {{ stp_anim }}-pin calc(var(--stp-flow-step) * {{ stp_y_slots }}) ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * var(--stp-flow-step));
  }
}

@media (prefers-reduced-motion: reduce) {
  .veloura-stp .stp__step::before,
  .veloura-stp .stp__step::after,
  .veloura-stp .stp__dot,
  .veloura-stp .stp__pin { animation: none !important; }
}
/* Preserve merchant colours, including on icons, in either colour mode. */
html body .veloura-stp .stp__dot,
html body .veloura-stp .stp__dot i {
  color: var(--step-color, var(--stp-accent)) !important;
  -webkit-text-fill-color: currentColor !important;
}
html body .veloura-stp .stp__heading h2,
html body .veloura-stp .stp__text h3 {
  color: var(--stp-title) !important;
}
html body .veloura-stp .stp__heading p,
html body .veloura-stp .stp__text p {
  color: var(--stp-text) !important;
}
</style>

  <section
    data-veloura-home-tab="{{ veloura_home_tab_key|e }}"
    data-veloura-steps
    id="veloura-purchase-steps-{{ position }}"
    class="s-block veloura-stp no-js
      stp--{{ stp_dir }}
      {{ component.veloura_steps_tile_bg is defined and not component.veloura_steps_tile_bg ? 'stp--bare' : '' }}
      {{ component.veloura_steps_center_text ? 'is-centered' : '' }}
      {{ stp_line ? 'has-line' : '' }}
      {{ component.veloura_steps_mobile_only ? 'veloura-mobile-only' : '' }}
      {{ component.veloura_steps_desktop_only ? 'veloura-desktop-only' : '' }}
      {{ component.veloura_steps_custom_classes }}"
    style="
      --stp-radius: {{ stp_radius_map[stp_radius_key]|default((stp_radius_key ~ '' == '' ? '20' : stp_radius_key) ~ 'px') }};
      --stp-accent: {{ component.veloura_steps_accent_color|default('#004956') }};
      {# Explicit component colours stay identical in both colour modes. #}
      --stp-title-light: {{ component.veloura_steps_title_color|default('#0f172a') }};
      --stp-text-light: {{ component.veloura_steps_text_color|default('#52606d') }};
      --stp-cols: {{ stp_cols }};
      {% if component.veloura_steps_custom_spacing %}--stp-gutter: {{ component.veloura_steps_spacing|default(0) }}px;{% endif %}
    "
  >
    <div class="container">

      {% if component.veloura_steps_title or component.veloura_steps_subtitle %}
        <div class="stp__heading veloura-component-title" data-veloura-section-heading>
          <div data-veloura-section-heading-text>
            {% if component.veloura_steps_kicker %}<span class="stp__kicker">{{ component.veloura_steps_kicker }}</span>{% endif %}
            {% if component.veloura_steps_title %}<h2>{{ component.veloura_steps_title }}</h2>{% endif %}
            {% if component.veloura_steps_subtitle %}<p>{{ component.veloura_steps_subtitle }}</p>{% endif %}
          </div>
        </div>
      {% endif %}

      {% if stp_items %}
        <ol class="stp__row">
          {% for step in stp_items %}
            {% set step_image = step.step_image.url|default(step.step_image) %}
            {% set step_icon_bg = step.step_icon_background|default('#f4f5f7') %}
            {% if step_icon_bg.value is defined %}{% set step_icon_bg = step_icon_bg.value %}{% endif %}
            <li class="stp__step" style="--step-icon-bg: {{ step_icon_bg|e }}; --i: {{ loop.index0 }}; {% if step.step_color %}--step-color: {{ step.step_color }};{% endif %}">
              <span class="stp__dot">
                {% if step_image %}
                  <img src="{{ step_image }}" alt="{{ step.step_title|default('') }}" loading="lazy" decoding="async">
                {% elseif step.step_icon %}
                  <i class="{{ step.step_icon }}" aria-hidden="true"></i>
                {% endif %}
              </span>

              <span class="stp__pin" aria-hidden="true"></span>

              <span class="stp__text">
                {% if step.step_title %}<h3>{{ step.step_title }}</h3>{% endif %}
                {% if step.step_description %}<p>{{ step.step_description }}</p>{% endif %}
              </span>
            </li>
          {% endfor %}
        </ol>
      {% endif %}

    </div>
  </section>

  {# Inline on purpose: the bundled script goes through a build and a CDN, and
     this section has to reveal itself the moment the Twig is published. The
     class is dropped first so that, with no JavaScript at all, the steps are
     simply visible. #}
  <script>
  (function () {
    var section = document.getElementById('veloura-purchase-steps-{{ position }}');
    if (!section) return;
    section.classList.remove('no-js');

    if (!('IntersectionObserver' in window)) { section.classList.add('is-inview'); return; }

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-inview');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.2, rootMargin: '0px 0px -10% 0px' });

    observer.observe(section);
  })();
  </script>
{% endif %}