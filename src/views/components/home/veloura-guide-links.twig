{# Independent homepage guide; appearance follows the global theme tokens. #}
{% if not component.hide %}
  {% set guide_mode = component.button_mode|default('both') %}
  {% if guide_mode.selected is defined %}{% set guide_mode = guide_mode.selected %}{% endif %}
  {% if guide_mode is iterable and guide_mode.value is not defined %}{% set guide_mode = guide_mode|first %}{% endif %}
  {% if guide_mode.value is defined %}{% set guide_mode = guide_mode.value %}{% endif %}
  {% set guide_sizes = guide_mode in ['sizes','both'] %}
  {% set guide_loyalty = guide_mode in ['loyalty','both'] %}
  {% set loyalty_url = component.loyalty_url|default('')|trim %}
  {% if not loyalty_url %}{% set loyalty_url = store.url|trim('/') ~ '/loyalty' %}{% endif %}
  {% set loyalty_valid = loyalty_url starts with 'https://' or loyalty_url starts with 'http://' or loyalty_url starts with '/' %}
  {% if guide_sizes or (guide_loyalty and loyalty_valid) %}
    <nav class="veloura-guide-links {{ component.left_side ? 'veloura-guide-links--left' : '' }}" aria-label="المقاسات والولاء" style="--guide-bg:{{ component.background|default('#005369')|e }};--guide-ink:{{ component.text_color|default('#ffffff')|e }};">
      {% if guide_sizes %}
        <button type="button" data-guide-open aria-haspopup="dialog" aria-controls="guide-dialog-{{ position }}">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="7" width="18" height="10" rx="2"/><path d="M7 7v5m5-5v3m5-3v5"/></svg>
          <span>{{ component.size_label|default('دليل المقاسات')|e }}</span>
        </button>
      {% endif %}
      {% if guide_loyalty and loyalty_valid %}
        <a href="{{ loyalty_url|e }}" target="_blank" rel="noopener" aria-label="ولاء العملاء — يفتح في صفحة جديدة">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9Z"/></svg>
          <span>{{ component.loyalty_label|default('ولاء العملاء')|e }}</span>
        </a>
      {% endif %}
    </nav>
    {% if guide_sizes %}
      <dialog id="guide-dialog-{{ position }}" class="veloura-size-guide" aria-labelledby="guide-title-{{ position }}" dir="rtl">
        <header><h2 id="guide-title-{{ position }}">{{ component.size_title|default('دليل المقاسات وطريقة القياس')|e }}</h2><button type="button" data-guide-close aria-label="إغلاق دليل المقاسات">×</button></header>
        <div class="veloura-size-guide__content">
          {% if component.size_intro %}<p>{{ component.size_intro|e }}</p>{% endif %}
          {% for section in component.size_sections %}
            <section>
              {% if section.title %}<h3>{{ section.title|e }}</h3>{% endif %}
              {% if section.text %}<p>{{ section.text|e }}</p>{% endif %}
              {% if section.image %}<a href="{{ section.image|e }}" target="_blank" rel="noopener" aria-label="فتح الصورة بالحجم الكامل"><img src="{{ section.image|e }}" alt="{{ section.title|default('جدول المقاسات')|e }}" loading="lazy"></a>{% endif %}
            </section>
          {% endfor %}
        </div>
      </dialog>
      <script>
      (function(){
        var script=document.currentScript,dialog=script.previousElementSibling;
        if(!dialog||dialog.tagName!=='DIALOG'||dialog.dataset.bound)return;
        dialog.dataset.bound='true';var nav=dialog.previousElementSibling,button=nav.querySelector('[data-guide-open]');
        button.addEventListener('click',function(){dialog.showModal();});
        dialog.querySelector('[data-guide-close]').addEventListener('click',function(){dialog.close();});
        dialog.addEventListener('close',function(){button.focus();});
        dialog.addEventListener('click',function(e){if(e.target!==dialog)return;var r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close();});
      })();
      </script>
    {% endif %}
    <style>
      .veloura-guide-links{position:fixed;right:0;left:auto;top:40%;z-index:2147481900;display:flex;flex-direction:column;gap:7px;direction:rtl;pointer-events:none;}
      .veloura-guide-links--left{left:0;right:auto;}
      .veloura-guide-links a,.veloura-guide-links button{display:flex;align-items:center;gap:8px;writing-mode:vertical-rl;max-height:180px;overflow:auto;padding:13px 8px;border:1px solid #ffffff55;border-radius:14px 0 0 14px;background:var(--guide-bg);color:var(--guide-ink);box-shadow:0 5px 18px #0002;text-decoration:none;font-family:inherit;font-size:12px;font-weight:700;line-height:1.4;pointer-events:auto;cursor:pointer;}
      .veloura-guide-links--left a,.veloura-guide-links--left button{border-radius:0 14px 14px 0;}
      .veloura-guide-links svg{flex-shrink:0;}
      .veloura-guide-links :is(a,button):focus-visible{outline:3px solid var(--guide-ink);outline-offset:-4px;}
      .veloura-size-guide{position:fixed;inset:0;margin:auto;width:min(920px,calc(100% - 24px));max-width:none;max-height:90dvh;padding:0;border:0;border-radius:20px;background:#fff;color:#15313b;overflow:auto;box-shadow:0 25px 90px #0005;}
      .veloura-size-guide::backdrop{background:#07182099;backdrop-filter:blur(6px);}
      .veloura-size-guide header{position:sticky;top:0;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 24px;background:inherit;border-bottom:1px solid #8883;z-index:1;}
      .veloura-size-guide h2{font-size:22px;font-weight:800;margin:0;color:inherit;}
      .veloura-size-guide header button{width:44px;height:44px;flex-shrink:0;border:0;border-radius:50%;background:#8882;color:inherit;font-size:28px;cursor:pointer;}
      .veloura-size-guide__content{padding:24px;}
      .veloura-size-guide h3{font-size:19px;font-weight:700;margin:0 0 12px;color:inherit;}
      .veloura-size-guide p{white-space:pre-line;line-height:1.9;margin:0 0 20px;color:inherit;}
      .veloura-size-guide section+section{margin-top:28px;padding-top:24px;border-top:1px solid #8883;}
      .veloura-size-guide img{display:block;max-width:100%;height:auto;margin:16px auto;border-radius:10px;}
      .veloura-size-guide :is(button,a):focus-visible{outline:2px solid currentColor;outline-offset:3px;}
      html.dark .veloura-size-guide,body.dark .veloura-size-guide{background:#14262e;color:#f1f7fa;}
      @media(max-width:600px){.veloura-size-guide{width:100%;height:100dvh;max-height:100dvh;border-radius:0;}.veloura-size-guide header{padding:14px 16px;}.veloura-size-guide h2{font-size:19px;}.veloura-size-guide__content{padding:20px 16px;}}
    </style>
    <style>
      .veloura-guide-links,.veloura-size-guide{--guide-radius:min(var(--veloura-global-radius,16px),40px);}
      .veloura-guide-links :is(a,button){border-radius:var(--guide-radius) 0 0 var(--guide-radius);}
      .veloura-guide-links--left :is(a,button){border-radius:0 var(--guide-radius) var(--guide-radius) 0;}
      .veloura-size-guide{background:var(--veloura-site-second-bg,#f4f5f7);color:var(--veloura-primary-text,var(--color-text,#15313b));border-radius:var(--guide-radius);}
      .veloura-size-guide header button{border-radius:var(--guide-radius);background:color-mix(in srgb,currentColor 8%,transparent);}
      .veloura-size-guide img{border-radius:var(--guide-radius);}
      html.dark .veloura-size-guide,body.dark .veloura-size-guide{background:var(--veloura-dark-secondary-bg,#14262e);color:var(--veloura-dark-primary-text,var(--veloura-dark-secondary-text,#f1f7fa));}
      @media(max-width:600px){.veloura-size-guide{border-radius:0;}}
    </style>
  {% endif %}
{% endif %}
