{# VELOURA HOME TAB ASSIGNMENT START #}
{% set veloura_home_tab_key = component.veloura_home_tab_name_2026|default('') %}
{% if veloura_home_tab_key.value is defined %}{% set veloura_home_tab_key = veloura_home_tab_key.value %}{% endif %}
{% if not veloura_home_tab_key %}{% set veloura_home_tab_key = 'always' %}{% endif %}
{# VELOURA HOME TAB ASSIGNMENT END #}

{# ==========================================================================
   الباقات (فيلورا)

   باقات جنب بعضها تُقارن بالعين: نفس العنوان ونفس موضع السعر ونفس صفوف
   الميزات في كل بطاقة، وباقة واحدة تُميَّز بإطار متحرك وشريط صغير. سطر
   الميزة الذي يبدأ بـ «-» يُقرأ كميزة غير مشمولة فتظهر مشطوبة بعلامة ×،
   وهو ما يجعل المقارنة صريحة بلا جدول.

   مبدّل «شهري / سنوي» اختياري: كل باقة تحمل السعرين، والمبدّل يقلبهما مع
   حركة قصيرة بلا إعادة تحميل.

   الستايل والسكربت في الملف نفسه مثل بقية عناصر فيلورا.
   ========================================================================== #}

{% if not component.vpk_hide %}

  {% set vpk_items = component.vpk_plans|default([]) %}

  {% set vpk_radius = component.vpk_radius|default(22) %}
  {% if vpk_radius.value is defined %}{% set vpk_radius = vpk_radius.value %}{% endif %}
  {% set vpk_radius_px = (vpk_radius ~ '') == '40' ? '999px' : ((vpk_radius ~ '' == '' ? '22' : vpk_radius) ~ 'px') %}

  {% set vpk_cols = component.vpk_desktop_cols|default(3) %}
  {% if vpk_cols.value is defined %}{% set vpk_cols = vpk_cols.value %}{% endif %}
  {% if vpk_cols is iterable or vpk_cols ~ '' == '' %}{% set vpk_cols = 3 %}{% endif %}
  {% set vpk_billing = component.vpk_show_billing ? true : false %}

  {% set vpk_mobile = component.vpk_mobile_mode|default('swipe') %}
  {% if vpk_mobile.selected is defined %}{% set vpk_mobile = vpk_mobile.selected %}{% endif %}
  {% if vpk_mobile is iterable and vpk_mobile.value is not defined %}{% set vpk_mobile = vpk_mobile|first %}{% endif %}
  {% if vpk_mobile.value is defined %}{% set vpk_mobile = vpk_mobile.value %}{% endif %}
  {% if vpk_mobile not in ['swipe', 'grid'] %}{% set vpk_mobile = 'swipe' %}{% endif %}

  {% set vpk_classes = [
    's-block',
    'vpk',
    component.vpk_center_titles ? 'is-centered' : '',
    vpk_billing ? 'vpk--billing' : '',
    component.vpk_dark_cards ? 'vpk--dark-cards' : '',
    'vpk--m-' ~ vpk_mobile,
    component.vpk_custom_spacing ? 'has-spacing' : '',
    component.vpk_mobile_only ? 'veloura-mobile-only' : '',
    component.vpk_desktop_only ? 'veloura-desktop-only' : '',
    component.vpk_custom_classes ?: ''
  ]|join(' ') %}

<style>
/* ==========================================================================
   الباقات — كل شيء داخل .vpk
   ========================================================================== */
.vpk {
  --vpk-radius: 22px;
  --vpk-accent: #004956;
  --vpk-title: #111827;
  --vpk-text: #4b5563;
  --vpk-card: #ffffff;
  --vpk-line: color-mix(in srgb, var(--vpk-title) 12%, transparent);
  --vpk-r-inner: min(var(--vpk-radius), 16px);
  --vpk-r-pill: min(calc(var(--vpk-radius) * 40), 999px);
  padding-block: 44px;
  background: transparent !important;
  color: var(--vpk-text);
}

.vpk [hidden] { display: none !important; }

/* ---------- العنوان ---------- */
.vpk .vpk__heading { margin-bottom: 20px; text-align: start; }
.vpk.is-centered .vpk__heading { text-align: center; }
.vpk .vpk__heading h2 {
  margin: 0 0 6px;
  font-size: 28px;
  font-weight: 800;
  color: var(--vpk-title);
}
.vpk .vpk__heading p { margin: 0; font-size: 15px; color: var(--vpk-text); }

/* ---------- مبدّل شهري / سنوي ---------- */
.vpk .vpk__billing {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px;
  margin-bottom: 22px;
  border-radius: var(--vpk-r-pill);
  background: color-mix(in srgb, var(--vpk-title) 7%, transparent);
}
.vpk.is-centered .vpk__billing-wrap { text-align: center; }

.vpk .vpk__billing button {
  position: relative;
  border: 0;
  padding: 9px 18px;
  border-radius: var(--vpk-r-pill);
  background: transparent;
  color: var(--vpk-text);
  font: inherit;
  font-size: 13.5px;
  font-weight: 800;
  cursor: pointer;
  transition: color .25s ease, background-color .3s ease, box-shadow .3s ease;
}
.vpk .vpk__billing button.is-on {
  background: var(--vpk-accent);
  color: #ffffff;
  box-shadow: 0 6px 18px color-mix(in srgb, var(--vpk-accent) 28%, transparent);
}
.vpk .vpk__save {
  margin-inline-start: 6px;
  font-size: 11.5px;
  font-weight: 800;
  color: var(--vpk-accent);
}
.vpk .vpk__billing button.is-on .vpk__save { color: inherit; opacity: .9; }

/* ---------- الشبكة ---------- */
.vpk .vpk__grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 16px;
  align-items: stretch;
}

@media (min-width: 640px) and (max-width: 1023px) {
  .vpk .vpk__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (min-width: 1024px) {
  .vpk .vpk__grid {
    grid-template-columns: repeat(var(--vpk-cols, 3), minmax(0, 1fr));
    gap: 20px;
  }
}

/* ---------- البطاقة ---------- */
.vpk .vpk__card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 24px 20px;
  border-radius: var(--vpk-radius);
  background: var(--vpk-card);
  border: 1px solid var(--vpk-line);
  color: var(--vpk-text);
  opacity: 0;
  transform: translateY(14px);
  transition:
    opacity .55s ease calc(var(--i, 0) * .09s),
    transform .55s ease calc(var(--i, 0) * .09s),
    box-shadow .3s ease,
    border-color .3s ease;
}

.vpk.is-inview .vpk__card { opacity: 1; transform: none; }
.vpk.no-js .vpk__card { opacity: 1; transform: none; }

@media (hover: hover) and (pointer: fine) {
  .vpk .vpk__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 40px color-mix(in srgb, var(--vpk-plan, var(--vpk-accent)) 22%, transparent);
    border-color: color-mix(in srgb, var(--vpk-plan, var(--vpk-accent)) 45%, transparent);
  }
}

/* الباقة المميّزة: إطار متحرك رقيق يلتف حولها، وشريط صغير في أعلاها. */
.vpk .vpk__card.is-featured {
  border-color: transparent;
  background:
    linear-gradient(var(--vpk-card), var(--vpk-card)) padding-box,
    conic-gradient(
      from var(--vpk-spin, 0deg),
      color-mix(in srgb, var(--vpk-plan, var(--vpk-accent)) 85%, transparent),
      color-mix(in srgb, var(--vpk-plan, var(--vpk-accent)) 10%, transparent) 35%,
      color-mix(in srgb, var(--vpk-plan, var(--vpk-accent)) 85%, transparent) 70%,
      color-mix(in srgb, var(--vpk-plan, var(--vpk-accent)) 10%, transparent)
    ) border-box;
  border-width: 1.5px;
  animation: vpk-spin 6s linear infinite;
}

@property --vpk-spin {
  syntax: '<angle>';
  inherits: false;
  initial-value: 0deg;
}

@keyframes vpk-spin { to { --vpk-spin: 360deg; } }

@media (min-width: 1024px) {
  .vpk.is-inview .vpk__card.is-featured { transform: translateY(-8px); }
  @media (hover: hover) and (pointer: fine) {
    .vpk .vpk__card.is-featured:hover { transform: translateY(-14px); }
  }
}

.vpk .vpk__badge {
  position: absolute;
  top: -11px;
  inset-inline-start: 20px;
  padding: 4px 12px;
  border-radius: var(--vpk-r-pill);
  background: var(--vpk-plan, var(--vpk-accent));
  color: #ffffff;
  font-size: 11.5px;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
}
.vpk.is-centered .vpk__badge { inset-inline-start: 50%; transform: translateX(50%); }
html[dir="ltr"] .vpk.is-centered .vpk__badge { transform: translateX(-50%); }

/* لمعة تمرّ على الشريط كل بضع ثوان. */
.vpk .vpk__badge::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(110deg, transparent 20%, rgba(255, 255, 255, .55), transparent 80%);
  transform: translateX(-120%);
  animation: vpk-shine 3.6s ease-in-out infinite;
}
@keyframes vpk-shine {
  0%, 55% { transform: translateX(-120%); }
  85%, 100% { transform: translateX(120%); }
}

/* ---------- محتوى البطاقة ----------
   ترتيب ثابت في كل بطاقة: رأس (اسم + وصف)، ثم صندوق السعر، ثم الميزات، ثم
   الزر في الأسفل. ثبات المواضع هو ما يجعل المقارنة بالعين ممكنة. */
.vpk .vpk__head {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.vpk .vpk__name {
  margin: 0;
  font-size: 18px;
  font-weight: 800;
  letter-spacing: -.2px;
  color: var(--vpk-title);
  display: flex;
  align-items: center;
  gap: 8px;
}
/* نقطة صغيرة بلون الباقة تسبق الاسم، تربط البطاقة بلونها. */
.vpk .vpk__name::before {
  content: "";
  flex: 0 0 auto;
  width: 8px;
  height: 8px;
  border-radius: min(var(--vpk-r-inner), 50%);
  background: var(--vpk-plan, var(--vpk-accent));
}
.vpk.is-centered .vpk__name { justify-content: center; }

.vpk .vpk__desc {
  margin: 0;
  font-size: 13.5px;
  line-height: 1.75;
  min-height: 2.6em;
  opacity: .9;
}

.vpk .vpk__price-box {
  padding: 14px 16px;
  border-radius: var(--vpk-r-inner);
  background: color-mix(in srgb, var(--vpk-plan, var(--vpk-accent)) 7%, transparent);
  border: 1px solid color-mix(in srgb, var(--vpk-plan, var(--vpk-accent)) 14%, transparent);
}
.vpk .vpk__card.is-featured .vpk__price-box {
  background: color-mix(in srgb, var(--vpk-plan, var(--vpk-accent)) 13%, transparent);
}

.vpk .vpk__price-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8px;
}
.vpk.is-centered .vpk__price-row { justify-content: center; }

.vpk .vpk__price-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 6px;
  font-size: 12.5px;
}
.vpk.is-centered .vpk__price-meta { justify-content: center; }

.vpk .vpk__cycle {
  padding: 2px 9px;
  border-radius: var(--vpk-r-pill);
  background: color-mix(in srgb, var(--vpk-plan, var(--vpk-accent)) 14%, transparent);
  color: var(--vpk-plan, var(--vpk-accent));
  font-weight: 700;
}

.vpk .vpk__price {
  font-size: 34px;
  font-weight: 900;
  line-height: 1;
  color: var(--vpk-title);
  font-variant-numeric: tabular-nums;
}

/* قلب السعر عند تبديل شهري/سنوي. */
.vpk .vpk__price.is-flipping { animation: vpk-flip .42s ease; }
@keyframes vpk-flip {
  0% { opacity: 1; transform: none; }
  45% { opacity: 0; transform: translateY(-8px); }
  55% { opacity: 0; transform: translateY(8px); }
  100% { opacity: 1; transform: none; }
}

.vpk .vpk__suffix { font-size: 13px; font-weight: 700; opacity: .75; }
.vpk .vpk__old { font-size: 14px; opacity: .55; text-decoration: line-through; }

/* ---------- الميزات: صفوف متساوية بين الباقات ---------- */
.vpk .vpk__features {
  display: grid;
  gap: 9px;
  padding-block: 2px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.vpk .vpk__feature {
  display: flex;
  align-items: flex-start;
  gap: 9px;
  padding-bottom: 9px;
  border-bottom: 1px dashed var(--vpk-line);
  font-size: 13.5px;
  line-height: 1.7;
}
.vpk .vpk__feature:last-child { padding-bottom: 0; border-bottom: 0; }
.vpk.is-centered .vpk__feature { justify-content: center; text-align: center; }

.vpk .vpk__feature i {
  flex: 0 0 auto;
  margin-top: 2px;
  width: 18px;
  height: 18px;
  display: grid;
  place-items: center;
  border-radius: min(var(--vpk-r-inner), 50%);
  background: color-mix(in srgb, var(--vpk-plan, var(--vpk-accent)) 14%, transparent);
  color: var(--vpk-plan, var(--vpk-accent));
  font-size: 11px;
  font-style: normal;
}

.vpk .vpk__feature.is-off { opacity: .55; }
.vpk .vpk__feature.is-off span { text-decoration: line-through; }
.vpk .vpk__feature.is-off i {
  background: color-mix(in srgb, var(--vpk-title) 10%, transparent);
  color: var(--vpk-text);
}

/* الزر في أسفل كل بطاقة، فتستوي الأزرار في صف واحد. */
.vpk .vpk__cta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: auto;
  min-height: 46px;
  padding: 0 18px;
  border-radius: var(--vpk-r-pill);
  background: color-mix(in srgb, var(--vpk-plan, var(--vpk-accent)) 12%, transparent);
  color: var(--vpk-plan, var(--vpk-accent)) !important;
  font-size: 14px;
  font-weight: 800;
  text-decoration: none !important;
  transition: background-color .25s ease, transform .25s ease, gap .25s ease;
}
.vpk .vpk__card.is-featured .vpk__cta {
  background: var(--vpk-plan, var(--vpk-accent));
  color: #ffffff !important;
}
.vpk .vpk__cta:hover { transform: translateY(-2px); gap: 12px; }
.vpk .vpk__cta i { font-size: 12px; transition: transform .25s ease; }
.vpk .vpk__cta:hover i { transform: translateX(-3px); }
html[dir="ltr"] .vpk .vpk__cta:hover i { transform: translateX(3px) rotate(180deg); }
html[dir="ltr"] .vpk .vpk__cta i { transform: rotate(180deg); }

/* ---------- الجوال ----------
   خياران: سحب باليد (شريط أفقي بتثبيت) أو شبكة تحت بعضها. الشريط مبني على
   flex لا grid، والقواعد بـ important لأن ستايل الثيم قد يعيد الشبكة.
   السحب بالإصبع من المتصفح، والسحب بالفأرة من السكربت (معاينة المحرّر). */
@media (max-width: 639px) {
  .vpk.vpk--m-swipe .vpk__grid {
    display: flex !important;
    flex-wrap: nowrap !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    touch-action: pan-x pan-y;
    /* مساحة حول الشريط: الإطار المضيء للبطاقة المميزة والظل لا يُقصّان،
       لأن حاوية التمرير تقصّ ما يخرج عنها. */
    padding-block: 16px 18px;
    padding-inline: 6px;
    margin-inline: -6px;
    scroll-padding-inline-start: 6px;
    cursor: grab;
  }
  .vpk.vpk--m-swipe .vpk__grid::-webkit-scrollbar { display: none; }
  .vpk.vpk--m-swipe .vpk__grid.is-dragging {
    scroll-snap-type: none;
    scroll-behavior: auto;
    cursor: grabbing;
  }
  .vpk.vpk--m-swipe .vpk__card {
    flex: 0 0 86% !important;
    width: 86% !important;
    max-width: none !important;
    scroll-snap-align: start;
  }
  /* أثناء السحب لا تتحرك البطاقات تحت الإصبع. */
  .vpk.vpk--m-swipe .vpk__grid.is-dragging .vpk__card { transition: none; }

  .vpk.vpk--m-grid .vpk__grid { grid-template-columns: minmax(0, 1fr); }

  .vpk.is-inview .vpk__card.is-featured { transform: none; }
}

/* النقاط تخصّ شريط الجوال فقط. */
.vpk .vpk__dots { display: none; }
@media (max-width: 639px) {
  .vpk.vpk--m-swipe .vpk__dots { display: flex; }
}

/* ---------- الوضع الداكن ---------- */
/* ألوان الفاتح مكتوبة inline على القسم، فتُتجاوز هنا بـ important. */
html.dark .vpk, html body.dark .vpk {
  --vpk-title: var(--veloura-dark-primary-text, #ffffff) !important;
  --vpk-text: var(--veloura-dark-secondary-text, #ededed) !important;
  --vpk-line: color-mix(in srgb, var(--veloura-dark-primary-text, #ffffff) 12%, transparent) !important;
}
html.dark .vpk.vpk--dark-cards .vpk__card,
html body.dark .vpk.vpk--dark-cards .vpk__card {
  --vpk-card: var(--veloura-dark-secondary-bg, #010612) !important;
  background: var(--veloura-dark-secondary-bg, #010612);
}
html.dark .vpk .vpk__feature i,
html body.dark .vpk .vpk__feature i {
  color: color-mix(in srgb, var(--vpk-plan, var(--vpk-accent)) 45%, #ffffff);
}
html.dark .vpk .vpk__cycle,
html body.dark .vpk .vpk__cycle {
  background: color-mix(in srgb, var(--vpk-plan, var(--vpk-accent)) 28%, transparent);
  color: color-mix(in srgb, var(--vpk-plan, var(--vpk-accent)) 22%, #ffffff);
}
html.dark .vpk .vpk__price-box,
html body.dark .vpk .vpk__price-box {
  background: color-mix(in srgb, var(--vpk-plan, var(--vpk-accent)) 16%, transparent);
  border-color: color-mix(in srgb, var(--vpk-plan, var(--vpk-accent)) 30%, transparent);
}
/* زر الباقات غير المميزة: لون المتجر يغمق على الداكن، فيُفتح ليبقى مقروءًا. */
html.dark .vpk .vpk__card:not(.is-featured) .vpk__cta,
html body.dark .vpk .vpk__card:not(.is-featured) .vpk__cta {
  background: color-mix(in srgb, var(--vpk-plan, var(--vpk-accent)) 26%, transparent);
  color: color-mix(in srgb, var(--vpk-plan, var(--vpk-accent)) 25%, #ffffff) !important;
}
html.dark .vpk .vpk__billing button:not(.is-on),
html body.dark .vpk .vpk__billing button:not(.is-on) { color: var(--vpk-text); }
html.dark .vpk .vpk__billing button:not(.is-on) .vpk__save,
html body.dark .vpk .vpk__billing button:not(.is-on) .vpk__save {
  color: color-mix(in srgb, var(--vpk-accent) 25%, #ffffff);
}

@media (prefers-reduced-motion: reduce) {
  .vpk .vpk__card,
  .vpk .vpk__badge::after,
  .vpk .vpk__price { animation: none !important; transition: none !important; }
  .vpk .vpk__card { opacity: 1; transform: none; }
}
</style>

  <section data-veloura-home-tab="{{ veloura_home_tab_key|e }}"
    id="veloura-packages-{{ position }}"
    class="{{ vpk_classes }} no-js"
    style="
      --vpk-radius: {{ vpk_radius_px }};
      --vpk-cols: {{ vpk_cols }};
      --vpk-accent: {{ component.vpk_accent|default('#004956') }};
      --vpk-title: {{ component.vpk_title_color|default('#111827') }};
      --vpk-text: {{ component.vpk_text_color|default('#4b5563') }};
      --vpk-card: {{ component.vpk_card_bg|default('#ffffff') }};
    "
  >
    {% if component.vpk_custom_spacing %}
      <div class="vpk__container" style="padding-inline: {{ component.vpk_spacing|default(0) }}px;">
    {% else %}
      <div class="container vpk__container">
    {% endif %}

      {% if component.vpk_title or component.vpk_subtitle %}
        <div class="vpk__heading veloura-component-title" data-veloura-section-heading>
          {% if component.vpk_title %}<h2>{{ component.vpk_title }}</h2>{% endif %}
          {% if component.vpk_subtitle %}<p>{{ component.vpk_subtitle }}</p>{% endif %}
        </div>
      {% endif %}

      {% if vpk_billing %}
        <div class="vpk__billing-wrap">
          <div class="vpk__billing" role="group" aria-label="طريقة الاشتراك">
            <button type="button" class="is-on" data-vpk-cycle="monthly">
              {{ component.vpk_monthly_label|default('شهري') }}
            </button>
            <button type="button" data-vpk-cycle="yearly">
              {{ component.vpk_yearly_label|default('سنوي') }}
              {% if component.vpk_yearly_note %}<span class="vpk__save">{{ component.vpk_yearly_note }}</span>{% endif %}
            </button>
          </div>
        </div>
      {% endif %}

      {% if vpk_items %}
        <div class="vpk__grid" data-vpk-grid>
          {% for plan in vpk_items %}
            {# رابط الزر: حقل الرابط المتعدد (منتج أو تصنيف أو صفحة أو رابط مخصص). #}
            {% set plan_url = plan.plan_url.url|default(plan.plan_url) %}
            {% if plan_url is iterable %}{% set plan_url = '' %}{% endif %}

            <article
              class="vpk__card {{ plan.plan_featured ? 'is-featured' : '' }}"
              style="--i: {{ loop.index0 }};{% if plan.plan_color %} --vpk-plan: {{ plan.plan_color }};{% endif %}"
            >
              {% if plan.plan_badge %}
                <span class="vpk__badge">{{ plan.plan_badge }}</span>
              {% endif %}

              <header class="vpk__head">
                {% if plan.plan_name %}
                  <h3 class="vpk__name">{{ plan.plan_name }}</h3>
                {% endif %}
                {% if plan.plan_desc %}
                  <p class="vpk__desc">{{ plan.plan_desc }}</p>
                {% endif %}
              </header>

              {# صندوق السعر: السعر كبير، وتحته السعر القديم ومدة الدفع. #}
              <div class="vpk__price-box">
                <div class="vpk__price-row">
                  <span
                    class="vpk__price"
                    data-vpk-price
                    data-monthly="{{ plan.plan_price|default('')|e('html_attr') }}"
                    data-yearly="{{ plan.plan_price_yearly|default(plan.plan_price)|default('')|e('html_attr') }}"
                  >{{ plan.plan_price }}</span>

                  {% if plan.plan_suffix %}
                    <span class="vpk__suffix">{{ plan.plan_suffix }}</span>
                  {% endif %}

                  {% if plan.plan_old_price %}
                    <span class="vpk__old">{{ plan.plan_old_price }}</span>
                  {% endif %}
                </div>

                {% if vpk_billing %}
                  <div class="vpk__price-meta">
                    {% if vpk_billing %}
                      <span
                        class="vpk__cycle"
                        data-vpk-note
                        data-monthly="{{ component.vpk_monthly_label|default('شهري')|e('html_attr') }}"
                        data-yearly="{{ component.vpk_yearly_label|default('سنوي')|e('html_attr') }}"
                      >{{ component.vpk_monthly_label|default('شهري') }}</span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>

              {% if plan.plan_features %}
                {# كل سطر ميزة. السطر الذي يبدأ بـ «-» غير مشمول. #}
                <ul class="vpk__features">
                  {% for line in plan.plan_features|split('\n') %}
                    {% set row = line|trim %}
                    {% if row %}
                      {% set off = row starts with '-' %}
                      <li class="vpk__feature {{ off ? 'is-off' : '' }}">
                        <i aria-hidden="true">{{ off ? '✕' : '✓' }}</i>
                        <span>{{ off ? row|slice(1)|trim : row }}</span>
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              {% endif %}

              {% if plan.plan_button %}
                <a class="vpk__cta" href="{{ plan_url ?: '#' }}">
                  {{ plan.plan_button }}
                  <i class="sicon-arrow-left" aria-hidden="true"></i>
                </a>
              {% endif %}
            </article>
          {% endfor %}
        </div>

        {% if vpk_mobile == 'swipe' and vpk_items|length > 1 %}
          {# نقاط التنقل الموحّدة للمتجر — تظهر على الجوال فقط. #}
          <div class="veloura-dots vpk__dots" data-vpk-dots></div>
        {% endif %}
      {% endif %}

    </div>
  </section>

  <script>
  (function () {
    var section = document.getElementById('veloura-packages-{{ position }}');
    if (!section) return;
    section.classList.remove('no-js');

    /* ظهور متدرّج للبطاقات عند وصول القسم. */
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-inview');
          io.unobserve(e.target);
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
      io.observe(section);
    } else {
      section.classList.add('is-inview');
    }

    /* ---------- شريط الجوال: سحب بالفأرة + نقاط ----------
       الإصبع يمرّر الشريط من المتصفح نفسه، أما الفأرة (وهي حالة معاينة
       المحرّر) فلا تمرّر حاوية تمرير، فنترجم السحب إلى تمرير هنا. */
    var grid = section.querySelector('[data-vpk-grid]');
    var dotsBox = section.querySelector('[data-vpk-dots]');
    var cards = grid ? [].slice.call(grid.querySelectorAll('.vpk__card')) : [];

    function swipeMode() {
      return section.classList.contains('vpk--m-swipe') &&
        window.matchMedia('(max-width: 639px)').matches;
    }

    if (grid && cards.length > 1) {
      var down = false, moved = false, startX = 0, startScroll = 0;

      grid.addEventListener('pointerdown', function (e) {
        if (e.pointerType !== 'mouse' || !swipeMode()) return;
        down = true; moved = false;
        startX = e.clientX;
        startScroll = grid.scrollLeft;
        grid.classList.add('is-dragging');
      });

      grid.addEventListener('pointermove', function (e) {
        if (!down) return;
        var dx = e.clientX - startX;
        if (Math.abs(dx) > 4) moved = true;
        grid.scrollLeft = startScroll - dx;
        e.preventDefault();
      });

      function release() {
        if (!down) return;
        down = false;
        grid.classList.remove('is-dragging');
        /* إعادة التثبيت: تمرير بمقدار صفر يجعل المتصفح يثبّت على أقرب بطاقة. */
        grid.scrollBy({ left: 0, behavior: 'smooth' });
        sync();
      }
      grid.addEventListener('pointerup', release);
      grid.addEventListener('pointercancel', release);
      grid.addEventListener('pointerleave', release);

      /* بعد سحب فعلي لا يُفتح رابط الزر. */
      grid.addEventListener('click', function (e) {
        if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; }
      }, true);

      grid.addEventListener('dragstart', function (e) { e.preventDefault(); });
    }

    var dots = [];
    if (dotsBox && cards.length > 1) {
      cards.forEach(function (card, i) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'veloura-dots__dot';
        b.setAttribute('aria-label', 'الباقة ' + (i + 1));
        b.addEventListener('click', function () {
          card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
        });
        dotsBox.appendChild(b);
        dots.push(b);
      });
    }

    function nearest() {
      var r = grid.getBoundingClientRect();
      var mid = (r.left + r.right) / 2, best = 0, bd = Infinity;
      cards.forEach(function (c, i) {
        var cr = c.getBoundingClientRect();
        var d = Math.abs((cr.left + cr.right) / 2 - mid);
        if (d < bd) { bd = d; best = i; }
      });
      return best;
    }

    function sync() {
      if (!dots.length) return;
      var k = nearest();
      dots.forEach(function (d, i) { d.classList.toggle('is-on', i === k); });
    }

    if (grid && dots.length) {
      var raf = null;
      grid.addEventListener('scroll', function () {
        if (raf) return;
        raf = requestAnimationFrame(function () { raf = null; sync(); });
      }, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    }

    /* مبدّل شهري / سنوي: يقلب الأسعار مع حركة قصيرة. */
    var buttons = section.querySelectorAll('[data-vpk-cycle]');
    if (!buttons.length) return;

    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var cycle = btn.getAttribute('data-vpk-cycle');
        buttons.forEach(function (b) { b.classList.toggle('is-on', b === btn); });

        section.querySelectorAll('[data-vpk-note]').forEach(function (el) {
          el.textContent = el.getAttribute('data-' + cycle) || el.textContent;
        });

        section.querySelectorAll('[data-vpk-price]').forEach(function (el) {
          var next = el.getAttribute('data-' + cycle) || '';
          if (next === el.textContent.trim()) return;
          el.classList.remove('is-flipping');
          void el.offsetWidth;
          el.classList.add('is-flipping');
          setTimeout(function () { el.textContent = next; }, 190);
        });
      });
    });
  })();
  </script>

{% endif %}