{% set popup_id = 'veloura-category-popup-' ~ position %}
{% set popup_tab = component.veloura_home_tab_name_2026.value ?? component.veloura_home_tab_name_2026 ?? 'always' %}
<section id="{{ popup_id }}" class="s-block vcp" data-veloura-home-tab="{{ popup_tab ?: 'always' }}"
  data-popup-key="{{ component.popup_key.value ?? component.popup_key ?? position }}"
  data-store-url="{{ store.url|default('/')|e('html_attr') }}"
  data-mobile-columns="{{ component.mobile_columns|json_encode|e('html_attr') }}" data-desktop-columns="{{ component.desktop_columns|json_encode|e('html_attr') }}">
  <dialog class="vcp__dialog" id="{{ popup_id }}-dialog" aria-labelledby="{{ popup_id }}-title">
    <header class="vcp__header"><h2 id="{{ popup_id }}-title">{{ component.title ?: 'التصنيفات' }}</h2><button type="button" data-vcp-close aria-label="إغلاق">×</button></header>
    <div class="vcp__grid">
      {% for item in component.items %}
        {% set item_image = item.image.url ?: item.image %}
        <a class="vcp__card" data-link="{{ item.url|json_encode|e('html_attr') }}">
          {% if item_image %}<img src="{{ item_image|e('html_attr') }}" alt="" width="160" height="160" loading="lazy" decoding="async">
          {% else %}<i class="{{ item.icon.value ?: item.icon ?: 'sicon-grid' }}" aria-hidden="true"></i>{% endif %}
          <span data-category-name>عرض التصنيف</span>
        </a>
      {% else %}<p>أضف التصنيفات من إعدادات هذا العنصر.</p>{% endfor %}
    </div>
  </dialog>
</section>
<style>
.vcp { margin:0!important; padding:0!important; min-height:0!important; --vcp-text:#1f2937; --vcp-bg:var(--veloura-site-second-bg,#fff); }
html.dark .vcp, body.dark .vcp { margin:0!important; padding:0!important; min-height:0!important; --vcp-text:var(--veloura-dark-primary-text,#fff); --vcp-bg:var(--veloura-dark-secondary-bg,#161b22); }
html body .vcp__dialog { position:fixed; inset:0; margin:auto; box-sizing:border-box; width:min(800px,calc(100% - 32px)); max-width:none; max-height:calc(100dvh - 48px); height:fit-content; padding:22px; overflow:auto; overscroll-behavior:contain; border:1px solid color-mix(in srgb,var(--vcp-text) 16%,transparent); border-radius:var(--veloura-global-radius,16px); background:var(--vcp-bg); color:var(--vcp-text); }
.vcp__dialog::backdrop { background:rgba(0,0,0,.45); }
body.veloura-general-enabled.veloura-glass-effect:not(.veloura-no-glass) .vcp__dialog { background:var(--veloura-global-glass-bg,var(--veloura-glass-surface,var(--vcp-bg))); backdrop-filter:var(--veloura-global-glass-filter,var(--veloura-glass-filter)); -webkit-backdrop-filter:var(--veloura-global-glass-filter,var(--veloura-glass-filter)); }
.vcp__header { display:flex; align-items:center; justify-content:space-between; gap:16px; padding-bottom:16px; margin-bottom:18px; border-bottom:1px solid color-mix(in srgb,var(--vcp-text) 16%,transparent); }
.vcp__header h2 { margin:0; font-size:22px; color:inherit; }
.vcp__header button { width:40px; height:40px; flex-shrink:0; border:1px solid color-mix(in srgb,var(--vcp-text) 20%,transparent); border-radius:var(--veloura-global-radius,16px); background:transparent; color:inherit; font-size:28px; cursor:pointer; }
.vcp__grid { display:grid; grid-template-columns:repeat(var(--vcp-cols,4),minmax(0,1fr)); gap:14px; }
.vcp__card { display:flex; flex-direction:column; align-items:center; gap:10px; min-width:0; padding:0; color:var(--vcp-text); text-decoration:none; text-align:center; overflow-wrap:anywhere; border:0!important; background:transparent; }
.vcp__card img { width:100%; height:auto; aspect-ratio:1; object-fit:contain; border-radius:var(--veloura-global-radius,16px); }
.vcp__card i { display:grid; place-items:center; min-height:72px; font-size:36px; color:var(--color-primary); }
.vcp :focus-visible { outline:2px solid var(--color-primary); outline-offset:3px; }
@media(max-width:767px){.vcp__grid{grid-template-columns:repeat(var(--vcp-mobile-cols,2),minmax(0,1fr))}.vcp__dialog{padding:18px}}
</style>
<script>
(() => {
  const root=document.getElementById('{{ popup_id }}');
  if(!root||root.dataset.ready)return;
  root.dataset.ready='true';
  const scalar=v=>Array.isArray(v)?scalar(v[0]):v&&typeof v==='object'?scalar(v.url||v.href||v.value||v.selected||v.id||v.id_):v;
  const parse=text=>{try{return JSON.parse(text)}catch(_){return text}};
  const columns=(v,fallback,max)=>Math.min(max,Math.max(1,Math.round(Number(scalar(parse(v)))||fallback)));
  root.style.setProperty('--vcp-mobile-cols',columns(root.dataset.mobileColumns,2,6));
  root.style.setProperty('--vcp-cols',columns(root.dataset.desktopColumns,4,8));
  const normalizeName=text=>String(text||'').normalize('NFC').trim().replace(/\s+/g,' ').toLocaleLowerCase();
  root.dataset.vcpName=normalizeName(root.dataset.popupKey);
  root.dataset.vcpLink='#category-popup-'+(root.dataset.popupKey||root.id).trim().replace(/[^a-zA-Z0-9_-]/g,'');

  if(!window.__velouraCategoryPopupNamedLinks){
    window.__velouraCategoryPopupNamedLinks=true;
    window.addEventListener('click',event=>{
      if(event.button!==0||event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;
      const link=event.composedPath().find(node=>node.matches?.('[data-vcp-target],a[href],salla-button[href]'));
      if(!link)return;
      if(link.hasAttribute('data-vcp-target')){
        const name=normalizeName(link.dataset.vcpTarget);
        const target=Array.from(document.querySelectorAll('.vcp[data-vcp-name]')).find(node=>node.dataset.vcpName===name);
        event.preventDefault();event.stopImmediatePropagation();
        if(target)target.dispatchEvent(new CustomEvent('vcp:open',{detail:{opener:link}}));
        return;
      }
      let url;try{url=new URL(link.getAttribute('href'),location.href)}catch(_){return;}
      if(url.origin!==location.origin||url.pathname!==location.pathname||url.search!==location.search)return;
      const target=Array.from(document.querySelectorAll('.vcp[data-vcp-link]')).find(node=>node.dataset.vcpLink===url.hash);
      if(!target)return;
      event.preventDefault();event.stopImmediatePropagation();
      target.dispatchEvent(new CustomEvent('vcp:open',{detail:{opener:link}}));
    },true);
  }
  root.querySelectorAll('[data-link]').forEach(link=>{
    try{let raw=scalar(parse(link.dataset.link));if(!raw)throw Error();if(/^\d+$/.test(String(raw)))raw=root.dataset.storeUrl.replace(/\/$/,'')+'/c'+raw;const url=new URL(raw,location.href);if(!['http:','https:'].includes(url.protocol))throw Error();link.href=url.href;}
    catch(_){link.setAttribute('aria-disabled','true');}
  });
  const cards=Array.from(root.querySelectorAll('[data-link]'));
  const categoryId=value=>{
    const raw=String(scalar(value)||'');
    return /^\d+$/.test(raw)?raw:(raw.match(/\/c(\d+)(?:[/?#]|$)/)||[])[1];
  };
  const setName=(card,name)=>{
    if(typeof name!=='string'||!name.trim())return;
    card.querySelector('[data-category-name]').textContent=name.trim();
    card.dataset.named='true';
  };
  cards.forEach(card=>{
    let selected=parse(card.dataset.link);if(Array.isArray(selected))selected=selected[0];
    if(selected&&typeof selected==='object')setName(card,selected.name||selected.label);
  });
  async function loadNames(){
    if(cards.every(card=>card.dataset.named))return;
    const api=window.salla?.product?.api;
    if(!api?.categories)return;
    try{
      if(!window.__velouraPopupCategories){
        window.__velouraPopupCategories=Promise.resolve().then(()=>api.categories()).then(response=>{
          const index=new Map();
          const visit=items=>{if(!Array.isArray(items))return;items.forEach(item=>{
            index.set(String(item.id_||item.id),item.name||item.title);
            visit(item.sub_categories);visit(item.children);
          });};
          visit(response.data);return index;
        }).catch(error=>{window.__velouraPopupCategories=null;throw error;});
      }
      const names=await window.__velouraPopupCategories;
      cards.forEach(card=>setName(card,names.get(categoryId(parse(card.dataset.link)))));
    }catch(_){/* Keep links usable and retry names on the next opening. */}
  }
  const dialog=root.querySelector('dialog');
  let previousOverflow='',removalObserver,opener=null;
  function close(){if(dialog.open)dialog.close();}
  function open(source){
    if(dialog.open)return;
    opener=source||null;
    loadNames();
    document.querySelectorAll('.vcp__dialog[open]').forEach(other=>other.close());
    previousOverflow=document.body.style.overflow;
    dialog.showModal();document.body.style.overflow='hidden';opener?.setAttribute('aria-expanded','true');
    window.velouraThemeMotion?.enter([dialog],false);
    window.velouraThemeMotion?.enter(dialog.querySelectorAll('.vcp__card'),true);
    removalObserver=new MutationObserver(()=>{if(!root.isConnected){close();document.body.style.overflow=previousOverflow;removalObserver.disconnect();}});
    removalObserver.observe(document.body,{childList:true,subtree:true});
  }
  root.addEventListener('vcp:open',event=>open(event.detail?.opener));
  dialog.querySelector('[data-vcp-close]').addEventListener('click',close);
  dialog.addEventListener('click',event=>{if(event.target!==dialog)return;const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)close();});
  dialog.addEventListener('close',()=>{removalObserver?.disconnect();document.body.style.overflow=previousOverflow;opener?.setAttribute('aria-expanded','false');if(opener?.isConnected)opener.focus({preventScroll:true});});
})();
</script>
