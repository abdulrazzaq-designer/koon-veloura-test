{# VELOURA HOME TAB ASSIGNMENT START #}
{% set veloura_home_tab_key = component.veloura_home_tab_name_2026|default('') %}
{% if veloura_home_tab_key.value is defined %}{% set veloura_home_tab_key = veloura_home_tab_key.value %}{% endif %}
{% if not veloura_home_tab_key %}{% set veloura_home_tab_key = 'always' %}{% endif %}
{# VELOURA HOME TAB ASSIGNMENT END #}

{# ==========================================================================
   فاصل (فيلورا)

   الارتفاع يُكتب رقماً صريحاً في قاعدة تخص هذا الفاصل وحده (بمعرّفه)، لا
   عبر متغيّر CSS ولا اعتماداً على ملف الستايل المبني:

   • ملف الستايل يمر ببناء ورفع على CDN، وأي متجر نسخته أقدم من القالب لا
     يجد قاعدة .veloura-spacer أصلاً فيبقى القسم بلا ارتفاع.
   • المتغيّر يمكن أن يُعاد تعريفه على عنصر أقرب فيبتلع القيمة.
   • ومعرّف العنصر مع important يعلو على أي قاعدة أخرى في الصفحة.

   ولو بقي الفاصل بلا تأثير، فالسمة data-veloura-spacer تطبع الأرقام الواصلة
   فعلاً (جوال/تابلت/لابتوب) — وهي تحسم إن كانت المشكلة في وصول القيمة أم في
   تطبيقها.
   ========================================================================== #}

{# القيم تصل أحياناً ملفوفة في كائن ({value: 40}) لا كرقم مجرّد. #}
{% set sp_m = component.veloura_spacer_mobile %}
{% if sp_m.value is defined %}{% set sp_m = sp_m.value %}{% endif %}
{% if sp_m.selected is defined %}{% set sp_m = sp_m.selected %}{% endif %}
{% if sp_m is iterable %}{% set sp_m = sp_m|first %}{% endif %}
{% if sp_m.value is defined %}{% set sp_m = sp_m.value %}{% endif %}
{% if sp_m is iterable or sp_m ~ '' == '' %}{% set sp_m = 60 %}{% endif %}

{% set sp_d = component.veloura_spacer_desktop %}
{% if sp_d.value is defined %}{% set sp_d = sp_d.value %}{% endif %}
{% if sp_d.selected is defined %}{% set sp_d = sp_d.selected %}{% endif %}
{% if sp_d is iterable %}{% set sp_d = sp_d|first %}{% endif %}
{% if sp_d.value is defined %}{% set sp_d = sp_d.value %}{% endif %}
{% if sp_d is iterable or sp_d ~ '' == '' %}{% set sp_d = 60 %}{% endif %}

{% set sp_t = component.veloura_spacer_tablet %}
{% if sp_t.value is defined %}{% set sp_t = sp_t.value %}{% endif %}
{% if sp_t.selected is defined %}{% set sp_t = sp_t.selected %}{% endif %}
{% if sp_t is iterable %}{% set sp_t = sp_t|first %}{% endif %}
{% if sp_t.value is defined %}{% set sp_t = sp_t.value %}{% endif %}
{% if sp_t is iterable or sp_t ~ '' == '' %}{% set sp_t = 60 %}{% endif %}

{# مفتاح التابلت قد يصل ككائن، والكائن «صحيح» دائماً في الشرط. #}
{% set sp_tablet_on = component.veloura_spacer_enable_tablet %}
{% if sp_tablet_on.value is defined %}{% set sp_tablet_on = sp_tablet_on.value %}{% endif %}
{% if sp_tablet_on.selected is defined %}{% set sp_tablet_on = sp_tablet_on.selected %}{% endif %}
{% if sp_tablet_on is iterable %}{% set sp_tablet_on = sp_tablet_on|first %}{% endif %}
{% if sp_tablet_on.value is defined %}{% set sp_tablet_on = sp_tablet_on.value %}{% endif %}
{% set sp_tablet_on = sp_tablet_on == true or sp_tablet_on == 1 or sp_tablet_on == '1' or sp_tablet_on == 'true' or sp_tablet_on == 'on' %}

{% if not sp_tablet_on %}{% set sp_t = sp_d %}{% endif %}

{# الأرقام قد تصل كنصوص، والمقارنة تحتاجها أعداداً. #}
{% set sp_m = sp_m + 0 %}
{% set sp_t = sp_t + 0 %}
{% set sp_d = sp_d + 0 %}

{# القيمة السالبة لا تُكتب ارتفاعاً: الارتفاع السالب غير موجود في CSS فيُهمل
   السطر كله، وهذا سبب «السالب بلا تأثير». السالب دمج لا مسافة — فيُكتب
   هامشاً سفلياً سالباً يسحب القسم التالي فوق السابق، والارتفاع يصير صفراً. #}
{% set sp_m_h = sp_m > 0 ? sp_m : 0 %}{% set sp_m_pull = sp_m < 0 ? sp_m : 0 %}
{% set sp_t_h = sp_t > 0 ? sp_t : 0 %}{% set sp_t_pull = sp_t < 0 ? sp_t : 0 %}
{% set sp_d_h = sp_d > 0 ? sp_d : 0 %}{% set sp_d_pull = sp_d < 0 ? sp_d : 0 %}

{# أيّ القسمين يعلو الآخر عند الاندماج. #}
{% set sp_order = component.veloura_spacer_overlap_order %}
{% if sp_order.selected is defined %}{% set sp_order = sp_order.selected %}{% endif %}
{% if sp_order is iterable and sp_order.value is not defined %}{% set sp_order = sp_order|first %}{% endif %}
{% if sp_order.value is defined %}{% set sp_order = sp_order.value %}{% endif %}
{% if sp_order not in ['below', 'above'] %}{% set sp_order = 'below' %}{% endif %}

{% set sp_pulls = sp_m_pull < 0 or sp_t_pull < 0 or sp_d_pull < 0 %}

{% set sp_id = 'veloura-spacer-' ~ position %}

<style>
  #{{ sp_id }} {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    padding: 0 !important;
    border: 0 !important;
    background: transparent !important;
    min-height: 0 !important;
    flex: 0 0 auto !important;
    height: {{ sp_m_h }}px !important;
    margin: 0 0 var(--veloura-spacer-safe-pull, 0px) !important;
    /* مع السحب يجب ألا يقص القسمَ الصاعد فوقه. */
    overflow: {{ sp_m_pull < 0 ? 'visible' : 'hidden' }} !important;
    position: relative;
    z-index: 0;
  }

  @media (min-width: 768px) {
    #{{ sp_id }} {
      height: {{ sp_t_h }}px !important;
      margin: 0 0 var(--veloura-spacer-safe-pull, 0px) !important;
      overflow: {{ sp_t_pull < 0 ? 'visible' : 'hidden' }} !important;
    }
  }

  @media (min-width: 1024px) {
    #{{ sp_id }} {
      height: {{ sp_d_h }}px !important;
      margin: 0 0 var(--veloura-spacer-safe-pull, 0px) !important;
      overflow: {{ sp_d_pull < 0 ? 'visible' : 'hidden' }} !important;
    }
  }

</style>

<section
  id="{{ sp_id }}"
  data-veloura-home-tab="{{ veloura_home_tab_key|e }}"
  data-veloura-spacer="{{ sp_m }}/{{ sp_t }}/{{ sp_d }}"
  class="s-block veloura-spacer {{ component.veloura_spacer_custom_classes }}"
  aria-hidden="true"
></section>

{% if sp_pulls %}
<script>
/* ترتيب الطبقات عند الاندماج.

   في التدفّق الطبيعي يرسم المتصفح العنصر المتأخر فوق المتقدّم، فالقسم
   الصاعد يغطي ما قبله ويحجبه — وهذا ما يبدو كخطأ في z-index.

   ولا يصلح اختيار الجارين بـ CSS هنا: القالب يطبع وسم <style> قبل القسم،
   فيصير هو «الجار السابق» في المستند لا القسم الحقيقي. لذلك يُبحث عن الجار
   الحقيقي هنا مع تخطّي الوسوم غير المرئية. */
(function () {
  var el = document.getElementById('{{ sp_id }}');
  if (!el) return;

  var SKIP = { STYLE: 1, SCRIPT: 1, LINK: 1, TEMPLATE: 1, META: 1 };

  function sibling(node, dir) {
    var n = node[dir];
    while (n) {
      if (n.nodeType === 1 && !SKIP[n.tagName]) return n;
      n = n[dir];
    }
    return null;
  }

  function layer(node, z) {
    if (!node) return '-';

    /* لا نلمس عنصراً له تموضع خاص (لاصق مثلاً) حتى لا نكسره. */
    if (getComputedStyle(node).position === 'static') node.style.position = 'relative';

    node.style.zIndex = z;

    /* الأهم: جعل القسم طبقة واحدة مغلقة.

       أقسام مثل الهيرو تعطي محتواها الداخلي z-index خاصاً به (الغلاف 1
       والخلفية -2). وما لم يكن القسم نفسه سياقَ تكديس، ينفلت ذلك المحتوى
       ويرتفع فوق القسم المجاور بينما تبقى خلفيته تحته — وهو بالضبط ما يبدو
       كأن «محتوى البنر في طبقة أعلى من الجميع». isolate يغلق السياق فيتحرك
       القسم ككتلة واحدة. */
    node.style.isolation = 'isolate';

    return (node.tagName + '.' + (node.className || '').toString().trim().split(/\s+/)[0] + ':' + z);
  }

  var observedPrevious;
  var sizeObserver = typeof ResizeObserver !== 'undefined' ? new ResizeObserver(function () { requestAnimationFrame(run); }) : null;
  function run() {
    var previous = sibling(el, 'previousElementSibling');
    var requested = window.innerWidth >= 1024 ? {{ sp_d_pull }} : window.innerWidth >= 768 ? {{ sp_t_pull }} : {{ sp_m_pull }};
    var available = previous ? Math.max(0, previous.getBoundingClientRect().height - 16) : 0;
    var pull = Math.max(requested, -available) + 'px';
    if (el.style.getPropertyValue('--veloura-spacer-safe-pull') !== pull) el.style.setProperty('--veloura-spacer-safe-pull', pull);
    if (previous && previous !== observedPrevious && sizeObserver) {
      sizeObserver.disconnect(); sizeObserver.observe(previous); observedPrevious = previous;
    }

    var a = layer(sibling(el, 'previousElementSibling'), '{{ sp_order == 'below' ? 2 : 1 }}');
    var b = layer(sibling(el, 'nextElementSibling'), '{{ sp_order == 'below' ? 1 : 2 }}');
    /* أثر مرئي للتحقق: أي قسمين طُبّق عليهما وبأي ترتيب. */
    el.setAttribute('data-veloura-layers', a + ' | ' + b);
  }

  /* السكربت يعمل أثناء التحليل، والقسم التالي لم يُقرأ بعد — فيُؤجَّل حتى
     تكتمل الصفحة، مع تمريرتين قصيرتين لالتقاط ما يُضاف متأخراً. */
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
  else run();

  window.addEventListener('resize', run);
  window.addEventListener('load', run, {once:true});
  setTimeout(run, 300);
  setTimeout(run, 1200);
})();
</script>
{% endif %}