{# VELOURA HOME TAB ASSIGNMENT START #}
{% set veloura_home_tab_key = component.veloura_home_tab_name_2026|default('') %}
{% if veloura_home_tab_key.value is defined %}{% set veloura_home_tab_key = veloura_home_tab_key.value %}{% endif %}
{% if not veloura_home_tab_key %}{% set veloura_home_tab_key = 'always' %}{% endif %}
{# VELOURA HOME TAB ASSIGNMENT END #}

{% if not component.veloura_testimonials_hide %}

  {% set radius_map = {
    'sharp': '0px',
    'soft': '8px',
    'medium': '16px',
    'large': '28px',
    'round': '999px',
    '40': '999px'
  } %}

  {% set testimonial_radius = radius_map[component.veloura_testimonials_radius|default('medium')]|default((component.veloura_testimonials_radius|default('medium') ~ '' == '' ? '16' : component.veloura_testimonials_radius|default('medium')) ~ 'px') %}

  {% set t_loop = component.veloura_testimonials_infinite ? true : false %}
  {% set t_peek = component.veloura_testimonials_peek ? true : false %}
  {% set t_bar = component.veloura_testimonials_show_scrollbar ? true : false %}

  {# لا نهائي بدون تقطيع: سوايبر يحتاج عدداً كافياً من الشرائح ليكرر بسلاسة،
     ومع ثلاثة آراء وشريحتين في الشاشة كان يقفز ويكرر قطعاً. نكرر القائمة
     هنا حتى 8 شرائح على الأقل. #}
  {% set t_src = component.veloura_testimonials_items|default([]) %}
  {% set t_items = t_src %}
  {% if t_loop and t_src|length > 0 and t_src|length < 8 %}
    {% set t_items = [] %}
    {% for r in 1..((8 / t_src|length)|round(0, 'ceil')) %}
      {% set t_items = t_items|merge(t_src) %}
    {% endfor %}
  {% endif %}

<style>
/* ---------- قالوا عنا ----------
   داخل الكونتينر تماماً: الفجوة حشوة داخل كل شريحة، والشريط ممدود بنصف
   فجوة من كل جهة ثم يُقص عند حدود الكونتينر (clip-path)، والقص مفتوح من
   الأعلى لصورة العميل على الجوال ومن الأسفل لشريط التمرير أو النقاط. */
.veloura-testimonials { --t-gap: 16px; }
@media (min-width: 768px) { .veloura-testimonials { --t-gap: 24px; } }

.veloura-testimonials .veloura-testimonials__slider {
  display: block !important;
  overflow: visible !important;
  margin: 0 !important;
  padding-bottom: 0 !important;
}
.veloura-testimonials .veloura-testimonials__slider.has-nav { padding-bottom: 0 !important; }

.veloura-testimonials .veloura-testimonials__slider .s-slider-wrapper,
.veloura-testimonials .veloura-testimonials__slider .s-slider-block {
  padding: 0 !important;
  margin: 0 !important;
  overflow: visible !important;
}

.veloura-testimonials .veloura-testimonials__slider .swiper,
.veloura-testimonials .veloura-testimonials__slider.carousel-slider .swiper {
  width: auto !important;
  max-width: none !important;
  padding: 0 !important;
  margin-left: calc(var(--t-gap) / -2) !important;
  margin-right: calc(var(--t-gap) / -2) !important;
  overflow: visible !important;
  clip-path: inset(-100px calc(var(--t-gap) / 2) -60px calc(var(--t-gap) / 2));
}

.veloura-testimonials .veloura-testimonials__slider.has-nav .swiper {
  padding-bottom: 34px !important;
}

.veloura-testimonials .veloura-testimonials__slider .swiper-wrapper > .swiper-slide,
.veloura-testimonials .veloura-testimonials__slider.carousel-slider .swiper-wrapper > div {
  padding-left: calc(var(--t-gap) / 2) !important;
  padding-right: calc(var(--t-gap) / 2) !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
  box-sizing: border-box !important;
}

/* بدون ظل. */
.veloura-testimonials .veloura-testimonials__card { box-shadow: none !important; }

/* شريط التمرير: تحت البطاقات، بعرض الكونتينر، وقابل للسحب. */
.veloura-testimonials .veloura-testimonials__slider .swiper-scrollbar {
  display: block !important;
  position: absolute !important;
  top: auto !important;
  bottom: 8px !important;
  left: calc(var(--t-gap) / 2) !important;
  right: auto !important;
  width: calc(100% - var(--t-gap)) !important;
  height: 5px !important;
  border-radius: 999px;
  background: color-mix(in srgb, var(--veloura-testimonials-text, #323232) 12%, transparent) !important;
  opacity: 1 !important;
  z-index: 5;
  cursor: grab;
}
.veloura-testimonials .veloura-testimonials__slider .swiper-scrollbar-drag {
  border-radius: 999px;
  background: var(--color-primary, #004956) !important;
}
.veloura-testimonials .veloura-testimonials__slider:not(.has-bar) .swiper-scrollbar { display: none !important; }

.veloura-testimonials .veloura-testimonials__slider :is(.swiper-pagination, .s-slider-pagination) {
  position: absolute !important;
  top: auto !important;
  bottom: 6px !important;
  left: 0 !important;
  right: 0 !important;
  transform: none !important;
  width: 100% !important;
  display: flex !important;
  justify-content: center;
  gap: 6px;
}
.veloura-testimonials .veloura-testimonials__slider.has-bar :is(.swiper-pagination, .s-slider-pagination) { display: none !important; }

@media (max-width: 767px) {
  .veloura-testimonials .veloura-testimonials__slider { padding-top: 75px !important; }
}
</style>

  {% set section_classes = [
    's-block',
    'veloura-testimonials',
    component.veloura_testimonials_two_rows ? 'veloura-testimonials--two-rows' : '',
    component.veloura_testimonials_infinite ? 'veloura-testimonials--infinite' : '',
    component.veloura_testimonials_show_scrollbar ? 'veloura-testimonials--scrollbar' : '',
    component.veloura_testimonials_mobile_only ? 'veloura-testimonials--mobile-only' : '',
    component.veloura_testimonials_desktop_only ? 'veloura-testimonials--desktop-only' : '',
    component.veloura_testimonials_hide_arrows_desktop ? 'veloura-testimonials--hide-arrows-desktop' : '',
    component.veloura_testimonials_custom_spacing ? 'has-spacing' : '',
    component.veloura_testimonials_custom_classes ?: ''
  ]|join(' ') %}

  <section data-veloura-home-tab="{{ veloura_home_tab_key|e }}"
    class="{{ section_classes }}"
    style="
      --veloura-testimonials-radius: {{ testimonial_radius }};
      --veloura-testimonials-spacing: {{ component.veloura_testimonials_custom_spacing ? component.veloura_testimonials_spacing|default(0) : 0 }}px;
      --veloura-testimonials-title-color: {{ component.veloura_testimonials_title_color|default('#383838') }};
      --veloura-testimonials-bg: {{ component.veloura_testimonials_bg_color|default('#eeeeee') }};
      --veloura-testimonials-text: {{ component.veloura_testimonials_text_color|default('#323232') }};
    "
  >

    {% if component.veloura_testimonials_custom_spacing %}
      <div class="veloura-testimonials__container">
    {% else %}
      <div class="container veloura-testimonials__container">
    {% endif %}

      {% if component.veloura_testimonials_title or component.veloura_testimonials_subtitle %}
        <div class="veloura-testimonials__heading veloura-component-title" data-veloura-section-heading>
          {% if component.veloura_testimonials_title %}
            <h2>{{ component.veloura_testimonials_title }}</h2>
          {% endif %}

          {% if component.veloura_testimonials_subtitle %}
            <p>{{ component.veloura_testimonials_subtitle }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if component.veloura_testimonials_items|length %}
        <salla-slider
          id="veloura-testimonials-{{ position }}"
          class="veloura-testimonials__slider has-nav {{ t_bar ? 'has-bar' : '' }}"
          type="carousel"
          {% if not t_bar %}pagination{% endif %}
          show-controls="{{ component.veloura_testimonials_hide_arrows ? 'false' : 'true' }}"
          {% if component.veloura_testimonials_autoplay %}auto-play{% endif %}
          slider-config='{
            "slidesPerView": {{ t_peek ? 1.25 : 1 }},
            "spaceBetween": 0,
            "speed": 700,
            "loop": {{ t_loop ? "true" : "false" }},
            {% if t_loop %}"loopAdditionalSlides": 2,{% endif %}
            "watchOverflow": true,
            {% if t_bar %}
            "createElements": true,
            "scrollbar": { "auto": true, "enabled": true, "draggable": true, "hide": false, "snapOnRelease": true },
            {% endif %}
            "allowTouchMove": true,
            {% if component.veloura_testimonials_autoplay %}
            "autoplay": {
              "delay": 2500,
              "disableOnInteraction": false,
              "pauseOnMouseEnter": true
            },
            {% else %}
            "autoplay": false,
            {% endif %}
            "breakpoints": {
              "768": {
                "slidesPerView": {{ t_peek ? 2.3 : 2 }},
                "spaceBetween": 0
              },
              "1024": {
                "slidesPerView": {{ t_peek ? 2.3 : 2 }},
                "spaceBetween": 0
              }
            }
          }'
        >

          <div slot="items">

            {% for item in t_items %}

              {% set stars_value = item.stars|default(5) %}
              {% if item.stars is iterable and item.stars[0].value is defined %}
                {% set stars_value = item.stars[0].value %}
              {% endif %}

              {% set customer_image = item.image.url|default(item.image) %}

              <div class="swiper-slide">
                <article class="veloura-testimonials__card">

                  <div class="veloura-testimonials__content">

                    {% if item.text %}
                      <p class="veloura-testimonials__text">{{ item.text }}</p>
                    {% endif %}

                    <div class="veloura-testimonials__bottom">

                      <div class="veloura-testimonials__stars">
                        {% for i in 1..5 %}
                          <i class="{{ i <= stars_value ? 'sicon-star2' : 'sicon-star' }}"></i>
                        {% endfor %}
                      </div>

                      <div class="veloura-testimonials__info">
                        {% if item.name %}
                          <h3>{{ item.name }}</h3>
                        {% endif %}

                        {% if item.city %}
                          <span>{{ item.city }}</span>
                        {% endif %}
                      </div>

                    </div>

                  </div>

                  {% if not item.hide_image and customer_image %}
                    <div class="veloura-testimonials__avatar">
                      <img src="{{ customer_image }}" alt="{{ item.name|default('customer') }}" loading="lazy">
                    </div>
                  {% endif %}

                </article>
              </div>

            {% endfor %}

          </div>
        </salla-slider>
      {% endif %}

    </div>
  </section>

{% endif %}