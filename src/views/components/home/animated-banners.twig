{# VELOURA HOME TAB ASSIGNMENT START #}
{% set veloura_home_tab_key = component.veloura_home_tab_name_2026|default('') %}
{% if veloura_home_tab_key.value is defined %}{% set veloura_home_tab_key = veloura_home_tab_key.value %}{% endif %}
{% if not veloura_home_tab_key %}{% set veloura_home_tab_key = 'always' %}{% endif %}
{# VELOURA HOME TAB ASSIGNMENT END #}

{% set radius_map = {
  'sharp': '0px',
  'soft': '8px',
  'medium': '16px',
  'large': '28px',
  'round': '999px',
  '40': '999px'
} %}

{% set h_spacing = component.h_spacing|default(0) %}
{% set h_spacing = h_spacing + 0 %}
{% if h_spacing < 0 %}{% set h_spacing = 0 %}{% endif %}
{% if h_spacing > 100 %}{% set h_spacing = 100 %}{% endif %}

{% set effect = component.animated_transition_type|default('slide') %}
{% set safe_effect = effect == 'cards' ? 'slide' : effect %}
{% set animated_radius = radius_map[component.animated_image_radius|default('sharp')]|default((component.animated_image_radius|default('sharp') ~ '' == '' ? '0' : component.animated_image_radius|default('sharp')) ~ 'px') %}
{% set is_full = component.animated_full_width ? true : false %}
{% set has_mobile_spacing = component.use_h_spacing and not is_full ? true : false %}

{# ==========================================================================
   النصوص فوق البانر

   المحتوى (العنوان، العنوان الفرعي، العداد، الزر) كان مكتوباً في القالب منذ
   البداية لكن ما كان له أي تنسيق في ملف الستايل — فكان ينزل تحت الصورة بشكله
   الخام. التنسيق هنا inline داخل القالب عن قصد: ملفات SCSS تحتاج build ورفع
   على الـ CDN، والقالب ينشر فوراً.
   ========================================================================== #}
<style>
.animated-banners__card { position: relative; }

.animated-banners__content {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: clamp(8px, 1.6vw, 16px);
  padding: clamp(14px, 4.5vw, 56px);
  overflow: hidden;
  border-radius: var(--animated-radius, 0px);
  text-align: start;
  /* البطاقة كلها رابط: الطبقة ما تاخذ النقر عشان يبقى الضغط على أي مكان شغال */
  pointer-events: none;
}

/* مكان النصوص: يمين أو منتصف أو يسار — فيزيائي، فما يتغير مع اتجاه المتجر. */
.animated-banners__content.is-pos-right { align-items: flex-start; text-align: right; }
.animated-banners__content.is-pos-left { align-items: flex-end; text-align: left; }
.animated-banners__content.is-pos-center { align-items: center; text-align: center; }

html[dir="ltr"] .animated-banners__content.is-pos-right { align-items: flex-end; }
html[dir="ltr"] .animated-banners__content.is-pos-left { align-items: flex-start; }

/* تعتيم خفيف تحت النص فقط — وما ينزل إلا إذا كان في نص أصلاً، ومن الجهة
   اللي فيها النص. */
.animated-banners__content.has-content::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
}

.animated-banners__content.has-content.is-pos-right::before {
  background: linear-gradient(to left, rgba(0, 0, 0, .62), rgba(0, 0, 0, .18) 58%, rgba(0, 0, 0, 0) 82%);
}

.animated-banners__content.has-content.is-pos-left::before {
  background: linear-gradient(to right, rgba(0, 0, 0, .62), rgba(0, 0, 0, .18) 58%, rgba(0, 0, 0, 0) 82%);
}

.animated-banners__content.has-content.is-pos-center::before {
  background: linear-gradient(to top, rgba(0, 0, 0, .55), rgba(0, 0, 0, .22) 55%, rgba(0, 0, 0, .45));
}

.animated-banners__content h2 {
  margin: 0;
  max-width: 22ch;
  font-size: clamp(17px, 3.4vw, 42px);
  font-weight: 900;
  line-height: 1.25;
  color: #fff;
  text-shadow: 0 2px 14px rgba(0, 0, 0, .45);
}

.animated-banners__content p {
  margin: 0;
  max-width: 34ch;
  font-size: clamp(11px, 1.6vw, 17px);
  line-height: 1.7;
  color: #fff;
  opacity: .92;
  text-shadow: 0 2px 10px rgba(0, 0, 0, .4);
}

/* ------------------------------------------------------------- العداد --- */
.animated-banners__countdown {
  display: flex;
  flex-direction: row;
  gap: clamp(5px, .8vw, 10px);
  margin: 0;
  padding: 0;
}

.animated-banners__countdown > div {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  min-width: clamp(42px, 5.2vw, 66px);
  padding: clamp(5px, .8vw, 10px) clamp(6px, .9vw, 12px);
  /* الحواف تتبع حواف البنر نفسه: حاد يعطي حاداً، ودائري يعطي دائرياً. */
  border-radius: var(--animated-radius, 14px);
  border: 1px solid rgba(255, 255, 255, .22);
  background: rgba(0, 0, 0, .34);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  color: #fff;
  line-height: 1;
}

.animated-banners__countdown strong {
  font-size: clamp(14px, 1.9vw, 24px);
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.animated-banners__countdown span {
  font-size: clamp(9px, 1vw, 12px);
  font-weight: 600;
  opacity: .78;
}

/* ---------------------------------------------------------------- الزر --- */
.animated-banners__button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: clamp(2px, .6vw, 8px);
  padding: clamp(7px, 1vw, 13px) clamp(14px, 1.8vw, 26px);
  border-radius: var(--animated-radius, 12px);
  border: 1.5px solid transparent;
  background: var(--color-primary, #004956);
  color: #fff;
  font-size: clamp(11px, 1.4vw, 15px);
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.animated-banners__button i { font-size: 1.05em; line-height: 1; }
.animated-banners__button.is-rounded { border-radius: 999px; }
.animated-banners__button.is-reverse { flex-direction: row-reverse; }

.animated-banners__button.is-outline {
  background: transparent;
  border-color: rgba(255, 255, 255, .8);
  color: #fff;
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
}

/* على الجوال ارتفاع البانر هو اللي يحكم: كل شي يضيق، والعنوان الفرعي أول ما
   ينزل على الشاشات الضيقة جداً حتى لا يزاحم العداد والزر. */
@media (max-width: 767px) {
  .animated-banners__content {
    gap: 5px;
    padding: clamp(10px, 3.2vw, 18px);
  }

  .animated-banners__content h2 { font-size: clamp(14px, 4.4vw, 20px); }
  .animated-banners__content p { font-size: clamp(10px, 3vw, 13px); line-height: 1.5; }

  .animated-banners__countdown { gap: 4px; }

  .animated-banners__countdown > div {
    min-width: 34px;
    padding: 4px 6px;
    border-radius: var(--animated-radius, 8px);
  }

  .animated-banners__countdown strong { font-size: 13px; }
  .animated-banners__countdown span { font-size: 8px; }

  .animated-banners__button {
    margin-top: 2px;
    padding: 6px 13px;
    border-radius: var(--animated-radius, 10px);
    font-size: 11px;
  }

  .animated-banners__button.is-rounded { border-radius: 999px; }
}

@media (max-width: 430px) {
  .animated-banners__content p { display: none; }
}

/* النقاط تخص شريط الجوال وحده: لا معنى لها والبنرات كلها ظاهرة دفعة واحدة. */
.animated-banners .veloura-dots { display: none !important; }

/* ==========================================================================
   تخطيط «بنر كبير + بنرين جانبيين»

   البنر الأول يأخذ الثلثين، والاثنان بعده يتقاسمان الثلث الباقي فوق بعضهما.
   ارتفاع الصف يحدده البنر الكبير بنسبته الطبيعية، والصغيران يتمددان عليه —
   فما في ارتفاع مفروض بالقوة على صور ما نعرف مقاساتها.
   ========================================================================== */
.animated-banners__feature { display: grid; gap: var(--ab-gap, 14px); }

.animated-banners__row {
  display: grid;
  gap: var(--ab-gap, 14px);
  grid-template-columns: minmax(0, 1fr);
}

.animated-banners__side { display: grid; gap: var(--ab-gap, 14px); grid-template-columns: minmax(0, 1fr); }

/* البطاقات الجانبية تملأ خانتها دائماً — على اللابتوب وعلى الجوال — فالصفّ
   يخرج بارتفاع واحد والصور تُقصّ بدل أن تتمدد. الـ important مقصود: ملف
   الستايل المبني يفرض height:auto على كل صورة داخل البطاقة. */
.animated-banners__side > * { min-height: 0; height: 100%; }

.animated-banners__side .animated-banners__card,
.animated-banners__side .animated-banners__card picture {
  display: block;
  height: 100% !important;
}

.animated-banners__side .animated-banners__card img {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover;
}

@media (min-width: 1024px) {
  /* الارتفاع يحدده البنر الكبير وحده. لو ترك العمود الجانبي داخل الشبكة كان
     ارتفاعه الطبيعي (صورتان فوق بعضهما) هو اللي يفرض ارتفاع الصف أحياناً،
     فيطلع الكبير أقصر ويبقى فراغ تحته. هنا الصف صندوق عادي: الكبير يأخذ
     الثلثين بنسبته الطبيعية، والعمود الجانبي مثبّت على حافته من الأعلى
     للأسفل — فما في فرق ولا بكسل واحد. */
  .animated-banners__row.has-side {
    display: block;
    position: relative;
  }

  .animated-banners__row.has-side .animated-banners__main {
    width: calc((100% - var(--ab-gap, 14px)) * 2 / 3);
  }

  .animated-banners__row.has-side .animated-banners__side {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: calc((100% - var(--ab-gap, 14px)) / 3);
    grid-auto-rows: 1fr;
    grid-template-columns: minmax(0, 1fr);
  }

}

@media (max-width: 1023px) {
  .animated-banners__side {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
  }

  .animated-banners__side:has(> :only-child) { grid-template-columns: minmax(0, 1fr); }

  /* شريط يُمرَّر بالإصبع بدل تكديس البنرات: ثلاثة بنرات مكدّسة تأكل شاشة
     كاملة على الجوال. الصفّ والعمود الجانبي يختفيان من التخطيط بـ contents،
     فتصير البنرات نفسها عناصر الشريط — بلا أي تكرار في الـ DOM وبلا سكربت،
     فالالتقاط (scroll-snap) من المتصفح نفسه. */
  .animated-banners.is-mob-slider .animated-banners__feature {
    display: flex;
    /* بلا تمدد: كل بنر يحتفظ بارتفاعه الطبيعي بدل أن يُشَدّ لأطول واحد. */
    align-items: flex-start;
    gap: var(--ab-gap, 14px);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 2px;
  }

  .animated-banners.is-mob-slider .animated-banners__feature::-webkit-scrollbar { display: none; }

  .animated-banners.is-mob-slider .veloura-dots { display: flex !important; }

  .animated-banners.is-mob-slider .animated-banners__feature img {
    -webkit-user-drag: none;
    user-select: none;
  }

  .animated-banners.is-mob-slider .animated-banners__row,
  .animated-banners.is-mob-slider .animated-banners__side { display: contents; }

  /* البنر يملأ عرض الكونتينر كاملاً، ناقص ما يُترك ليظهر من البنر التالي.
     صفر يعني بنراً كامل العرض بلا أي ظهور لما بعده. */
  .animated-banners.is-mob-slider .animated-banners__main,
  .animated-banners.is-mob-slider .animated-banners__side > * {
    flex: 0 0 calc(100% - var(--ab-peek, 12%));
    scroll-snap-align: start;
    scroll-snap-stop: always;
    height: auto;
  }

  .animated-banners.is-mob-slider .animated-banners__side .animated-banners__card,
  .animated-banners.is-mob-slider .animated-banners__side .animated-banners__card picture,
  .animated-banners.is-mob-slider .animated-banners__side .animated-banners__card img {
    height: auto !important;
  }
}

.animated-banners__feature .animated-banners__card { margin-inline: 0; }
</style>

{# البطاقة الواحدة في مكان واحد: يستعملها الشريط المتحرك والتخطيط الثابت معاً،
   فأي تعديل عليها يصيب الاثنين. #}
{% macro ab_card(banner) %}
  {% set image_src = banner.banner_image %}
  {% if banner.use_image_url and banner.image_url %}{% set image_src = banner.image_url %}{% endif %}

  {% set mobile_image = banner.banner_image_mobile ?: image_src %}
  {% if banner.use_mobile_image_url and banner.mobile_image_url %}{% set mobile_image = banner.mobile_image_url %}{% endif %}

  {% set banner_link = banner.url ?: '#' %}

  {# مكان النصوص: الخيار الجديد، ومع المتاجر القديمة يرجع لمفتاح التوسيط. #}
  {% set tpos = banner.text_position|default('') %}
  {% if tpos.selected is defined %}{% set tpos = tpos.selected %}{% endif %}
  {% if tpos is iterable and tpos.value is not defined %}{% set tpos = tpos|first %}{% endif %}
  {% if tpos.value is defined %}{% set tpos = tpos.value %}{% endif %}
  {% if tpos not in ['right', 'center', 'left'] %}{% set tpos = banner.text_center ? 'center' : 'right' %}{% endif %}

  {% set has_overlay = banner.banner_title or banner.banner_subtitle or banner.button_text or (banner.discount_enable and banner.discount_end_date) %}

  {% if image_src %}
    <a href="{{ banner_link }}" class="animated-banners__card">
      <picture>
        <source media="(max-width: 767px)" srcset="{{ mobile_image }}">
        <img src="{{ image_src }}" alt="{{ banner.banner_title ?: 'banner' }}" loading="lazy">
      </picture>

      <div class="animated-banners__content is-pos-{{ tpos }} {{ has_overlay ? 'has-content' : 'is-empty' }}">
        {% if banner.banner_title %}
          <h2 style="color: {{ banner.banner_title_color|default('#ffffff') }};">{{ banner.banner_title|raw }}</h2>
        {% endif %}

        {% if banner.banner_subtitle %}
          <p style="color: {{ banner.banner_subtitle_color|default('#ffffff') }};">{{ banner.banner_subtitle|raw }}</p>
        {% endif %}

        {% if banner.discount_enable and banner.discount_end_date %}
          <div class="animated-banners__countdown" data-countdown="{{ banner.discount_end_date }}">
            <div><strong data-days>0</strong><span>يوم</span></div>
            <div><strong data-hours>0</strong><span>ساعة</span></div>
            <div><strong data-minutes>0</strong><span>دقيقة</span></div>
            <div><strong data-seconds>0</strong><span>ثانية</span></div>
          </div>
        {% endif %}

        {% if banner.button_text %}
          <span class="animated-banners__button {{ banner.button_no_bg ? 'is-outline' : '' }} {{ banner.button_rounded ? 'is-rounded' : '' }} {{ banner.button_icon_reverse ? 'is-reverse' : '' }}">
            {% if not banner.button_hide_icon %}<i class="{{ banner.button_icon|default('sicon-arrow-left') }}"></i>{% endif %}
            {{ banner.button_text }}
          </span>
        {% endif %}
      </div>
    </a>
  {% endif %}
{% endmacro %}

{# شكل العرض على اللابتوب: شريط متحرك، أو بنر كبير بالثلثين وبنرين في الثلث. #}
{% set ab_layout = component.animated_desktop_layout|default('slider') %}
{% if ab_layout.selected is defined %}{% set ab_layout = ab_layout.selected %}{% endif %}
{% if ab_layout is iterable and ab_layout.value is not defined %}{% set ab_layout = ab_layout|first %}{% endif %}
{% if ab_layout.value is defined %}{% set ab_layout = ab_layout.value %}{% endif %}
{% if ab_layout not in ['slider', 'feature'] %}{% set ab_layout = 'slider' %}{% endif %}

{% set ab_peek = component.animated_feature_peek %}
{% if ab_peek.value is defined %}{% set ab_peek = ab_peek.value %}{% endif %}
{% if ab_peek is iterable or ab_peek ~ '' == '' %}{% set ab_peek = 12 %}{% endif %}

{% set ab_mob = component.animated_feature_mobile|default('slider') %}
{% if ab_mob.selected is defined %}{% set ab_mob = ab_mob.selected %}{% endif %}
{% if ab_mob is iterable and ab_mob.value is not defined %}{% set ab_mob = ab_mob|first %}{% endif %}
{% if ab_mob.value is defined %}{% set ab_mob = ab_mob.value %}{% endif %}
{% if ab_mob not in ['slider', 'stack'] %}{% set ab_mob = 'slider' %}{% endif %}

{% if component.animated_banners|length > 0 %}
<section data-veloura-home-tab="{{ veloura_home_tab_key|e }}"
  class="
    s-block
    animated-banners
    {{ is_full ? 'full-banner is-full-width-desktop' : '' }}
    {{ has_mobile_spacing ? 'has-mobile-spacing' : '' }}
    {{ ab_layout == 'feature' ? 'is-feature-layout' : '' }}
    {{ ab_layout == 'feature' and ab_mob == 'slider' ? 'is-mob-slider' : '' }}
    {{ ab_layout != 'feature' and component.animated_transition_type in ['cube', 'flip'] ? 'has-3d-effect' : '' }}
  "
  style="
    --banner-margin: {{ has_mobile_spacing ? h_spacing : 0 }}px;
    --animated-radius: {{ animated_radius }};
    --ab-gap: 14px;
    --ab-peek: {{ ab_peek }}%;
  "
>
  <div class="{{ is_full ? 'animated-banners__container is-full-width' : 'container animated-banners__container' }}">

    {% if ab_layout == 'feature' %}
      {# كل ثلاثة بنرات صف: الأول بالثلثين، والاثنان بعده فوق بعضهما في الثلث.
         الصف الناقص يتصرف من نفسه — بنر واحد يأخذ العرض كله. #}
      <div class="animated-banners__feature" id="animated-banners-feature-{{ position }}">
        {% for group in component.animated_banners|batch(3) %}
          <div class="animated-banners__row {{ group|length > 1 ? 'has-side' : '' }}">
            <div class="animated-banners__main">{{ _self.ab_card(group[0]) }}</div>

            {% if group|length > 1 %}
              <div class="animated-banners__side">
                {% if group[1] is defined %}<div>{{ _self.ab_card(group[1]) }}</div>{% endif %}
                {% if group[2] is defined %}<div>{{ _self.ab_card(group[2]) }}</div>{% endif %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      {% if not component.animated_hide_dots %}
        <div class="veloura-dots" data-ab-dots></div>
      {% endif %}
    {% else %}
      <salla-slider
        class="animated-banners__slider {{ is_full ? 'fullwidth-slider' : '' }}"
        type="{{ is_full ? 'fullwidth' : 'slider' }}"
        id="animated-banners-{{ position }}"
        {% if component.animated_hide_arrows_desktop %}show-controls="false"{% endif %}
        {% if not component.animated_hide_dots %}pagination{% endif %}
        {% if component.animated_autoplay %}auto-play{% endif %}
        static-when-single
        slider-config='{
          "effect": "{{ effect }}",
          "loop": {{ effect == "cards" ? "false" : (component.animated_loop ? "true" : "false") }},
          "speed": 800,
          "autoplay": {{ component.animated_autoplay ? "{\"delay\":2500,\"disableOnInteraction\":false}" : "false" }},
          "cardsEffect": {
            "slideShadows": true,
            "perSlideOffset": 12,
            "perSlideRotate": 3
          }
        }'
      >
        <div slot="items">
          {% for banner in component.animated_banners %}
            <div class="swiper-slide animated-banners__slide">{{ _self.ab_card(banner) }}</div>
          {% endfor %}
        </div>
      </salla-slider>
    {% endif %}

  </div>
</section>
{% endif %}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-countdown]').forEach(function(timer) {
      /* التاريخ يصل بأشكال مختلفة (يوم-شهر-سنة، سنة-شهر-يوم، ومعه وقت
         أحياناً). نقرأ الأرقام ونرتّبها بالمنطق بدل افتراض صيغة واحدة —
         الافتراض الخاطئ كان ينتج تاريخاً ماضياً فيختفي العدّاد فوراً. */
      var raw = String(timer.getAttribute('data-countdown') || '').replace(/"/g, '').trim();
      var nums = raw.match(/\d+/g) || [];
      var endDate = NaN;

      if (nums.length >= 3) {
        var y, m, d;
        if (nums[0].length === 4) { y = +nums[0]; m = +nums[1]; d = +nums[2]; }
        else { d = +nums[0]; m = +nums[1]; y = +nums[2]; }
        if (y && m && d && m <= 12 && d <= 31) {
          endDate = new Date(y, m - 1, d,
            nums.length > 3 ? +nums[3] : 23,
            nums.length > 4 ? +nums[4] : 59,
            nums.length > 5 ? +nums[5] : 59).getTime();
        }
      }

      if (!isFinite(endDate)) { endDate = Date.parse(raw); }
      if (!isFinite(endDate)) return;

      function updateTimer() {
        let now = new Date().getTime();
        let distance = endDate - now;

        if (distance <= 0 || isNaN(distance)) {
          timer.style.display = 'none';
          return;
        }

        timer.querySelector('[data-days]').textContent = Math.floor(distance / (1000 * 60 * 60 * 24));
        timer.querySelector('[data-hours]').textContent = Math.floor((distance / (1000 * 60 * 60)) % 24);
        timer.querySelector('[data-minutes]').textContent = Math.floor((distance / (1000 * 60)) % 60);
        timer.querySelector('[data-seconds]').textContent = Math.floor((distance / 1000) % 60);
      }

      updateTimer();
      setInterval(updateTimer, 1000);
    });
  });
</script>

<script>
/* شريط البنرات على الجوال.

   التمرير باللمس يعمل من المتصفح نفسه، لكن على سطح المكتب (وفي وضع معاينة
   الجوال داخل المتصفح) سحب الفأرة لا يحرّك أي حاوية — فيبدو الشريط جامداً.
   هنا نضيف السحب بالفأرة، ونحرّك الشريط تلقائياً إن كان «التشغيل التلقائي»
   مفعّلاً، ويتوقف فور أن يلمسه الزائر ويعود بعد أن يتركه.

   بلا مكتبة وبلا مراقب: الالتقاط عند كل بنر يبقى من المتصفح (scroll-snap). */
(function () {
  var strip = document.getElementById('animated-banners-feature-{{ position }}');
  if (!strip) return;

  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var isStrip = function () { return getComputedStyle(strip).overflowX === 'auto' && strip.scrollWidth > strip.clientWidth + 4; };

  var cards = function () {
    return Array.prototype.slice.call(
      strip.querySelectorAll('.animated-banners__main, .animated-banners__side > *')
    );
  };

  /* --------------------------------------------- الانتقال من بنر إلى بنر -- */
  /* الالتقاط الأصلي (scroll-snap) يطالب بسحب نصف البنر قبل أن ينتقل، وهو ما
     يجعل الحركة تبدو ثقيلة. هنا نقرّر بأنفسنا بعد ترك الإصبع: نحسب سرعة
     السحب ونتوقّع إلى أين كان المحتوى ماضياً، ثم ننزلق بنعومة إلى أقرب بنر
     لتلك النقطة — فسحبة قصيرة سريعة تكفي، والحركة تنساب بدل أن تقفز. */
  var rtl = getComputedStyle(strip).direction === 'rtl';

  function edgeOf(rect) { return rtl ? rect.right : rect.left; }

  var snapRestore = null;

  function slideTo(card) {
    if (!card) return;

    var delta = edgeOf(card.getBoundingClientRect()) - edgeOf(strip.getBoundingClientRect());
    if (!delta) return;

    /* scroll-snap-stop: always يوقف أي انتقال عند أول بنر يمر به، فالقفزة
       إلى بنر بعيد (نقطة، أو سحبة طويلة) كانت تقف بعد بنر واحد. نطفئ
       الالتقاط أثناء الانزلاق ونعيده بعد أن يستقر. */
    strip.style.scrollSnapType = 'none';
    clearTimeout(snapRestore);
    snapRestore = setTimeout(function () { strip.style.scrollSnapType = ''; }, 520);

    /* scrollBy يعمل بالإحداثي الفيزيائي في الاتجاهين، فلا حاجة لحساب إشارة. */
    strip.scrollBy({ left: delta, behavior: 'smooth' });
  }

  function nearest(projection) {
    var list = cards();
    if (!list.length) return null;

    var target = edgeOf(strip.getBoundingClientRect());
    var best = null, bestD = Infinity;

    for (var i = 0; i < list.length; i++) {
      var d = Math.abs((edgeOf(list[i].getBoundingClientRect()) + projection) - target);
      if (d < bestD) { bestD = d; best = list[i]; }
    }
    return best;
  }

  /* ------------------------------------------------------ السحب بالفأرة -- */
  /* البطاقات روابط تحوي صوراً، والمتصفح يبدأ عليها سحب رابط أصلياً بمجرد
     ضغط الفأرة وتحريكها — فيلتهم حركة السحب كلها ويبقى الشريط جامداً. */
  strip.addEventListener('dragstart', function (e) { e.preventDefault(); });

  var down = false, moved = false, startX = 0, startScroll = 0, snap = '';
  var lastX = 0, lastT = 0, vel = 0;

  strip.addEventListener('pointerdown', function (e) {
    if (e.pointerType === 'touch' || !isStrip()) return;
    down = true; moved = false;
    startX = lastX = e.clientX;
    lastT = e.timeStamp;
    vel = 0;
    startScroll = strip.scrollLeft;
    snap = strip.style.scrollSnapType;
    stopAuto();
  });

  strip.addEventListener('pointermove', function (e) {
    if (!down) return;
    var dx = e.clientX - startX;
    if (!moved && Math.abs(dx) < 5) return;

    /* الالتقاط يُعطَّل أثناء السحب فقط، وإلا شدّ الشريط من تحت الإصبع. */
    if (!moved) { moved = true; strip.style.scrollSnapType = 'none'; strip.setPointerCapture(e.pointerId); }

    var dt = e.timeStamp - lastT;
    if (dt > 0) vel = (e.clientX - lastX) / dt;
    lastX = e.clientX; lastT = e.timeStamp;

    strip.scrollLeft = startScroll - dx;
  });

  var release = function () {
    if (!down) return;
    down = false;

    if (moved) {
      /* اندفاعة تقديرية: سحبة سريعة تنقل بنراً كاملاً، وبطيئة ترجع لمكانها. */
      slideTo(nearest(vel * 160));

      strip.addEventListener('click', function swallow(ev) {
        ev.preventDefault(); ev.stopPropagation();
        strip.removeEventListener('click', swallow, true);
      }, true);
    }

    startAuto();
  };

  strip.addEventListener('pointerup', release);
  strip.addEventListener('pointercancel', release);
  strip.addEventListener('pointerleave', release);

  /* ------------------------------------------------------ الحركة التلقائية -- */
  var timer = null;

  function currentIndex() {
    var list = cards();
    var target = edgeOf(strip.getBoundingClientRect());
    var current = 0, best = Infinity;

    for (var i = 0; i < list.length; i++) {
      var d = Math.abs(edgeOf(list[i].getBoundingClientRect()) - target);
      if (d < best) { best = d; current = i; }
    }
    return current;
  }

  function step() {
    if (!isStrip()) return;
    var list = cards();
    if (list.length < 2) return;

    var current = currentIndex();

    if (current >= list.length - 1) {
      /* «الدوران بلا نهاية»: يرجع للبنر الأول بدل أن يقف عند الأخير. وبدونه
         يتوقّف الشريط عند نهايته — وهذا هو الفرق الذي يحدثه الخيار هنا. */
      {% if component.animated_loop %}
      strip.scrollTo({ left: 0, behavior: 'smooth' });
      {% else %}
      stopAuto();
      {% endif %}
      return;
    }

    slideTo(list[current + 1]);
  }

  /* ------------------------------------------------------------ النقاط -- */
  var dotsBox = strip.parentNode ? strip.parentNode.querySelector('[data-ab-dots]') : null;
  var dotEls = [];

  function buildDots() {
    if (!dotsBox) return;
    var list = cards();

    if (list.length < 2) { dotsBox.style.display = 'none'; return; }
    if (dotEls.length === list.length) return;

    dotsBox.innerHTML = '';
    dotEls = list.map(function (card, i) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'veloura-dots__dot';
      b.setAttribute('aria-label', 'بنر ' + (i + 1));
      b.addEventListener('click', function () { stopAuto(); slideTo(cards()[i]); setTimeout(startAuto, 4500); });
      dotsBox.appendChild(b);
      return b;
    });
  }

  function paintDots() {
    if (!dotEls.length) return;
    var i = currentIndex();
    for (var k = 0; k < dotEls.length; k++) dotEls[k].classList.toggle('is-on', k === i);
  }

  var dotsPending = false;
  strip.addEventListener('scroll', function () {
    if (dotsPending) return;
    dotsPending = true;
    requestAnimationFrame(function () { dotsPending = false; paintDots(); });
  }, { passive: true });

  addEventListener('resize', function () { buildDots(); paintDots(); }, { passive: true });

  buildDots();
  paintDots();

  function startAuto() {
    {% if component.animated_autoplay %}
    if (reduced || timer) return;
    timer = setInterval(step, 4500);
    {% endif %}
  }

  function stopAuto() {
    if (!timer) return;
    clearInterval(timer);
    timer = null;
  }

  strip.addEventListener('touchstart', stopAuto, { passive: true });
  strip.addEventListener('touchend', function () { setTimeout(startAuto, 4500); }, { passive: true });
  strip.addEventListener('mouseenter', stopAuto);
  strip.addEventListener('mouseleave', startAuto);

  startAuto();
})();
</script>