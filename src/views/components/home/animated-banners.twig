{# VELOURA HOME TAB ASSIGNMENT START #}
{% set veloura_home_tab_key = component.veloura_home_tab_name_2026|default('') %}
{% if veloura_home_tab_key.value is defined %}{% set veloura_home_tab_key = veloura_home_tab_key.value %}{% endif %}
{% if not veloura_home_tab_key %}{% set veloura_home_tab_key = 'always' %}{% endif %}
{# VELOURA HOME TAB ASSIGNMENT END #}

{% set radius_map = {
  'sharp': '0px',
  'soft': '8px',
  'medium': '16px',
  'large': '28px',
  'round': '999px'
} %}

{% set h_spacing = component.h_spacing|default(0) %}
{% set h_spacing = h_spacing + 0 %}
{% if h_spacing < 0 %}{% set h_spacing = 0 %}{% endif %}
{% if h_spacing > 100 %}{% set h_spacing = 100 %}{% endif %}

{% set effect = component.animated_transition_type|default('slide') %}
{% set safe_effect = effect == 'cards' ? 'slide' : effect %}
{% set animated_radius = radius_map[component.animated_image_radius|default('sharp')]|default('0px') %}
{% set is_full = component.animated_full_width ? true : false %}
{% set has_mobile_spacing = component.use_h_spacing and not is_full ? true : false %}

{# ==========================================================================
   النصوص فوق البانر

   المحتوى (العنوان، العنوان الفرعي، العداد، الزر) كان مكتوباً في القالب منذ
   البداية لكن ما كان له أي تنسيق في ملف الستايل — فكان ينزل تحت الصورة بشكله
   الخام. التنسيق هنا inline داخل القالب عن قصد: ملفات SCSS تحتاج build ورفع
   على الـ CDN، والقالب ينشر فوراً.
   ========================================================================== #}
<style>
.animated-banners__card { position: relative; }

.animated-banners__content {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: clamp(8px, 1.6vw, 16px);
  padding: clamp(14px, 4.5vw, 56px);
  overflow: hidden;
  border-radius: var(--animated-radius, 0px);
  text-align: start;
  /* البطاقة كلها رابط: الطبقة ما تاخذ النقر عشان يبقى الضغط على أي مكان شغال */
  pointer-events: none;
}

.animated-banners__content.is-center { align-items: center; text-align: center; }
.animated-banners__content.is-right { align-items: flex-start; }

/* تعتيم خفيف تحت النص فقط — وما ينزل إلا إذا كان في نص أصلاً */
.animated-banners__content.has-content::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(to left, rgba(0, 0, 0, .62), rgba(0, 0, 0, .18) 58%, rgba(0, 0, 0, 0) 82%);
}

html[dir="ltr"] .animated-banners__content.has-content::before {
  background: linear-gradient(to right, rgba(0, 0, 0, .62), rgba(0, 0, 0, .18) 58%, rgba(0, 0, 0, 0) 82%);
}

.animated-banners__content.has-content.is-center::before {
  background: linear-gradient(to top, rgba(0, 0, 0, .55), rgba(0, 0, 0, .22) 55%, rgba(0, 0, 0, .45));
}

.animated-banners__content h2 {
  margin: 0;
  max-width: 22ch;
  font-size: clamp(17px, 3.4vw, 42px);
  font-weight: 900;
  line-height: 1.25;
  color: #fff;
  text-shadow: 0 2px 14px rgba(0, 0, 0, .45);
}

.animated-banners__content p {
  margin: 0;
  max-width: 34ch;
  font-size: clamp(11px, 1.6vw, 17px);
  line-height: 1.7;
  color: #fff;
  opacity: .92;
  text-shadow: 0 2px 10px rgba(0, 0, 0, .4);
}

/* ------------------------------------------------------------- العداد --- */
.animated-banners__countdown {
  display: flex;
  flex-direction: row;
  gap: clamp(5px, .8vw, 10px);
  margin: 0;
  padding: 0;
}

.animated-banners__countdown > div {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  min-width: clamp(42px, 5.2vw, 66px);
  padding: clamp(5px, .8vw, 10px) clamp(6px, .9vw, 12px);
  border-radius: clamp(8px, 1vw, 14px);
  border: 1px solid rgba(255, 255, 255, .22);
  background: rgba(0, 0, 0, .34);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  color: #fff;
  line-height: 1;
}

.animated-banners__countdown strong {
  font-size: clamp(14px, 1.9vw, 24px);
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.animated-banners__countdown span {
  font-size: clamp(9px, 1vw, 12px);
  font-weight: 600;
  opacity: .78;
}

/* ---------------------------------------------------------------- الزر --- */
.animated-banners__button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: clamp(2px, .6vw, 8px);
  padding: clamp(7px, 1vw, 13px) clamp(14px, 1.8vw, 26px);
  border-radius: 12px;
  border: 1.5px solid transparent;
  background: var(--color-primary, #004956);
  color: #fff;
  font-size: clamp(11px, 1.4vw, 15px);
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.animated-banners__button i { font-size: 1.05em; line-height: 1; }
.animated-banners__button.is-rounded { border-radius: 999px; }
.animated-banners__button.is-reverse { flex-direction: row-reverse; }

.animated-banners__button.is-outline {
  background: transparent;
  border-color: rgba(255, 255, 255, .8);
  color: #fff;
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
}

/* على الجوال ارتفاع البانر هو اللي يحكم: كل شي يضيق، والعنوان الفرعي أول ما
   ينزل على الشاشات الضيقة جداً حتى لا يزاحم العداد والزر. */
@media (max-width: 767px) {
  .animated-banners__content {
    gap: 5px;
    padding: clamp(10px, 3.2vw, 18px);
  }

  .animated-banners__content h2 { font-size: clamp(14px, 4.4vw, 20px); }
  .animated-banners__content p { font-size: clamp(10px, 3vw, 13px); line-height: 1.5; }

  .animated-banners__countdown { gap: 4px; }

  .animated-banners__countdown > div {
    min-width: 34px;
    padding: 4px 6px;
    border-radius: 8px;
  }

  .animated-banners__countdown strong { font-size: 13px; }
  .animated-banners__countdown span { font-size: 8px; }

  .animated-banners__button {
    margin-top: 2px;
    padding: 6px 13px;
    border-radius: 10px;
    font-size: 11px;
  }

  .animated-banners__button.is-rounded { border-radius: 999px; }
}

@media (max-width: 430px) {
  .animated-banners__content p { display: none; }
}
</style>

{% if component.animated_banners|length > 0 %}
<section data-veloura-home-tab="{{ veloura_home_tab_key|e }}"
  class="
    s-block
    animated-banners
    {{ is_full ? 'full-banner is-full-width-desktop' : '' }}
    {{ has_mobile_spacing ? 'has-mobile-spacing' : '' }}
    {{ component.animated_transition_type in ['cube', 'flip'] ? 'has-3d-effect' : '' }}
  "
  style="
    --banner-margin: {{ has_mobile_spacing ? h_spacing : 0 }}px;
    --animated-radius: {{ animated_radius }};
  "
>
  <div class="{{ is_full ? 'animated-banners__container is-full-width' : 'container animated-banners__container' }}">
    <salla-slider
      class="animated-banners__slider {{ is_full ? 'fullwidth-slider' : '' }}"
      type="{{ is_full ? 'fullwidth' : 'slider' }}"
      id="animated-banners-{{ position }}"
      {% if component.animated_hide_arrows_desktop %}show-controls="false"{% endif %}
      {% if not component.animated_hide_dots %}pagination{% endif %}
      {% if component.animated_autoplay %}auto-play{% endif %}
      static-when-single
      slider-config='{
        "effect": "{{ effect }}",
        "loop": {{ effect == "cards" ? "false" : (component.animated_loop ? "true" : "false") }},
        "speed": 800,
        "autoplay": {{ component.animated_autoplay ? "{\"delay\":2500,\"disableOnInteraction\":false}" : "false" }},
        "cardsEffect": {
          "slideShadows": true,
          "perSlideOffset": 12,
          "perSlideRotate": 3
        }
      }'
    >
      <div slot="items">
        {% for banner in component.animated_banners %}
          {% set image_src = banner.banner_image %}
          {% if banner.use_image_url and banner.image_url %}
            {% set image_src = banner.image_url %}
          {% endif %}

          {% set mobile_image = banner.banner_image_mobile ?: image_src %}
          {% if banner.use_mobile_image_url and banner.mobile_image_url %}
            {% set mobile_image = banner.mobile_image_url %}
          {% endif %}

          {% set banner_link = banner.url ?: '#' %}

          {% if image_src %}
            <div class="swiper-slide animated-banners__slide">
              <a href="{{ banner_link }}" class="animated-banners__card">
                <picture>
                  <source media="(max-width: 767px)" srcset="{{ mobile_image }}">
                  <img src="{{ image_src }}" alt="{{ banner.banner_title ?: 'banner' }}" loading="lazy">
                </picture>

                {% set has_overlay = banner.banner_title or banner.banner_subtitle or banner.button_text or (banner.discount_enable and banner.discount_end_date) %}
                <div class="animated-banners__content {{ banner.text_center ? 'is-center' : 'is-right' }} {{ has_overlay ? 'has-content' : 'is-empty' }}">
                  {% if banner.banner_title %}
                    <h2 style="color: {{ banner.banner_title_color|default('#ffffff') }};">
                      {{ banner.banner_title|raw }}
                    </h2>
                  {% endif %}

                  {% if banner.banner_subtitle %}
                    <p style="color: {{ banner.banner_subtitle_color|default('#ffffff') }};">
                      {{ banner.banner_subtitle|raw }}
                    </p>
                  {% endif %}

                  {% if banner.discount_enable and banner.discount_end_date %}
                    <div class="animated-banners__countdown" data-countdown="{{ banner.discount_end_date }}">
                      <div><strong data-days>0</strong><span>يوم</span></div>
                      <div><strong data-hours>0</strong><span>ساعة</span></div>
                      <div><strong data-minutes>0</strong><span>دقيقة</span></div>
                      <div><strong data-seconds>0</strong><span>ثانية</span></div>
                    </div>
                  {% endif %}

                  {% if banner.button_text %}
                    <span class="animated-banners__button {{ banner.button_no_bg ? 'is-outline' : '' }} {{ banner.button_rounded ? 'is-rounded' : '' }} {{ banner.button_icon_reverse ? 'is-reverse' : '' }}">
                      {% if not banner.button_hide_icon %}
                        <i class="{{ banner.button_icon|default('sicon-arrow-left') }}"></i>
                      {% endif %}
                      {{ banner.button_text }}
                    </span>
                  {% endif %}
                </div>

                {% if banner.discount.enable and banner.discount.end_date %}
                  <div class="animated-banners__discount">
                    {{ banner.discount.end_date }}
                  </div>
                {% endif %}
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </salla-slider>
  </div>
</section>
{% endif %}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-countdown]').forEach(function(timer) {
      let dateString = timer.getAttribute('data-countdown').replaceAll('"', '').trim();
      let parts = dateString.split('-');
      let day = parseInt(parts[0], 10);
      let month = parseInt(parts[1], 10) - 1;
      let year = parseInt(parts[2], 10);
      let endDate = new Date(year, month, day, 23, 59, 59).getTime();

      function updateTimer() {
        let now = new Date().getTime();
        let distance = endDate - now;

        if (distance <= 0 || isNaN(distance)) {
          timer.style.display = 'none';
          return;
        }

        timer.querySelector('[data-days]').textContent = Math.floor(distance / (1000 * 60 * 60 * 24));
        timer.querySelector('[data-hours]').textContent = Math.floor((distance / (1000 * 60 * 60)) % 24);
        timer.querySelector('[data-minutes]').textContent = Math.floor((distance / (1000 * 60)) % 60);
        timer.querySelector('[data-seconds]').textContent = Math.floor((distance / 1000) % 60);
      }

      updateTimer();
      setInterval(updateTimer, 1000);
    });
  });
</script>