{# VELOURA HOME TAB ASSIGNMENT START #}
{% set veloura_home_tab_key = component.veloura_home_tab_name_2026|default('') %}
{% if veloura_home_tab_key.value is defined %}{% set veloura_home_tab_key = veloura_home_tab_key.value %}{% endif %}
{% if not veloura_home_tab_key %}{% set veloura_home_tab_key = 'always' %}{% endif %}
{# VELOURA HOME TAB ASSIGNMENT END #}

{#
| Variable                        | Type     | Description                                                                  |
|---------------------------------|----------|------------------------------------------------------------------------------|
| component                       | object   | Contains merchant settings for fields from twilight.json `component` section |
| component.banners               | object[] | list of banners                                                              |
| component.banners[].image       | string   |                                                                              |
| component.banners[].url         | string   |                                                                              |
| component.banners[].title       | ?string  |                                                                              |
| component.banners[].description | ?string  |                                                                              |
| position                        | int      | Sorting number start from zero                                               |
#}

<style>
/* الأعمدة تُكتب هنا لا في ملف الستايل المبني — انظر الشرح في العنصر المجاور. */
.pro-square-images__grid {
  display: grid !important;
  grid-template-columns: repeat(var(--mobile-columns, 2), minmax(0, 1fr)) !important;
  gap: var(--images-gap, 16px) !important;
  align-items: start;
}

@media (min-width: 768px) {
  .pro-square-images__grid {
    grid-template-columns: repeat(var(--desktop-columns, 3), minmax(0, 1fr)) !important;
  }
}
</style>

{# القيم الرقمية من لوحة الإعدادات تصل أحياناً ملفوفة في كائن ({value: 4})
   لا كرقم. طباعتها كما هي تنتج «px» بلا رقم، فتسقط الخاصية ويعود المتصفح
   للقيمة الافتراضية — وهذا هو سبب «الإعداد لا يعطي أي تأثير». هنا تُفكّ
   أولاً، ثم تُطبع. #}
{% set esb_mcols = component.mobile_columns %}
{% if esb_mcols.value is defined %}{% set esb_mcols = esb_mcols.value %}{% endif %}
{% if esb_mcols.selected is defined %}{% set esb_mcols = esb_mcols.selected %}{% endif %}
{% if esb_mcols is iterable %}{% set esb_mcols = esb_mcols|first %}{% endif %}
{% if esb_mcols.value is defined %}{% set esb_mcols = esb_mcols.value %}{% endif %}
{% if esb_mcols is iterable or esb_mcols ~ '' == '' %}{% set esb_mcols = 2 %}{% endif %}

{% set esb_dcols = component.desktop_columns %}
{% if esb_dcols.value is defined %}{% set esb_dcols = esb_dcols.value %}{% endif %}
{% if esb_dcols.selected is defined %}{% set esb_dcols = esb_dcols.selected %}{% endif %}
{% if esb_dcols is iterable %}{% set esb_dcols = esb_dcols|first %}{% endif %}
{% if esb_dcols.value is defined %}{% set esb_dcols = esb_dcols.value %}{% endif %}
{% if esb_dcols is iterable or esb_dcols ~ '' == '' %}{% set esb_dcols = 3 %}{% endif %}

{% set radius_map = {
  'sharp': '0px',
  'soft': '8px',
  'medium': '18px',
  'large': '30px',
  'round': '999px',
  '40': '999px'
} %}

{% set title_size_map = {
  'xs': '12px',
  'sm': '14px',
  'md': '18px',
  'lg': '22px',
  'xl': '28px',
  'xxl': '36px'
} %}

{% if not component.hide_section %}
<section data-veloura-home-tab="{{ veloura_home_tab_key|e }}"
  class="s-block s-block--banners pro-square-images
    {{ component.full_width_desktop ? 'is-full-width-desktop' : 'container' }}
    {{ component.custom_classes }}
    {{ component.show_mobile_only ? 'show-mobile-only' : '' }}
    {{ component.show_desktop_only ? 'show-desktop-only' : '' }}
    {{ component.display_grid ? 'is-grid' : 'is-slider' }}
  "
  style="
    --desktop-columns: {{ esb_dcols }};
    --mobile-columns: {{ esb_mcols }};
    --images-gap: {{ component.images_gap|default(16) }}px;
    --image-radius: {{ radius_map[component.image_radius|default('medium')]|default((component.image_radius|default('medium') ~ '' == '' ? '18' : component.image_radius|default('medium')) ~ 'px') }};
    padding-inline: {{ component.custom_horizontal_spacing ? component.horizontal_spacing|default(25) ~ 'px' : '0px' }};
  "
>
{% if component.display_grid %}
  <div class="pro-square-images__grid">
    {% for index, banner in component.banners %}
      <div class="pro-square-images__item">
        {% set banner_image = banner.image %}
        {% if banner.use_image_url and banner.image_url %}
          {% set banner_image = banner.image_url %}
        {% endif %}

        <a
          href="{{ banner.url }}"
          aria-label="{{ (banner.title ? banner.title : 'square-banner-' ~ index) | e('html_attr') }}"
          class="pro-square-images__card {{ component.text_on_image and component.title_overlay ? 'has-overlay' : '' }}"
        >
          {% if banner_image %}
            <img
              src="{{ banner_image }}"
              alt="{{ banner.title ? banner.title : 'banner' }}"
              loading="{{ component.image_loading|default('lazy') }}"
            >
          {% endif %}

          {% if component.text_on_image and (banner.title or banner.description) %}
            <article class="pro-square-images__content is-on-image {{ component.center_text ? 'is-centered' : '' }}">
              <div class="premium-title-box {{ component.title_box_class }}">
                {% if banner.title %}
                  <h3 class="premium-title" style="font-size: {{ title_size_map[component.title_size|default('md')]|default('18px') }};">
                    {{ banner.title|raw }}
                  </h3>
                {% endif %}
                {% if banner.description %}
                  <div class="premium-subtitle">{{ banner.description|raw }}</div>
                {% endif %}
              </div>
            </article>
          {% endif %}
        </a>

        {% if not component.text_on_image and (banner.title or banner.description) %}
  <article class="pro-square-images__content is-below-image {{ component.center_text ? 'is-centered' : '' }}">
    <div class="premium-title-box {{ component.title_box_class }}">
      {% if banner.title %}
        <h3 class="premium-title" style="font-size: {{ title_size_map[component.title_size|default('md')]|default('18px') }};">
          {{ banner.title|raw }}
        </h3>
      {% endif %}

      {% if banner.description %}
        <div class="premium-subtitle">{{ banner.description|raw }}</div>
      {% endif %}
    </div>
  </article>
{% endif %}
      </div>
    {% endfor %}
  </div>
{% else %}
  <salla-slider id="pro-square-images-{{ position }}" {% if component.slider_autoplay %}auto-play{% endif %} {% if component.slider_loop %}loop{% endif %} {{ component.slider_hide_arrows ? 'show-controls="false"' : '' }} static-when-single slider-config='{
    "slidesPerView": {{ esb_mcols }},
    "spaceBetween": {{ component.images_gap|default(16) }},
    "freeMode": {{ component.slider_free_mode ? "true" : "false" }},
    "breakpoints": {
      "768": {
        "slidesPerView": {{ esb_dcols }},
        "spaceBetween": {{ component.images_gap|default(16) }}
      }
    }
  }'>
    <div slot="items">
      {% for index, banner in component.banners %}
        <div class="swiper-slide">
          <div class="pro-square-images__item">
            {% set banner_image = banner.image %}
            {% if banner.use_image_url and banner.image_url %}
              {% set banner_image = banner.image_url %}
            {% endif %}

            <a
              href="{{ banner.url }}"
              aria-label="{{ (banner.title ? banner.title : 'square-banner-' ~ index) | e('html_attr') }}"
              class="pro-square-images__card {{ component.text_on_image and component.title_overlay ? 'has-overlay' : '' }}"
            >
              {% if banner_image %}
                <img
                  src="{{ banner_image }}"
                  alt="{{ banner.title ? banner.title : 'banner' }}"
                  loading="{{ component.image_loading|default('lazy') }}"
                >
              {% endif %}

              {% if component.text_on_image and (banner.title or banner.description) %}
                <article class="pro-square-images__content is-on-image {{ component.center_text ? 'is-centered' : '' }}">
                  <div class="premium-title-box {{ component.title_box_class }}">
                    {% if banner.title %}
                      <h3 class="premium-title" style="font-size: {{ title_size_map[component.title_size|default('md')]|default('18px') }};">
                        {{ banner.title|raw }}
                      </h3>
                    {% endif %}
                    {% if banner.description %}
                      <div class="premium-subtitle">{{ banner.description|raw }}</div>
                    {% endif %}
                  </div>
                </article>
              {% endif %}
            </a>

            {% if not component.text_on_image and (banner.title or banner.description) %}
  <article class="pro-square-images__content is-below-image {{ component.center_text ? 'is-centered' : '' }}">
    <div class="premium-title-box {{ component.title_box_class }}">
      {% if banner.title %}
        <h3 class="premium-title" style="font-size: {{ title_size_map[component.title_size|default('md')]|default('18px') }};">
          {{ banner.title|raw }}
        </h3>
      {% endif %}

      {% if banner.description %}
        <div class="premium-subtitle">{{ banner.description|raw }}</div>
      {% endif %}
    </div>
  </article>
{% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </salla-slider>
{% endif %}

</section>
{% endif %}