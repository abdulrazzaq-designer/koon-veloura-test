{# VELOURA HOME TAB ASSIGNMENT START #}
{% set veloura_home_tab_key = component.veloura_home_tab_name_2026|default('') %}
{% if veloura_home_tab_key.value is defined %}{% set veloura_home_tab_key = veloura_home_tab_key.value %}{% endif %}
{% if not veloura_home_tab_key %}{% set veloura_home_tab_key = 'always' %}{% endif %}
{# VELOURA HOME TAB ASSIGNMENT END #}

{# ==========================================================================
   واجهة المتجر (هيرو) — فيلورا

   قسم واحد مركّب من طبقات، كل طبقة مستقلة ويمكن إطفاؤها: خلفية (صورة أو
   تدرّج أو فيديو)، شريحة، عنوان بكلمة تتبدّل، وصف، عدّاد، بحث وشرائح «الأكثر
   بحثًا»، زران، شارات ثقة، أرقام تعدّ تصاعديًا، صورة جانبية عائمة، وشريط
   شعارات. ما يُكتب في الإعدادات هو ما يظهر — لا نصوص وهمية ولا أرقام مفبركة.

   الستايل والسكربت inline عن قصد: ملفات SCSS/JS تمر ببناء وCDN، والقالب
   ينشر فورًا. وهذا القسم هو أول ما يُرسم في الصفحة، فصورته تُحمّل فورًا
   (لا كسولة) لأنها عنصر LCP.
   ========================================================================== #}

{% macro pick(v, fallback) %}
  {%- set r = v -%}
  {%- if r.selected is defined %}{% set r = r.selected %}{% endif -%}
  {%- if r is iterable and r.value is not defined %}{% set r = r|first %}{% endif -%}
  {%- if r.value is defined %}{% set r = r.value %}{% endif -%}
  {%- if r is iterable %}{% set r = fallback %}{% endif -%}
  {%- if r is same as(null) or r == '' %}{% set r = fallback %}{% endif -%}
  {{- r -}}
{% endmacro %}

{% if not component.hero_hide %}

  {% set hero_side %}{{ _self.pick(component.hero_media_side, 'right') }}{% endset %}
  {% set hero_side = hero_side|trim %}
  {% if hero_side not in ['right', 'left', 'none'] %}{% set hero_side = 'right' %}{% endif %}

  {% set hero_mob %}{{ _self.pick(component.hero_mobile_media, 'below') }}{% endset %}
  {% set hero_mob = hero_mob|trim %}
  {% if hero_mob not in ['above', 'below', 'hidden'] %}{% set hero_mob = 'below' %}{% endif %}

  {% set hero_align %}{{ _self.pick(component.hero_text_align, 'right') }}{% endset %}
  {% set hero_align = hero_align|trim %}
  {% if hero_align not in ['right', 'center', 'left'] %}{% set hero_align = 'right' %}{% endif %}

  {% set hero_h %}{{ _self.pick(component.hero_height, 'tall') }}{% endset %}
  {% set hero_h = hero_h|trim %}
  {% if hero_h not in ['auto', 'tall', 'full'] %}{% set hero_h = 'tall' %}{% endif %}

  {% set hero_bg %}{{ _self.pick(component.hero_bg_type, 'image') }}{% endset %}
  {% set hero_bg = hero_bg|trim %}
  {% if hero_bg not in ['image', 'gradient', 'video'] %}{% set hero_bg = 'image' %}{% endif %}

  {# الحواف: رقم بالبيكسل، والمفاتيح القديمة تبقى مفهومة، و«40» = دائري. #}
  {% set hero_radius_key %}{{ _self.pick(component.hero_radius, 28) }}{% endset %}
  {% set hero_radius_key = hero_radius_key|trim %}
  {% set hero_radius_map = {'sharp':'0px','soft':'10px','medium':'18px','large':'28px','round':'999px','40':'999px'} %}
  {% set hero_radius = hero_radius_map[hero_radius_key]|default((hero_radius_key == '' ? '28' : hero_radius_key) ~ 'px') %}

  {% set hero_overlay_raw %}{{ _self.pick(component.hero_overlay, 45) }}{% endset %}
  {% set hero_overlay = hero_overlay_raw|trim %}
  {% if hero_overlay == '' %}{% set hero_overlay = '45' %}{% endif %}

  {% set hero_logo_speed %}{{ _self.pick(component.hero_logos_speed, 28) }}{% endset %}
  {% set hero_logo_speed = hero_logo_speed|trim %}
  {% if hero_logo_speed == '' %}{% set hero_logo_speed = '28' %}{% endif %}

  {% set hero_bg_image = component.hero_bg_image %}
  {% set hero_bg_image_m = component.hero_bg_image_mobile ?: hero_bg_image %}
  {% set hero_words_raw = component.hero_words|default('') %}
  {% set hero_words = hero_words_raw ? hero_words_raw|replace({'،': ','})|split(',') : [] %}
  {% set hero_title_text = component.hero_title|default('') %}
  {% set hero_title_has_slot = '{}' in hero_title_text %}

<style>
/* ==========================================================================
   واجهة المتجر (هيرو) — كل شيء مقصور على .veloura-hero
   ========================================================================== */
.veloura-hero,
.veloura-hero *,
.veloura-hero *::before,
.veloura-hero *::after { box-sizing: border-box; }

.veloura-hero {
  --hero-ink: #ffffff;
  --hero-gap: clamp(18px, 3vw, 34px);

  position: relative;
  isolation: isolate;
  overflow: hidden;
  display: flex;
  align-items: center;
  padding-block: clamp(28px, 5vw, 72px) !important;
  padding-inline: 0 !important;
  border-radius: var(--hero-radius, 28px);
  background: transparent;
}

.veloura-hero.hero--h-tall { min-height: clamp(480px, 70vh, 740px); }
.veloura-hero.hero--h-full { min-height: 100vh; min-height: 100svh; }
.veloura-hero.hero--full-width { border-radius: 0; }

/* ----------------------------------------------------------- الخلفية --- */
.veloura-hero .hero__bg {
  position: absolute;
  inset: 0;
  z-index: -2;
  overflow: hidden;
  border-radius: inherit;
  background: linear-gradient(135deg, var(--hero-grad-from, #1e1b4b), var(--hero-grad-to, #0f172a));
  background-size: 180% 180%;
}

.veloura-hero.hero--grad-animate .hero__bg { animation: hero-grad 18s ease-in-out infinite; }

@keyframes hero-grad {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

.veloura-hero .hero__bg img,
.veloura-hero .hero__bg video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.veloura-hero .hero__scrim {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to top, rgba(0, 0, 0, .55), rgba(0, 0, 0, 0) 62%),
    rgba(0, 0, 0, calc(var(--hero-overlay, 45) / 100));
}

/* ------------------------------------------------------------ الشبكة --- */
.veloura-hero .hero__wrap { position: relative; z-index: 1; width: 100%; }
.veloura-hero.hero--full-width .hero__wrap { max-width: none; padding-inline: clamp(16px, 4vw, 48px); }

.veloura-hero .hero__grid {
  display: flex;
  align-items: center;
  gap: clamp(20px, 4vw, 56px);
}

.veloura-hero .hero__body {
  flex: 1 1 56%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--hero-gap);
  color: var(--hero-ink);
}

.veloura-hero .hero__media { flex: 1 1 44%; min-width: 0; position: relative; }

/* الترتيب فيزيائي: «يمين» تعني يمين الشاشة مهما كان اتجاه المتجر. */
.veloura-hero.hero--media-right .hero__media { order: 0; }
.veloura-hero.hero--media-right .hero__body { order: 1; }
.veloura-hero.hero--media-left .hero__media { order: 1; }
.veloura-hero.hero--media-left .hero__body { order: 0; }

html[dir="ltr"] .veloura-hero.hero--media-right .hero__media { order: 1; }
html[dir="ltr"] .veloura-hero.hero--media-right .hero__body { order: 0; }
html[dir="ltr"] .veloura-hero.hero--media-left .hero__media { order: 0; }
html[dir="ltr"] .veloura-hero.hero--media-left .hero__body { order: 1; }

.veloura-hero.hero--media-none .hero__body { flex: 1 1 100%; max-width: 820px; margin-inline: auto; }

/* المحاذاة */
.veloura-hero.hero--align-right .hero__body { align-items: flex-start; text-align: right; }
.veloura-hero.hero--align-left .hero__body { align-items: flex-end; text-align: left; }
.veloura-hero.hero--align-center .hero__body { align-items: center; text-align: center; }

html[dir="ltr"] .veloura-hero.hero--align-right .hero__body { align-items: flex-end; }
html[dir="ltr"] .veloura-hero.hero--align-left .hero__body { align-items: flex-start; }

/* ----------------------------------------------------------- الشريحة --- */
.veloura-hero .hero__chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 16px;
  border-radius: 999px;
  border: 1px solid color-mix(in srgb, var(--hero-chip, #22d3ee) 45%, transparent);
  background: color-mix(in srgb, var(--hero-chip, #22d3ee) 16%, transparent);
  color: var(--hero-chip, #22d3ee);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .02em;
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
}

.veloura-hero .hero__chip::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: currentColor;
  box-shadow: 0 0 0 0 currentColor;
  animation: hero-pulse 2.2s ease-out infinite;
}

@keyframes hero-pulse {
  0% { box-shadow: 0 0 0 0 currentColor; opacity: 1; }
  70% { box-shadow: 0 0 0 9px transparent; opacity: .75; }
  100% { box-shadow: 0 0 0 0 transparent; opacity: 1; }
}

/* ------------------------------------------------------------ النصوص --- */
.veloura-hero .hero__title {
  margin: 0;
  font-size: clamp(26px, 5.2vw, 58px);
  font-weight: 900;
  line-height: 1.15;
  color: var(--hero-title, #fff);
  text-shadow: 0 2px 22px rgba(0, 0, 0, .35);
}

.veloura-hero .hero__rotator {
  display: inline-block;
  min-width: 1ch;
  color: var(--hero-word, #a78bfa);
}

.veloura-hero .hero__rotator span {
  display: inline-block;
  animation: hero-word .5s ease both;
}

@keyframes hero-word {
  from { opacity: 0; transform: translateY(.35em) rotateX(-40deg); }
  to { opacity: 1; transform: none; }
}

.veloura-hero .hero__sub {
  margin: 0;
  max-width: 52ch;
  font-size: clamp(13px, 1.6vw, 18px);
  line-height: 1.85;
  color: var(--hero-sub, #e2e8f0);
  opacity: .92;
}

/* ------------------------------------------------------------ العدّاد --- */
.veloura-hero .hero__countdown { display: flex; gap: clamp(6px, .9vw, 12px); }

.veloura-hero .hero__countdown > div {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  min-width: clamp(52px, 6vw, 76px);
  padding: clamp(7px, .9vw, 12px) clamp(8px, 1vw, 14px);
  border-radius: var(--hero-radius, 16px);
  border: 1px solid rgba(255, 255, 255, .2);
  background: rgba(0, 0, 0, .34);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  line-height: 1;
}

.veloura-hero .hero__countdown strong { font-size: clamp(16px, 2.1vw, 26px); font-weight: 900; font-variant-numeric: tabular-nums; }
.veloura-hero .hero__countdown span { font-size: clamp(9px, 1vw, 12px); opacity: .75; font-weight: 600; }

/* ------------------------------------------------------------- البحث --- */
.veloura-hero .hero__searchwrap { width: 100%; max-width: 620px; display: flex; flex-direction: column; gap: 12px; }

.veloura-hero .hero__search {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 7px 7px 7px 7px;
  padding-inline-start: 16px;
  border-radius: var(--hero-radius, 999px);
  border: 1px solid rgba(255, 255, 255, .22);
  background: rgba(255, 255, 255, .12);
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
  box-shadow: 0 18px 40px rgba(0, 0, 0, .28);
}

.veloura-hero .hero__search i { font-size: 18px; opacity: .8; flex: 0 0 auto; }

.veloura-hero .hero__search input {
  flex: 1 1 auto;
  min-width: 0;
  padding: 10px 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--hero-ink);
  font-size: 15px;
  font-family: inherit;
}

.veloura-hero .hero__search input::placeholder { color: color-mix(in srgb, var(--hero-ink) 62%, transparent); }

.veloura-hero .hero__search button {
  flex: 0 0 auto;
  padding: 11px 22px;
  border: 0;
  border-radius: var(--hero-radius, 999px);
  background: var(--hero-btn1-bg, #7c3aed);
  color: var(--hero-btn1-color, #fff);
  font-size: 14px;
  font-weight: 800;
  font-family: inherit;
  cursor: pointer;
}

.veloura-hero .hero__tags { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 12px; }

/* صفّ الشرائح داخل غلاف البحث يأخذ عرضه كاملاً، فمحاذاته تُكتب له صراحة. */
.veloura-hero.hero--align-center .hero__tags { justify-content: center; }
.veloura-hero.hero--align-left .hero__tags { justify-content: flex-end; }
html[dir="ltr"] .veloura-hero.hero--align-left .hero__tags { justify-content: flex-start; }
html[dir="ltr"] .veloura-hero.hero--align-right .hero__tags { justify-content: flex-end; }
.veloura-hero .hero__tags b { font-weight: 700; opacity: .7; }

.veloura-hero .hero__tag {
  display: inline-flex;
  align-items: center;
  padding: 6px 13px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, .2);
  background: rgba(255, 255, 255, .08);
  color: var(--hero-ink);
  font-weight: 700;
  text-decoration: none;
  transition: background-color .25s ease, transform .25s ease;
}

.veloura-hero .hero__tag:hover { background: rgba(255, 255, 255, .18); transform: translateY(-2px); }

/* ------------------------------------------------------------ الأزرار --- */
.veloura-hero .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; }

.veloura-hero .hero__btn {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: clamp(11px, 1.3vw, 15px) clamp(20px, 2.4vw, 30px);
  border-radius: var(--hero-radius, 14px);
  border: 1.5px solid transparent;
  font-size: clamp(13px, 1.4vw, 15px);
  font-weight: 800;
  line-height: 1;
  text-decoration: none;
  transition: transform .25s ease, box-shadow .25s ease;
}

.veloura-hero .hero__btn:hover { transform: translateY(-2px); }
.veloura-hero .hero__btn--1 { background: var(--hero-btn1-bg, #7c3aed); color: var(--hero-btn1-color, #fff); box-shadow: 0 14px 30px color-mix(in srgb, var(--hero-btn1-bg, #7c3aed) 38%, transparent); }
.veloura-hero .hero__btn--2 { background: rgba(255, 255, 255, .14); color: var(--hero-ink); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
.veloura-hero .hero__btn--2.is-outline { background: transparent; border-color: rgba(255, 255, 255, .55); }

/* ------------------------------------------------------- شارات الثقة --- */
.veloura-hero .hero__badges { display: flex; flex-wrap: wrap; gap: clamp(10px, 1.6vw, 20px); }

.veloura-hero .hero__badge {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 14px;
  border-radius: var(--hero-radius, 14px);
  border: 1px solid rgba(255, 255, 255, .14);
  background: rgba(255, 255, 255, .07);
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
}

.veloura-hero .hero__badge i { font-size: 19px; opacity: .9; flex: 0 0 auto; }
.veloura-hero .hero__badge strong { display: block; font-size: 13px; font-weight: 800; }
.veloura-hero .hero__badge span { display: block; font-size: 11px; opacity: .7; }

/* ------------------------------------------------------------ الأرقام --- */
.veloura-hero .hero__stats { display: flex; flex-wrap: wrap; gap: clamp(18px, 3vw, 46px); }
.veloura-hero .hero__stat strong { display: block; font-size: clamp(20px, 2.8vw, 34px); font-weight: 900; font-variant-numeric: tabular-nums; }
.veloura-hero .hero__stat span { display: block; font-size: 12px; opacity: .72; margin-top: 2px; }

/* ------------------------------------------------------ الصورة الجانبية --- */
.veloura-hero .hero__media img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: var(--hero-radius, 28px);
  position: relative;
  z-index: 1;
}

.veloura-hero.hero--float .hero__media img { animation: hero-float 6.5s ease-in-out infinite; }

@keyframes hero-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-14px); }
}

.veloura-hero .hero__glow {
  position: absolute;
  inset: 8% 6%;
  z-index: 0;
  border-radius: 999px;
  background: radial-gradient(closest-side, color-mix(in srgb, var(--hero-glow, #7c3aed) 65%, transparent), transparent);
  filter: blur(46px);
}

/* ----------------------------------------------------- شريط الشعارات --- */
.veloura-hero .hero__logos {
  position: relative;
  margin-top: clamp(22px, 3.4vw, 44px);
  overflow: hidden;
  -webkit-mask-image: linear-gradient(to left, transparent, #000 8%, #000 92%, transparent);
  mask-image: linear-gradient(to left, transparent, #000 8%, #000 92%, transparent);
}

.veloura-hero .hero__logos-track {
  display: flex;
  align-items: center;
  gap: clamp(26px, 4vw, 60px);
  width: max-content;
  animation: hero-marquee var(--hero-logo-speed, 28s) linear infinite;
}

.veloura-hero .hero__logos img { height: clamp(22px, 2.6vw, 34px); width: auto; opacity: .62; filter: grayscale(1) brightness(1.7); }

@keyframes hero-marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

html[dir="rtl"] .veloura-hero .hero__logos-track { animation-name: hero-marquee-rtl; }

@keyframes hero-marquee-rtl {
  from { transform: translateX(0); }
  to { transform: translateX(50%); }
}

/* ------------------------------------------------------ مؤشر التمرير --- */
.veloura-hero .hero__cue {
  position: absolute;
  z-index: 1;
  bottom: 14px;
  inset-inline: 0;
  margin-inline: auto;
  width: 26px;
  height: 42px;
  border-radius: 999px;
  border: 2px solid rgba(255, 255, 255, .35);
}

.veloura-hero .hero__cue::before {
  content: "";
  position: absolute;
  top: 7px;
  inset-inline: 0;
  margin-inline: auto;
  width: 4px;
  height: 8px;
  border-radius: 999px;
  background: rgba(255, 255, 255, .8);
  animation: hero-cue 1.8s ease-in-out infinite;
}

@keyframes hero-cue {
  0%, 100% { transform: translateY(0); opacity: 1; }
  60% { transform: translateY(13px); opacity: .25; }
}

/* ------------------------------------------------------------- الظهور --- */
.veloura-hero .hero__body > *,
.veloura-hero .hero__media {
  opacity: 0;
  transform: translateY(16px);
  transition: opacity .7s ease, transform .7s ease;
}

.veloura-hero .hero__body > *:nth-child(2) { transition-delay: .07s; }
.veloura-hero .hero__body > *:nth-child(3) { transition-delay: .14s; }
.veloura-hero .hero__body > *:nth-child(4) { transition-delay: .21s; }
.veloura-hero .hero__body > *:nth-child(5) { transition-delay: .28s; }
.veloura-hero .hero__body > *:nth-child(6) { transition-delay: .35s; }
.veloura-hero .hero__media { transition-delay: .1s; }

.veloura-hero.is-inview .hero__body > *,
.veloura-hero.is-inview .hero__media,
.veloura-hero.no-js .hero__body > *,
.veloura-hero.no-js .hero__media { opacity: 1; transform: none; }

/* ------------------------------------------------------------- الجوال --- */
@media (max-width: 1023px) {
  .veloura-hero .hero__grid { flex-direction: column; align-items: stretch; }
  .veloura-hero .hero__media,
  .veloura-hero .hero__body { flex: 1 1 auto; order: 0 !important; }
  .veloura-hero.hero--mob-above .hero__media { order: -1 !important; }
  .veloura-hero.hero--mob-hidden .hero__media { display: none; }
  .veloura-hero.hero--h-tall { min-height: clamp(440px, 76vh, 640px); }
  .veloura-hero .hero__sub { font-size: 13px; }
  .veloura-hero .hero__search button { padding: 10px 16px; font-size: 13px; }
  .veloura-hero .hero__badge span { display: none; }
  .veloura-hero .hero__cue { display: none; }
}

@media (max-width: 560px) {
  .veloura-hero .hero__badges { gap: 8px; }
  .veloura-hero .hero__badge { padding: 8px 11px; }
  .veloura-hero .hero__stats { gap: 18px; }
}

@media (prefers-reduced-motion: reduce) {
  .veloura-hero *,
  .veloura-hero *::before { animation: none !important; transition: none !important; }
  .veloura-hero .hero__body > *,
  .veloura-hero .hero__media { opacity: 1 !important; transform: none !important; }
}
</style>

<section
  data-veloura-home-tab="{{ veloura_home_tab_key|e }}"
  id="veloura-hero-{{ position }}"
  class="s-block veloura-hero no-js
    hero--media-{{ hero_side }}
    hero--mob-{{ hero_mob }}
    hero--align-{{ hero_align }}
    hero--h-{{ hero_h }}
    hero--bg-{{ hero_bg }}
    {{ component.hero_full_width ? 'hero--full-width' : '' }}
    {{ component.hero_grad_animate ? 'hero--grad-animate' : '' }}
    {{ component.hero_media_float ? 'hero--float' : '' }}
    {{ component.hero_mobile_only ? 'veloura-mobile-only' : '' }}
    {{ component.hero_desktop_only ? 'veloura-desktop-only' : '' }}
    {{ component.hero_custom_classes }}"
  style="
    --hero-radius: {{ hero_radius }};
    --hero-overlay: {{ hero_overlay }};
    --hero-grad-from: {{ component.hero_grad_from|default('#1e1b4b') }};
    --hero-grad-to: {{ component.hero_grad_to|default('#0f172a') }};
    --hero-chip: {{ component.hero_chip_color|default('#22d3ee') }};
    --hero-title: {{ component.hero_title_color|default('#ffffff') }};
    --hero-word: {{ component.hero_words_color|default('#a78bfa') }};
    --hero-sub: {{ component.hero_subtitle_color|default('#e2e8f0') }};
    --hero-btn1-bg: {{ component.hero_btn1_bg|default('#7c3aed') }};
    --hero-btn1-color: {{ component.hero_btn1_color|default('#ffffff') }};
    --hero-glow: {{ component.hero_media_glow_color|default('#7c3aed') }};
    --hero-logo-speed: {{ hero_logo_speed }}s;
  "
>
  <div class="hero__bg">
    {% if hero_bg == 'video' and component.hero_bg_video %}
      <video data-hero-video data-src="{{ component.hero_bg_video }}" muted loop playsinline preload="none"
        {% if hero_bg_image %}poster="{{ hero_bg_image }}"{% endif %}></video>
    {% elseif hero_bg == 'image' and hero_bg_image %}
      <picture>
        <source media="(max-width: 767px)" srcset="{{ hero_bg_image_m }}">
        {# fetchpriority=high وبدون lazy: هذه صورة الـ LCP #}
        <img src="{{ hero_bg_image }}" alt="" fetchpriority="high" decoding="async">
      </picture>
    {% endif %}
    <span class="hero__scrim"></span>
  </div>

  <div class="hero__wrap {{ component.hero_full_width ? '' : 'container' }}">
    <div class="hero__grid">

      <div class="hero__body">
        {% if component.hero_chip_text %}
          <span class="hero__chip">{{ component.hero_chip_text }}</span>
        {% endif %}

        {% if hero_title_text %}
          <h1 class="hero__title">
            {% if hero_words|length and hero_title_has_slot %}
              {{ hero_title_text|split('{}')[0] }}<span class="hero__rotator" data-hero-words="{{ hero_words|join('|')|e('html_attr') }}"><span>{{ hero_words[0]|trim }}</span></span>{{ hero_title_text|split('{}')[1]|default('') }}
            {% else %}
              {{ hero_title_text }}
              {% if hero_words|length %}
                <span class="hero__rotator" data-hero-words="{{ hero_words|join('|')|e('html_attr') }}"><span>{{ hero_words[0]|trim }}</span></span>
              {% endif %}
            {% endif %}
          </h1>
        {% endif %}

        {% if component.hero_subtitle %}
          <p class="hero__sub">{{ component.hero_subtitle }}</p>
        {% endif %}

        {% if component.hero_countdown_enabled and component.hero_countdown_date %}
          <div class="hero__countdown" data-hero-countdown="{{ component.hero_countdown_date }}">
            <div><strong data-days>0</strong><span>يوم</span></div>
            <div><strong data-hours>0</strong><span>ساعة</span></div>
            <div><strong data-minutes>0</strong><span>دقيقة</span></div>
            <div><strong data-seconds>0</strong><span>ثانية</span></div>
          </div>
        {% endif %}

        {% if component.hero_search_enabled %}
          <div class="hero__searchwrap">
            <form class="hero__search" action="/search" method="get" role="search">
              <i class="sicon-search" aria-hidden="true"></i>
              <input type="search" name="q" autocomplete="off"
                placeholder="{{ component.hero_search_placeholder|default('ابحث عن منتج أو خدمة…') }}"
                aria-label="{{ component.hero_search_placeholder|default('بحث') }}">
              <button type="submit">بحث</button>
            </form>

            {% if component.hero_top_searches|length %}
              <div class="hero__tags">
                {% if component.hero_top_searches_title %}<b>{{ component.hero_top_searches_title }}</b>{% endif %}
                {% for tag in component.hero_top_searches %}
                  {% if tag.label %}
                    <a class="hero__tag" href="{{ tag.url ?: ('/search?q=' ~ (tag.query ?: tag.label)|url_encode) }}">{{ tag.label }}</a>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% if component.hero_btn1_text or component.hero_btn2_text %}
          <div class="hero__cta">
            {% if component.hero_btn1_text %}
              <a class="hero__btn hero__btn--1" href="{{ component.hero_btn1_url ?: '#' }}">
                {% if component.hero_btn1_icon %}<i class="{{ component.hero_btn1_icon }}" aria-hidden="true"></i>{% endif %}
                {{ component.hero_btn1_text }}
              </a>
            {% endif %}

            {% if component.hero_btn2_text %}
              <a class="hero__btn hero__btn--2 {{ component.hero_btn2_outline ? 'is-outline' : '' }}" href="{{ component.hero_btn2_url ?: '#' }}">
                {% if component.hero_btn2_icon %}<i class="{{ component.hero_btn2_icon }}" aria-hidden="true"></i>{% endif %}
                {{ component.hero_btn2_text }}
              </a>
            {% endif %}
          </div>
        {% endif %}

        {% if component.hero_badges|length %}
          <div class="hero__badges">
            {% for badge in component.hero_badges %}
              {% if badge.title %}
                <div class="hero__badge">
                  {% if badge.icon %}<i class="{{ badge.icon }}" aria-hidden="true"></i>{% endif %}
                  <div>
                    <strong>{{ badge.title }}</strong>
                    {% if badge.subtitle %}<span>{{ badge.subtitle }}</span>{% endif %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if component.hero_stats|length %}
          <div class="hero__stats">
            {% for stat in component.hero_stats %}
              {% if stat.number %}
                <div class="hero__stat">
                  <strong {% if component.hero_stats_count_up %}data-hero-count="{{ stat.number }}"{% endif %}>{{ component.hero_stats_count_up ? '0' : stat.number }}{{ stat.suffix|default('') }}</strong>
                  {% if stat.label %}<span>{{ stat.label }}</span>{% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>

      {% if hero_side != 'none' and component.hero_media_image %}
        <div class="hero__media">
          {% if component.hero_media_glow %}<span class="hero__glow" aria-hidden="true"></span>{% endif %}
          <img src="{{ component.hero_media_image }}" alt="{{ hero_title_text }}" fetchpriority="high" decoding="async">
        </div>
      {% endif %}

    </div>

    {% if component.hero_logos|length %}
      <div class="hero__logos">
        <div class="hero__logos-track">
          {% for logo in component.hero_logos %}
            {% if logo.image %}<img src="{{ logo.image }}" alt="" loading="lazy" decoding="async">{% endif %}
          {% endfor %}
          {# نسخة ثانية حتى يدور الشريط بلا فجوة #}
          {% for logo in component.hero_logos %}
            {% if logo.image %}<img src="{{ logo.image }}" alt="" aria-hidden="true" loading="lazy" decoding="async">{% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>

  {% if component.hero_scroll_cue and hero_h != 'auto' %}
    <span class="hero__cue" aria-hidden="true"></span>
  {% endif %}
</section>

<script>
(function () {
  var root = document.getElementById('veloura-hero-{{ position }}');
  if (!root) return;
  root.classList.remove('no-js');

  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* الظهور */
  if (!('IntersectionObserver' in window)) {
    root.classList.add('is-inview');
  } else {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        root.classList.add('is-inview');
        startCounters();
        io.unobserve(root);
      });
    }, { threshold: 0.15 });
    io.observe(root);
  }

  /* الأرقام: تعدّ مرة واحدة عند أول ظهور */
  var counted = false;
  function startCounters() {
    if (counted) return;
    counted = true;
    root.querySelectorAll('[data-hero-count]').forEach(function (el) {
      var raw = String(el.getAttribute('data-hero-count')).replace(/[^\d.]/g, '');
      var target = parseFloat(raw);
      if (!isFinite(target)) return;
      var suffix = el.textContent.replace(/^0/, '');
      if (reduced) { el.textContent = raw + suffix; return; }
      var start = performance.now(), dur = 1400;
      (function step(now) {
        var p = Math.min(1, (now - start) / dur);
        var eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(target * eased).toLocaleString('en-US') + suffix;
        if (p < 1) requestAnimationFrame(step);
      })(start);
    });
  }

  /* الكلمة المتبدّلة */
  var rot = root.querySelector('[data-hero-words]');
  if (rot && !reduced) {
    var words = (rot.getAttribute('data-hero-words') || '').split('|')
      .map(function (w) { return w.trim(); }).filter(Boolean);
    if (words.length > 1) {
      var i = 0;
      setInterval(function () {
        i = (i + 1) % words.length;
        rot.innerHTML = '<span>' + words[i].replace(/[<>&]/g, '') + '</span>';
      }, 2600);
    }
  }

  /* العدّاد التنازلي — نفس صيغة تاريخ سلة المستعملة في البنرات */
  var cd = root.querySelector('[data-hero-countdown]');
  if (cd) {
    var parts = String(cd.getAttribute('data-hero-countdown')).replace(/"/g, '').trim().split('-');
    var end = new Date(parseInt(parts[2], 10), parseInt(parts[1], 10) - 1, parseInt(parts[0], 10), 23, 59, 59).getTime();
    var tick = function () {
      var left = end - Date.now();
      if (!isFinite(left) || left <= 0) { cd.style.display = 'none'; return; }
      cd.querySelector('[data-days]').textContent = Math.floor(left / 86400000);
      cd.querySelector('[data-hours]').textContent = Math.floor(left / 3600000) % 24;
      cd.querySelector('[data-minutes]').textContent = Math.floor(left / 60000) % 60;
      cd.querySelector('[data-seconds]').textContent = Math.floor(left / 1000) % 60;
    };
    tick();
    setInterval(tick, 1000);
  }

  /* الفيديو: لا يُحمَّل على الجوال ولا لمن يفضّل تقليل الحركة */
  var vid = root.querySelector('[data-hero-video]');
  if (vid && !reduced && window.innerWidth >= 768) {
    vid.src = vid.getAttribute('data-src');
    vid.play().catch(function () {});
  }
})();
</script>
{% endif %}