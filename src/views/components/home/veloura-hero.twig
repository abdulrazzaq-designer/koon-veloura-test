{# VELOURA HOME TAB ASSIGNMENT START #}
{% set veloura_home_tab_key = component.veloura_home_tab_name_2026|default('') %}
{% if veloura_home_tab_key.value is defined %}{% set veloura_home_tab_key = veloura_home_tab_key.value %}{% endif %}
{% if not veloura_home_tab_key %}{% set veloura_home_tab_key = 'always' %}{% endif %}
{# VELOURA HOME TAB ASSIGNMENT END #}

{# ==========================================================================
   واجهة المتجر (هيرو) — فيلورا

   قسم واحد مركّب من طبقات، كل طبقة مستقلة ويمكن إطفاؤها: خلفية (صورة أو
   تدرّج أو فيديو)، شريحة، عنوان بكلمة تتبدّل، وصف، عدّاد، بحث وشرائح «الأكثر
   بحثًا»، زران، شارات ثقة، أرقام تعدّ تصاعديًا، صورة جانبية عائمة، وشريط
   شعارات. ما يُكتب في الإعدادات هو ما يظهر — لا نصوص وهمية ولا أرقام مفبركة.

   الستايل والسكربت inline عن قصد: ملفات SCSS/JS تمر ببناء وCDN، والقالب
   ينشر فورًا. وهذا القسم هو أول ما يُرسم في الصفحة، فصورته تُحمّل فورًا
   (لا كسولة) لأنها عنصر LCP.
   ========================================================================== #}

{% macro pick(v, fallback) %}
  {%- set r = v -%}
  {%- if r.selected is defined %}{% set r = r.selected %}{% endif -%}
  {%- if r is iterable and r.value is not defined %}{% set r = r|first %}{% endif -%}
  {%- if r.value is defined %}{% set r = r.value %}{% endif -%}
  {%- if r is iterable %}{% set r = fallback %}{% endif -%}
  {%- if r is same as(null) or r == '' %}{% set r = fallback %}{% endif -%}
  {{- r -}}
{% endmacro %}

{% if not component.hero_hide %}

  {% set hero_side %}{{ _self.pick(component.hero_media_side, 'right') }}{% endset %}
  {% set hero_side = hero_side|trim %}
  {% if hero_side not in ['right', 'left', 'none'] %}{% set hero_side = 'right' %}{% endif %}

  {% set hero_mob %}{{ _self.pick(component.hero_mobile_media, 'below') }}{% endset %}
  {% set hero_mob = hero_mob|trim %}
  {% if hero_mob not in ['above', 'below', 'hidden'] %}{% set hero_mob = 'below' %}{% endif %}

  {% set hero_align %}{{ _self.pick(component.hero_text_align, 'right') }}{% endset %}
  {% set hero_align = hero_align|trim %}
  {% if hero_align not in ['right', 'center', 'left'] %}{% set hero_align = 'right' %}{% endif %}

  {% set hero_h %}{{ _self.pick(component.hero_height, 'tall') }}{% endset %}
  {% set hero_h = hero_h|trim %}
  {% if hero_h not in ['auto', 'tall', 'full'] %}{% set hero_h = 'tall' %}{% endif %}

  {% set hero_bg %}{{ _self.pick(component.hero_bg_type, 'image') }}{% endset %}
  {% set hero_bg = hero_bg|trim %}
  {% if hero_bg not in ['image', 'gradient', 'video'] %}{% set hero_bg = 'image' %}{% endif %}

  {# الحواف: رقم بالبيكسل، والمفاتيح القديمة تبقى مفهومة، و«40» = دائري. #}
  {% set hero_radius_key %}{{ _self.pick(component.hero_radius, 28) }}{% endset %}
  {% set hero_radius_key = hero_radius_key|trim %}
  {% set hero_radius_map = {'sharp':'0px','soft':'10px','medium':'18px','large':'28px','round':'999px','40':'999px'} %}
  {% set hero_radius = hero_radius_map[hero_radius_key]|default((hero_radius_key == '' ? '28' : hero_radius_key) ~ 'px') %}

  {% set hero_align_m %}{{ _self.pick(component.hero_text_align_mobile, 'inherit') }}{% endset %}
  {% set hero_align_m = hero_align_m|trim %}
  {% if hero_align_m not in ['inherit', 'right', 'center', 'left'] %}{% set hero_align_m = 'inherit' %}{% endif %}
  {% if hero_align_m == 'inherit' %}{% set hero_align_m = hero_align %}{% endif %}

  {% set hero_inner_key %}{{ _self.pick(component.hero_inner_radius, 16) }}{% endset %}
  {% set hero_inner_key = hero_inner_key|trim %}
  {% set hero_inner = hero_radius_map[hero_inner_key]|default((hero_inner_key == '' ? '16' : hero_inner_key) ~ 'px') %}

  {% set hero_gutter_raw %}{{ _self.pick(component.hero_spacing, 10) }}{% endset %}
  {% set hero_gutter = hero_gutter_raw|trim %}
  {% if hero_gutter == '' %}{% set hero_gutter = '10' %}{% endif %}

  {% set hero_overlay_raw %}{{ _self.pick(component.hero_overlay, 45) }}{% endset %}
  {% set hero_overlay = hero_overlay_raw|trim %}
  {% if hero_overlay == '' %}{% set hero_overlay = '45' %}{% endif %}

  {% set hero_logo_speed %}{{ _self.pick(component.hero_logos_speed, 28) }}{% endset %}
  {% set hero_logo_speed = hero_logo_speed|trim %}
  {% if hero_logo_speed == '' %}{% set hero_logo_speed = '28' %}{% endif %}
  {# أقل من ثماني ثوانٍ يصير الشريط ضبابياً، فنرفعه مهما كتب في الإعداد. #}
  {% if hero_logo_speed in ['0','1','2','3','4','5','6','7'] %}{% set hero_logo_speed = '8' %}{% endif %}

  {% set hero_bg_image = component.hero_bg_image %}
  {% set hero_bg_image_m = component.hero_bg_image_mobile ?: hero_bg_image %}
  {% set hero_words_raw = component.hero_words|default('') %}
  {% set hero_words = hero_words_raw ? hero_words_raw|replace({'،': ','})|split(',') : [] %}
  {% set hero_title_text = component.hero_title|default('') %}
  {% set hero_title_has_slot = '{}' in hero_title_text %}

<style>
/* ==========================================================================
   واجهة المتجر (هيرو) — كل شيء مقصور على .veloura-hero
   ========================================================================== */
.veloura-hero,
.veloura-hero *,
.veloura-hero *::before,
.veloura-hero *::after { box-sizing: border-box; }

.veloura-hero {
  --hero-ink: #ffffff;
  --hero-gap: clamp(18px, 3vw, 34px);

  position: relative;
  isolation: isolate;
  overflow: hidden;
  display: flex;
  align-items: center;
  padding-block: clamp(28px, 5vw, 72px) !important;
  padding-inline: 0 !important;
  border-radius: var(--hero-radius, 28px);
  background: transparent;
}

.veloura-hero.hero--h-tall { min-height: clamp(480px, 70vh, 740px); }
.veloura-hero.hero--h-full { min-height: 100vh; min-height: 100svh; }

/* شكل الهيرو:
   — بعرض الشاشة (الافتراضي): الخلفية تلتصق بالحافتين، ولا معنى لاستدارة
     جانبية هنا فتُلغى، ويبقى المحتوى وحده داخل الكونتينر.
   — صندوق داخل الكونتينر: القسم كله — خلفيته معه — يدخل على مقاس كونتينر
     المتجر، فتظهر استدارته وتبقى له مسافة من الحافتين. وهنا فقط تعني
     «استدارة حواف الهيرو» شيئاً مرئياً. */
.veloura-hero.hero--full-width { border-radius: 0; }

.veloura-hero.hero--boxed {
  width: 100%;
  max-width: var(--veloura-site-container-width, var(--veloura-global-container, 1280px));
  margin-inline: auto;
}

@media (max-width: 1023px) {
  .veloura-hero.hero--boxed {
    max-width: none;
    width: calc(100% - (var(--hero-gutter, var(--veloura-site-spacing, var(--veloura-global-spacing, 10px))) * 2));
  }
}

/* الدمج مع الهيدر يفترض التصاق الهيرو بالأعلى وبالحافتين، فالصندوق لا يجتمع معه. */
.veloura-hero.hero--merged.hero--boxed { max-width: none; width: 100%; border-radius: 0; }

/* ----------------------------------------------------------- الخلفية --- */
.veloura-hero .hero__bg {
  position: absolute;
  inset: 0;
  z-index: -2;
  overflow: hidden;
  border-radius: inherit;
  background: linear-gradient(135deg, var(--hero-grad-from, #1e1b4b), var(--hero-grad-to, #0f172a));
  background-size: 180% 180%;
}

.veloura-hero.hero--grad-animate .hero__bg { animation: hero-grad 18s ease-in-out infinite; }

@keyframes hero-grad {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

.veloura-hero .hero__bg img,
.veloura-hero .hero__bg video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.veloura-hero .hero__scrim {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to top, rgba(0, 0, 0, .55), rgba(0, 0, 0, 0) 62%),
    rgba(0, 0, 0, calc(var(--hero-overlay, 45) / 100));
}

/* ------------------------------------------------------------ الشبكة --- */
.veloura-hero .hero__wrap { position: relative; z-index: 1; width: 100%; }

/* الكونتينر يُكتب هنا بدل الاعتماد على .container وحده: قواعد المتجر العامة
   تفرض حشوة بـ important على كل .container تحت 1024، فلو تُركت المسافة
   المخصصة لها ما وصلت أبداً. */
body .veloura-hero.veloura-hero > .hero__wrap.container {
  width: 100%;
  margin-inline: auto !important;
  box-sizing: border-box;
  max-width: var(--veloura-global-container, 1280px) !important;
  padding-inline: var(--veloura-global-spacing, 10px) !important;
}

@media (max-width: 1023px) {
  body .veloura-hero.veloura-hero > .hero__wrap.container {
    max-width: none !important;
    padding-inline: var(--hero-gutter, var(--veloura-site-spacing, var(--veloura-global-spacing, 10px))) !important;
  }
}

@media (min-width: 1024px) {
  body .veloura-hero.veloura-hero > .hero__wrap.container {
    max-width: var(--veloura-site-container-width, var(--veloura-global-container, 1280px)) !important;
    padding-inline: var(--veloura-global-spacing, 10px) !important;
  }
}

.veloura-hero.hero--full-width .hero__wrap { max-width: none; padding-inline: clamp(16px, 4vw, 48px); }

/* ------------------------------------------------- الدمج مع الهيدر --- */
/* الهيرو يُسحب لأعلى بمقدار ارتفاع الهيدر ويعوّضه حشوة علوية بنفس المقدار،
   فيمر الهيدر فوقه بلا خلفية. الارتفاع يُقاس بالسكربت لأنه يختلف بين
   اللابتوب والجوال وبين المتاجر. وعند أول تمرير تعود خلفية الهيدر حتى
   يبقى مقروءاً فوق بقية الصفحة. */
.veloura-hero.hero--merged {
  margin-top: calc(var(--hero-header-h, 0px) * -1);
  padding-top: calc(var(--hero-header-h, 0px) + clamp(28px, 5vw, 72px)) !important;
  border-start-start-radius: 0;
  border-start-end-radius: 0;
}

body.veloura-hero-merged .veloura-header-tabs-stack__surface,
body.veloura-hero-merged .store-header,
body.veloura-hero-merged .store-header #mainnav,
body.veloura-hero-merged .store-header .main-nav-container,
body.veloura-hero-merged .store-header .main-nav-container > .inner,
body.veloura-hero-merged .store-header #mainnav > .inner {
  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;
  box-shadow: none !important;
  border-color: transparent !important;
  -webkit-backdrop-filter: none !important;
  backdrop-filter: none !important;
}

.veloura-hero .hero__grid {
  display: flex;
  align-items: center;
  gap: clamp(20px, 4vw, 56px);
}

.veloura-hero .hero__body {
  flex: 1 1 56%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--hero-gap);
  color: var(--hero-ink);
}

.veloura-hero .hero__media { flex: 1 1 44%; min-width: 0; position: relative; }

/* الترتيب فيزيائي: «يمين» تعني يمين الشاشة مهما كان اتجاه المتجر. */
.veloura-hero.hero--media-right .hero__media { order: 0; }
.veloura-hero.hero--media-right .hero__body { order: 1; }
.veloura-hero.hero--media-left .hero__media { order: 1; }
.veloura-hero.hero--media-left .hero__body { order: 0; }

html[dir="ltr"] .veloura-hero.hero--media-right .hero__media { order: 1; }
html[dir="ltr"] .veloura-hero.hero--media-right .hero__body { order: 0; }
html[dir="ltr"] .veloura-hero.hero--media-left .hero__media { order: 0; }
html[dir="ltr"] .veloura-hero.hero--media-left .hero__body { order: 1; }

.veloura-hero.hero--media-none .hero__body { flex: 1 1 100%; max-width: 820px; margin-inline: auto; }

/* المحاذاة */
.veloura-hero.hero--align-right .hero__body { align-items: flex-start; text-align: right; }
.veloura-hero.hero--align-left .hero__body { align-items: flex-end; text-align: left; }
.veloura-hero.hero--align-center .hero__body { align-items: center; text-align: center; }

/* «توسيط كامل» يعني كل شيء: الصفوف الداخلية تتوسط هي الأخرى لا محتواها فقط. */
.veloura-hero.hero--align-center .hero__cta,
.veloura-hero.hero--align-center .hero__badges,
.veloura-hero.hero--align-center .hero__stats,
.veloura-hero.hero--align-center .hero__countdown,
.veloura-hero.hero--align-center .hero__searchwrap { justify-content: center; margin-inline: auto; }

html[dir="ltr"] .veloura-hero.hero--align-right .hero__body { align-items: flex-end; }
html[dir="ltr"] .veloura-hero.hero--align-left .hero__body { align-items: flex-start; }

/* ----------------------------------------------------------- الشريحة --- */
.veloura-hero .hero__chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 16px;
  border-radius: var(--hero-inner, 999px);
  border: 1px solid color-mix(in srgb, var(--hero-chip, #22d3ee) 45%, transparent);
  background: color-mix(in srgb, var(--hero-chip, #22d3ee) 16%, transparent);
  color: var(--hero-chip, #22d3ee);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .02em;
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
}

.veloura-hero .hero__chip::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: currentColor;
  box-shadow: 0 0 0 0 currentColor;
  animation: hero-pulse 2.2s ease-out infinite;
}

@keyframes hero-pulse {
  0% { box-shadow: 0 0 0 0 currentColor; opacity: 1; }
  70% { box-shadow: 0 0 0 9px transparent; opacity: .75; }
  100% { box-shadow: 0 0 0 0 transparent; opacity: 1; }
}

/* ------------------------------------------------------------ النصوص --- */
.veloura-hero .hero__title {
  margin: 0;
  font-size: clamp(26px, 5.2vw, 58px);
  font-weight: 900;
  line-height: 1.15;
  color: var(--hero-title, #fff);
  text-shadow: 0 2px 22px rgba(0, 0, 0, .35);
}

.veloura-hero .hero__rotator {
  display: inline-block;
  min-width: 1ch;
  color: var(--hero-word, #a78bfa);
}

.veloura-hero .hero__rotator span {
  display: inline-block;
  animation: hero-word .5s ease both;
}

@keyframes hero-word {
  from { opacity: 0; transform: translateY(.35em) rotateX(-40deg); }
  to { opacity: 1; transform: none; }
}

.veloura-hero .hero__sub {
  margin: 0;
  max-width: 52ch;
  font-size: clamp(13px, 1.6vw, 18px);
  line-height: 1.85;
  color: var(--hero-sub, #e2e8f0);
  opacity: .92;
}

/* ------------------------------------------------------------ العدّاد --- */
.veloura-hero .hero__countdown { display: flex; gap: clamp(6px, .9vw, 12px); }

.veloura-hero .hero__countdown > div {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  min-width: clamp(52px, 6vw, 76px);
  padding: clamp(7px, .9vw, 12px) clamp(8px, 1vw, 14px);
  border-radius: var(--hero-inner, 16px);
  border: 1px solid rgba(255, 255, 255, .2);
  background: rgba(0, 0, 0, .34);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  line-height: 1;
}

.veloura-hero .hero__countdown strong { font-size: clamp(16px, 2.1vw, 26px); font-weight: 900; font-variant-numeric: tabular-nums; }
.veloura-hero .hero__countdown span { font-size: clamp(9px, 1vw, 12px); opacity: .75; font-weight: 600; }

/* ------------------------------------------------------------- البحث --- */
.veloura-hero .hero__searchwrap { width: 100%; max-width: 620px; display: flex; flex-direction: column; gap: 12px; }

.veloura-hero .hero__search {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 7px 7px 7px 7px;
  padding-inline-start: 16px;
  font-family: inherit;
  color: var(--hero-ink);
  cursor: pointer;
  text-align: start;
  border-radius: var(--hero-inner, 999px);
  border: 1px solid rgba(255, 255, 255, .22);
  background: rgba(255, 255, 255, .12);
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
  box-shadow: 0 18px 40px rgba(0, 0, 0, .28);
}

.veloura-hero .hero__search i { font-size: 18px; opacity: .8; flex: 0 0 auto; }

.veloura-hero .hero__search .hero__searchtext {
  flex: 1 1 auto;
  min-width: 0;
  padding: 10px 0;
  font-size: 15px;
  color: color-mix(in srgb, var(--hero-ink) 62%, transparent);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.veloura-hero .hero__search:hover { border-color: rgba(255, 255, 255, .4); }

.veloura-hero .hero__search .hero__searchgo {
  flex: 0 0 auto;
  padding: 11px 22px;
  border: 0;
  border-radius: var(--hero-inner, 999px);
  background: var(--hero-btn1-bg, #7c3aed);
  color: var(--hero-btn1-color, #fff);
  font-size: 14px;
  font-weight: 800;
  font-family: inherit;
  line-height: 1;
}

.veloura-hero .hero__tags { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 12px; }

/* صفّ الشرائح داخل غلاف البحث يأخذ عرضه كاملاً، فمحاذاته تُكتب له صراحة. */
.veloura-hero.hero--align-center .hero__tags { justify-content: center; }
.veloura-hero.hero--align-left .hero__tags { justify-content: flex-end; }
html[dir="ltr"] .veloura-hero.hero--align-left .hero__tags { justify-content: flex-start; }
html[dir="ltr"] .veloura-hero.hero--align-right .hero__tags { justify-content: flex-end; }
.veloura-hero .hero__tags b { font-weight: 700; opacity: .7; }

.veloura-hero .hero__tag {
  display: inline-flex;
  align-items: center;
  font-family: inherit;
  cursor: pointer;
  padding: 6px 13px;
  border-radius: var(--hero-inner, 999px);
  border: 1px solid rgba(255, 255, 255, .2);
  background: rgba(255, 255, 255, .08);
  color: var(--hero-ink);
  font-weight: 700;
  text-decoration: none;
  transition: background-color .25s ease, transform .25s ease;
}

.veloura-hero .hero__tag:hover { background: rgba(255, 255, 255, .18); transform: translateY(-2px); }

/* ------------------------------------------------------------ الأزرار --- */
.veloura-hero .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; }

.veloura-hero .hero__btn {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: clamp(11px, 1.3vw, 15px) clamp(20px, 2.4vw, 30px);
  border-radius: var(--hero-inner, 14px);
  border: 1.5px solid transparent;
  font-size: clamp(13px, 1.4vw, 15px);
  font-weight: 800;
  line-height: 1;
  text-decoration: none;
  transition: transform .25s ease, box-shadow .25s ease;
}

.veloura-hero .hero__btn:hover { transform: translateY(-2px); }
.veloura-hero .hero__btn--1 { background: var(--hero-btn1-bg, #7c3aed); color: var(--hero-btn1-color, #fff); box-shadow: 0 14px 30px color-mix(in srgb, var(--hero-btn1-bg, #7c3aed) 38%, transparent); }
.veloura-hero .hero__btn--2 {
  background: var(--hero-btn2-bg, rgba(255, 255, 255, .14));
  color: var(--hero-btn2-color, var(--hero-ink));
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
}

.veloura-hero .hero__btn--2.is-outline {
  background: transparent;
  border-color: color-mix(in srgb, var(--hero-btn2-color, #ffffff) 55%, transparent);
}

/* ------------------------------------------------------- شارات الثقة --- */
.veloura-hero .hero__group { display: flex; flex-direction: column; gap: 12px; width: 100%; }

.veloura-hero .hero__grouptitle {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
  opacity: .6;
}

/* شبكة لا صفّ حر: البطاقات تخرج بعرض واحد مهما اختلف طول النص، وهو ما كان
   يجعلها تبدو غير مرتّبة على اللابتوب. */
.veloura-hero .hero__badges {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: clamp(10px, 1.4vw, 16px);
  width: 100%;
}

.veloura-hero.hero--align-center .hero__badges { max-width: 900px; }

.veloura-hero .hero__badge {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
  padding: 12px 14px;
  border-radius: var(--hero-inner, 14px);
  border: 1px solid color-mix(in srgb, var(--hero-badge-icon, #22d3ee) 22%, transparent);
  background: var(--hero-badge-bg, rgba(255, 255, 255, .07));
  color: var(--hero-badge-ink, var(--hero-ink));
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
  transition: transform .25s ease, border-color .25s ease;
}

.veloura-hero .hero__badge:hover {
  transform: translateY(-2px);
  border-color: color-mix(in srgb, var(--hero-badge-icon, #22d3ee) 48%, transparent);
}

/* الأيقونة في قرص ملوّن: هو ما يعطي الصف إيقاعاً بصرياً بدل صفّ أيقونات عارية. */
.veloura-hero .hero__badge i {
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border-radius: var(--hero-inner, 12px);
  background: color-mix(in srgb, var(--hero-badge-icon, #22d3ee) 16%, transparent);
  color: var(--hero-badge-icon, #22d3ee);
  font-size: 18px;
}

.veloura-hero .hero__badge > div { min-width: 0; }
.veloura-hero .hero__badge strong { display: block; font-size: 13.5px; font-weight: 800; line-height: 1.4; }
.veloura-hero .hero__badge span { display: block; font-size: 11.5px; opacity: .66; line-height: 1.5; }

/* ------------------------------------------------------------ الأرقام --- */
.veloura-hero .hero__stats { display: flex; flex-wrap: wrap; gap: clamp(18px, 3vw, 46px); }
.veloura-hero .hero__stat strong { display: block; font-size: clamp(20px, 2.8vw, 34px); font-weight: 900; font-variant-numeric: tabular-nums; color: var(--hero-stat-color, inherit); }
.veloura-hero .hero__stat span { display: block; font-size: 12px; opacity: .72; margin-top: 2px; }

/* ------------------------------------------------------ الصورة الجانبية --- */
.veloura-hero .hero__media img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: var(--hero-inner, 28px);
  position: relative;
  z-index: 1;
}

.veloura-hero.hero--float .hero__media img { animation: hero-float 6.5s ease-in-out infinite; }

@keyframes hero-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-14px); }
}

.veloura-hero .hero__glow {
  position: absolute;
  inset: 8% 6%;
  z-index: 0;
  border-radius: 999px;
  background: radial-gradient(closest-side, color-mix(in srgb, var(--hero-glow, #7c3aed) 65%, transparent), transparent);
  filter: blur(46px);
}

/* ----------------------------------------------------- شريط الشعارات --- */
.veloura-hero .hero__logos {
  position: relative;
  margin-top: clamp(22px, 3.4vw, 44px);
  display: flex;
  flex-direction: column;
  gap: 12px;
  align-items: center;
  text-align: center;
  color: var(--hero-ink);
}

/* الحالة الهادئة (الافتراضية): صف ثابت متوسط يلتفّ عند الضيق — بلا قناع
   ولا حركة. الحركة تُشغَّل من الإعدادات وحدها، ووقتها فقط يصير شريطاً. */
.veloura-hero .hero__logos-track {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: clamp(20px, 3.4vw, 52px);
}

.veloura-hero .hero__logos-track .is-dup { display: none; }

.veloura-hero.hero--logos-move .hero__logos {
  -webkit-mask-image: linear-gradient(to left, transparent, #000 8%, #000 92%, transparent);
  mask-image: linear-gradient(to left, transparent, #000 8%, #000 92%, transparent);
  overflow: hidden;
}

.veloura-hero.hero--logos-move .hero__logos-track {
  flex-wrap: nowrap;
  width: max-content;
  animation: hero-marquee var(--hero-logo-speed, 28s) linear infinite;
}

.veloura-hero.hero--logos-move .hero__logos-track .is-dup { display: block; }

/* الشعارات بألوانها كما رُفعت. التفريغ الرمادي كان مفروضاً وهو ما جعلها
   تبدو فضية باهتة — صار خياراً لمن يريده. */
.veloura-hero .hero__logos img { height: clamp(24px, 2.8vw, 38px); width: auto; }

.veloura-hero.hero--logos-gray .hero__logos img {
  opacity: .7;
  filter: grayscale(1) contrast(1.05);
  transition: opacity .3s ease, filter .3s ease;
}

.veloura-hero.hero--logos-gray .hero__logos img:hover { opacity: 1; filter: none; }

@keyframes hero-marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

html[dir="rtl"] .veloura-hero.hero--logos-move .hero__logos-track { animation-name: hero-marquee-rtl; }

@keyframes hero-marquee-rtl {
  from { transform: translateX(0); }
  to { transform: translateX(50%); }
}

/* ------------------------------------------------------ مؤشر التمرير --- */
.veloura-hero .hero__cue {
  position: absolute;
  z-index: 1;
  bottom: 14px;
  inset-inline: 0;
  margin-inline: auto;
  width: 26px;
  height: 42px;
  border-radius: 999px;
  border: 2px solid rgba(255, 255, 255, .35);
}

.veloura-hero .hero__cue::before {
  content: "";
  position: absolute;
  top: 7px;
  inset-inline: 0;
  margin-inline: auto;
  width: 4px;
  height: 8px;
  border-radius: 999px;
  background: rgba(255, 255, 255, .8);
  animation: hero-cue 1.8s ease-in-out infinite;
}

@keyframes hero-cue {
  0%, 100% { transform: translateY(0); opacity: 1; }
  60% { transform: translateY(13px); opacity: .25; }
}

/* ------------------------------------------------------------- الظهور --- */
.veloura-hero .hero__body > *,
.veloura-hero .hero__media {
  opacity: 0;
  transform: translateY(16px);
  transition: opacity .7s ease, transform .7s ease;
}

.veloura-hero .hero__body > *:nth-child(2) { transition-delay: .07s; }
.veloura-hero .hero__body > *:nth-child(3) { transition-delay: .14s; }
.veloura-hero .hero__body > *:nth-child(4) { transition-delay: .21s; }
.veloura-hero .hero__body > *:nth-child(5) { transition-delay: .28s; }
.veloura-hero .hero__body > *:nth-child(6) { transition-delay: .35s; }
.veloura-hero .hero__media { transition-delay: .1s; }

.veloura-hero.is-inview .hero__body > *,
.veloura-hero.is-inview .hero__media,
.veloura-hero.no-js .hero__body > *,
.veloura-hero.no-js .hero__media { opacity: 1; transform: none; }

/* ------------------------------------------------------------- الجوال --- */
@media (max-width: 1023px) {
  /* محاذاة الجوال مستقلة عن اللابتوب. */
  .veloura-hero.hero--malign-right .hero__body { align-items: flex-start; text-align: right; }
  .veloura-hero.hero--malign-left .hero__body { align-items: flex-end; text-align: left; }
  .veloura-hero.hero--malign-center .hero__body { align-items: center; text-align: center; }
  .veloura-hero.hero--malign-center .hero__tags,
  .veloura-hero.hero--malign-center .hero__cta,
  .veloura-hero.hero--malign-center .hero__badges,
  .veloura-hero.hero--malign-center .hero__stats,
  .veloura-hero.hero--malign-center .hero__countdown { justify-content: center; }
  .veloura-hero.hero--malign-right .hero__tags { justify-content: flex-start; }
  .veloura-hero.hero--malign-left .hero__tags { justify-content: flex-end; }

  html[dir="ltr"] .veloura-hero.hero--malign-right .hero__body { align-items: flex-end; }
  html[dir="ltr"] .veloura-hero.hero--malign-left .hero__body { align-items: flex-start; }

  .veloura-hero .hero__grid { flex-direction: column; align-items: stretch; }
  .veloura-hero .hero__media,
  .veloura-hero .hero__body { flex: 1 1 auto; order: 0 !important; }
  .veloura-hero.hero--mob-above .hero__media { order: -1 !important; }
  .veloura-hero.hero--mob-hidden .hero__media { display: none; }
  .veloura-hero.hero--h-tall { min-height: clamp(440px, 76vh, 640px); }
  .veloura-hero .hero__sub { font-size: 13px; }
  .veloura-hero .hero__search .hero__searchgo { padding: 10px 16px; font-size: 13px; }
  .veloura-hero .hero__badges { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  .veloura-hero .hero__badge i { width: 32px; height: 32px; font-size: 16px; }
  .veloura-hero .hero__cue { display: none; }
}

@media (max-width: 560px) {
  .veloura-hero .hero__badges { gap: 8px; }
  .veloura-hero .hero__badge { padding: 8px 11px; }
  .veloura-hero .hero__stats { gap: 18px; }
}

@media (prefers-reduced-motion: reduce) {
  .veloura-hero *,
  .veloura-hero *::before { animation: none !important; transition: none !important; }
  .veloura-hero .hero__body > *,
  .veloura-hero .hero__media { opacity: 1 !important; transform: none !important; }
}
</style>

<section
  data-veloura-home-tab="{{ veloura_home_tab_key|e }}"
  id="veloura-hero-{{ position }}"
  class="s-block veloura-hero no-js
    hero--media-{{ hero_side }}
    hero--mob-{{ hero_mob }}
    hero--align-{{ hero_align }}
    hero--malign-{{ hero_align_m }}
    hero--h-{{ hero_h }}
    hero--bg-{{ hero_bg }}
    {{ component.hero_full_width ? 'hero--full-width' : 'hero--boxed' }}
    {{ component.hero_merge_header ? 'hero--merged' : '' }}
    {{ component.hero_logos_animate ? 'hero--logos-move' : '' }}
    {{ component.hero_logos_gray ? 'hero--logos-gray' : '' }}
    {{ component.hero_grad_animate ? 'hero--grad-animate' : '' }}
    {{ component.hero_media_float ? 'hero--float' : '' }}
    {{ component.hero_mobile_only ? 'veloura-mobile-only' : '' }}
    {{ component.hero_desktop_only ? 'veloura-desktop-only' : '' }}
    {{ component.hero_custom_classes }}"
  style="
    --hero-radius: {{ hero_radius }};
    --hero-inner: {{ hero_inner }};
    --hero-overlay: {{ hero_overlay }};
    {% if component.hero_custom_spacing %}--hero-gutter: {{ hero_gutter }}px;{% endif %}
    --hero-grad-from: {{ component.hero_grad_from|default('#1e1b4b') }};
    --hero-grad-to: {{ component.hero_grad_to|default('#0f172a') }};
    --hero-chip: {{ component.hero_chip_color|default('#22d3ee') }};
    --hero-title: {{ component.hero_title_color|default('#ffffff') }};
    --hero-word: {{ component.hero_words_color|default('#a78bfa') }};
    --hero-sub: {{ component.hero_subtitle_color|default('#e2e8f0') }};
    --hero-btn1-bg: {{ component.hero_btn1_bg|default('#7c3aed') }};
    --hero-btn1-color: {{ component.hero_btn1_color|default('#ffffff') }};
    --hero-glow: {{ component.hero_media_glow_color|default('#7c3aed') }};
    --hero-badge-icon: {{ component.hero_badge_icon_color|default('#22d3ee') }};
    {% if component.hero_badge_bg %}--hero-badge-bg: {{ component.hero_badge_bg }};{% endif %}
    {% if component.hero_badge_text_color %}--hero-badge-ink: {{ component.hero_badge_text_color }};{% endif %}
    {% if component.hero_btn2_bg %}--hero-btn2-bg: {{ component.hero_btn2_bg }};{% endif %}
    --hero-btn2-color: {{ component.hero_btn2_color|default('#ffffff') }};
    --hero-stat-color: {{ component.hero_stats_color|default('#ffffff') }};
    --hero-logo-speed: {{ hero_logo_speed }}s;
  "
>
  <div class="hero__bg">
    {% if hero_bg == 'video' and component.hero_bg_video %}
      {# الصورة البديلة تحت الفيديو لا بدلاً منه: على الجوال لا يُحمَّل الفيديو
         أصلاً فتبقى هي الظاهرة، وعلى اللابتوب يغطيها الفيديو حين يبدأ. #}
      {% if component.hero_bg_video_poster %}
        <img src="{{ component.hero_bg_video_poster }}" alt="" fetchpriority="high" decoding="async">
      {% endif %}
      <video data-hero-video data-src="{{ component.hero_bg_video }}" muted loop playsinline preload="none"
        {% if component.hero_bg_video_poster %}poster="{{ component.hero_bg_video_poster }}"{% endif %}></video>
    {% elseif hero_bg == 'image' and hero_bg_image %}
      <picture>
        <source media="(max-width: 767px)" srcset="{{ hero_bg_image_m }}">
        {# fetchpriority=high وبدون lazy: هذه صورة الـ LCP #}
        <img src="{{ hero_bg_image }}" alt="" fetchpriority="high" decoding="async">
      </picture>
    {% endif %}
    <span class="hero__scrim"></span>
  </div>

  <div class="hero__wrap {{ component.hero_full_width ? '' : 'container' }}">
    <div class="hero__grid">

      <div class="hero__body">
        {% if component.hero_chip_text %}
          <span class="hero__chip">{{ component.hero_chip_text }}</span>
        {% endif %}

        {% if hero_title_text %}
          <h1 class="hero__title">
            {% if hero_words|length and hero_title_has_slot %}
              {{ hero_title_text|split('{}')[0] }}<span class="hero__rotator" data-hero-words="{{ hero_words|join('|')|e('html_attr') }}"><span>{{ hero_words[0]|trim }}</span></span>{{ hero_title_text|split('{}')[1]|default('') }}
            {% else %}
              {{ hero_title_text }}
              {% if hero_words|length %}
                <span class="hero__rotator" data-hero-words="{{ hero_words|join('|')|e('html_attr') }}"><span>{{ hero_words[0]|trim }}</span></span>
              {% endif %}
            {% endif %}
          </h1>
        {% endif %}

        {% if component.hero_subtitle %}
          <p class="hero__sub">{{ component.hero_subtitle }}</p>
        {% endif %}

        {% set hero_cd_date %}{{ _self.pick(component.hero_countdown_date, '') }}{% endset %}
        {% set hero_cd_date = hero_cd_date|trim %}
        {% if component.hero_countdown_enabled and hero_cd_date %}
          <div class="hero__countdown" data-hero-countdown="{{ hero_cd_date|e('html_attr') }}">
            <div><strong data-days>0</strong><span>يوم</span></div>
            <div><strong data-hours>0</strong><span>ساعة</span></div>
            <div><strong data-minutes>0</strong><span>دقيقة</span></div>
            <div><strong data-seconds>0</strong><span>ثانية</span></div>
          </div>
        {% endif %}

        {% if component.hero_search_enabled %}
          <div class="hero__searchwrap">
            {# ليس نموذجاً يذهب لصفحة بحث بديلة — تلك كانت تعطي «لا توجد منتجات»
               لأن سلة لا تملك صفحة نتائج مستقلة أصلاً: البحث عندها نافذة
               بمكوّنها الخاص. هذا الحقل يفتح بحث المتجر نفسه بنتائجه الحقيقية،
               وبنسخته الوحيدة في الصفحة — بلا أي مكوّن بحث ثانٍ. #}
            <button type="button" class="hero__search" data-hero-search
              aria-label="{{ component.hero_search_placeholder|default('بحث') }}">
              <i class="sicon-search" aria-hidden="true"></i>
              <span class="hero__searchtext">{{ component.hero_search_placeholder|default('ابحث عن منتج أو خدمة…') }}</span>
              <span class="hero__searchgo">بحث</span>
            </button>

            {% if component.hero_top_searches|length %}
              <div class="hero__tags">
                {% if component.hero_top_searches_title %}<b>{{ component.hero_top_searches_title }}</b>{% endif %}
                {% for tag in component.hero_top_searches %}
                  {% if tag.label %}
                    {% if tag.url %}
                      <a class="hero__tag" href="{{ tag.url }}">{{ tag.label }}</a>
                    {% else %}
                      <button type="button" class="hero__tag" data-hero-search>{{ tag.label }}</button>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% if component.hero_btn1_text or component.hero_btn2_text %}
          <div class="hero__cta">
            {% if component.hero_btn1_text %}
              <a class="hero__btn hero__btn--1" href="{{ component.hero_btn1_url ?: '#' }}">
                {% if component.hero_btn1_icon %}<i class="{{ component.hero_btn1_icon }}" aria-hidden="true"></i>{% endif %}
                {{ component.hero_btn1_text }}
              </a>
            {% endif %}

            {% if component.hero_btn2_text %}
              <a class="hero__btn hero__btn--2 {{ component.hero_btn2_outline ? 'is-outline' : '' }}" href="{{ component.hero_btn2_url ?: '#' }}">
                {% if component.hero_btn2_icon %}<i class="{{ component.hero_btn2_icon }}" aria-hidden="true"></i>{% endif %}
                {{ component.hero_btn2_text }}
              </a>
            {% endif %}
          </div>
        {% endif %}

        {% if component.hero_badges|length %}
          <div class="hero__group">
            {% if component.hero_badges_title %}<span class="hero__grouptitle">{{ component.hero_badges_title }}</span>{% endif %}
          <div class="hero__badges">
            {% for badge in component.hero_badges %}
              {% if badge.title %}
                <div class="hero__badge">
                  {% if badge.icon %}<i class="{{ badge.icon }}" aria-hidden="true"></i>{% endif %}
                  <div>
                    <strong>{{ badge.title }}</strong>
                    {% if badge.subtitle %}<span>{{ badge.subtitle }}</span>{% endif %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
          </div>
        {% endif %}

        {% if component.hero_stats|length %}
          <div class="hero__stats">
            {% for stat in component.hero_stats %}
              {% if stat.number %}
                <div class="hero__stat">
                  <strong {% if component.hero_stats_count_up %}data-hero-count="{{ stat.number }}"{% endif %}>{{ component.hero_stats_count_up ? '0' : stat.number }}{{ stat.suffix|default('') }}</strong>
                  {% if stat.label %}<span>{{ stat.label }}</span>{% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>

      {% if hero_side != 'none' and component.hero_media_image %}
        <div class="hero__media">
          {% if component.hero_media_glow %}<span class="hero__glow" aria-hidden="true"></span>{% endif %}
          <img src="{{ component.hero_media_image }}" alt="{{ hero_title_text }}" fetchpriority="high" decoding="async">
        </div>
      {% endif %}

    </div>

    {% if component.hero_logos|length %}
      <div class="hero__logos">
        {% if component.hero_logos_title %}<span class="hero__grouptitle">{{ component.hero_logos_title }}</span>{% endif %}
        <div class="hero__logos-track">
          {% for logo in component.hero_logos %}
            {% if logo.image %}<img src="{{ logo.image }}" alt="" loading="lazy" decoding="async">{% endif %}
          {% endfor %}
          {# نسخة ثانية للدوران بلا فجوة — مخفية تماماً في الحالة الثابتة #}
          {% for logo in component.hero_logos %}
            {% if logo.image %}<img class="is-dup" src="{{ logo.image }}" alt="" aria-hidden="true" loading="lazy" decoding="async">{% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>

  {% if component.hero_scroll_cue and hero_h != 'auto' %}
    <span class="hero__cue" aria-hidden="true"></span>
  {% endif %}
</section>

<script>
(function () {
  var root = document.getElementById('veloura-hero-{{ position }}');
  if (!root) return;
  root.classList.remove('no-js');

  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* الظهور */
  if (!('IntersectionObserver' in window)) {
    root.classList.add('is-inview');
  } else {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        root.classList.add('is-inview');
        /* ربع ثانية قبل البدء: يمنح الصفحة وقتاً لتستقر فيرى الزائر الرقم
           وهو يصعد من الصفر بدل أن يجده وقد وصل. */
        setTimeout(startCounters, 260);
        io.unobserve(root);
      });
    }, { threshold: 0.15 });
    io.observe(root);
  }

  /* الأرقام: تعدّ مرة واحدة عند أول ظهور */
  var counted = false;
  function startCounters() {
    if (counted) return;
    counted = true;
    root.querySelectorAll('[data-hero-count]').forEach(function (el) {
      var raw = String(el.getAttribute('data-hero-count')).replace(/[^\d.]/g, '');
      var target = parseFloat(raw);
      if (!isFinite(target)) return;
      var suffix = el.textContent.replace(/^0/, '');
      if (reduced) { el.textContent = raw + suffix; return; }
      /* بطيء بما يكفي ليُرى: القسم في أعلى الصفحة فيبدأ العدّ أثناء التحميل،
         ومع 1.4 ثانية كان ينتهي قبل أن تستقر عين الزائر عليه. */
      var start = performance.now(), dur = 2600;
      (function step(now) {
        var p = Math.min(1, (now - start) / dur);
        var eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(target * eased).toLocaleString('en-US') + suffix;
        if (p < 1) requestAnimationFrame(step);
      })(start);
    });
  }

  /* الكلمة المتبدّلة — يُعاد العثور على العنصر في كل دورة، لا يُحتفظ به:
     لو نُقل القسم أو أُعيد رسمه (تبويبات الصفحة الرئيسية تفعل ذلك) بقي
     المؤقت يكتب في عنصر لم يعد ظاهراً، فيبدو كأنه متوقف. */
  if (!reduced) {
    var wi = 0;
    setInterval(function () {
      var el = document.querySelector('[data-hero-words]');
      if (!el) return;
      var words = (el.getAttribute('data-hero-words') || '').split('|')
        .map(function (w) { return w.trim(); }).filter(Boolean);
      if (words.length < 2) return;
      wi = (wi + 1) % words.length;
      el.innerHTML = '<span>' + words[wi].replace(/[<>&]/g, '') + '</span>';
    }, 2600);
  }

  /* العدّاد التنازلي.

     يُبحث عن العنصر من المستند في كل ثانية بدل الاحتفاظ به: هذا يجعل العدّاد
     يعمل حتى لو أُعيد رسم القسم أو نُقل مكانه. وصيغة التاريخ تُقرأ بالاتجاهين
     (يوم-شهر-سنة أو سنة-شهر-يوم) لأن حقل التاريخ يختلف بين الإصدارات. */
  /* حقل التاريخ يصل بأشكال مختلفة بين إصدارات لوحة التحكم: 01-01-2027 أو
     2027-01-01 أو 2027-01-01T20:00:00Z أو معه وقت بعد مسافة. هنا نقرأ الأرقام
     كما هي ونرتّبها بالمنطق: أربع خانات في الأول تعني سنة، وإلا فهو يوم. وإن
     لم يُذكر وقت اعتبرنا نهاية اليوم. */
  function heroParseEnd(raw) {
    raw = String(raw == null ? '' : raw).replace(/"/g, '').trim();
    if (!raw) return NaN;

    var nums = raw.match(/\d+/g);
    if (!nums || nums.length < 3) {
      var t = Date.parse(raw);
      return isNaN(t) ? NaN : t;
    }

    var y, m, dd;
    if (nums[0].length === 4) { y = +nums[0]; m = +nums[1]; dd = +nums[2]; }
    else { dd = +nums[0]; m = +nums[1]; y = +nums[2]; }

    if (!y || !m || !dd || m > 12 || dd > 31) return NaN;

    var hh = nums.length > 3 ? +nums[3] : 23;
    var mi = nums.length > 4 ? +nums[4] : 59;
    var ss = nums.length > 5 ? +nums[5] : 59;

    var d = new Date(y, m - 1, dd, hh, mi, ss);
    return isNaN(d.getTime()) ? NaN : d.getTime();
  }

  function heroCountdownTick() {
    var el = document.querySelector('[data-hero-countdown]');
    if (!el) return;

    var end = heroParseEnd(el.getAttribute('data-hero-countdown'));
    /* تاريخ غير مفهوم: لا نخفي العدّاد ولا نصفّره — نتركه كما هو ونصمت،
       فالإخفاء الفوري كان يبدو وكأن العرض انتهى في اللحظة نفسها. */
    if (!isFinite(end)) return;

    var left = end - Date.now();

    if (!isFinite(left) || left <= 0) { el.style.display = 'none'; return; }

    var set = function (sel, v) { var n = el.querySelector(sel); if (n) n.textContent = v; };
    set('[data-days]', Math.floor(left / 86400000));
    set('[data-hours]', Math.floor(left / 3600000) % 24);
    set('[data-minutes]', Math.floor(left / 60000) % 60);
    set('[data-seconds]', Math.floor(left / 1000) % 60);
  }

  heroCountdownTick();
  setInterval(heroCountdownTick, 1000);
  /* بعض المتصفحات تبطئ المؤقتات في التبويب الخامل، فنصحّح فور العودة. */
  document.addEventListener('visibilitychange', heroCountdownTick);

  /* البحث: نستدعي بحث المتجر نفسه — نفس ما يفعله زر البحث في الهيدر
     بالضبط، فلا نسخة ثانية من <salla-search> ولا صفحة نتائج بديلة. */
  root.querySelectorAll('[data-hero-search]').forEach(function (el) {
    el.addEventListener('click', function () {
      if (typeof window.__velouraOpenSearch === 'function') { window.__velouraOpenSearch(); return; }
      if (window.salla && salla.event && salla.event.dispatch) { salla.event.dispatch('search::open'); }
    });
  });

  /* الدمج مع الهيدر: نقيس ارتفاع الهيدر الحقيقي ونكتبه متغيراً، فالهيرو
     يُسحب تحته بالضبط. وعند أول تمرير ترجع خلفية الهيدر حتى يبقى مقروءاً. */
  if (root.classList.contains('hero--merged')) {
    var headerEl = document.querySelector('.veloura-header-tabs-stack') || document.querySelector('.store-header');

    var measure = function () {
      if (!headerEl) return;
      var h = Math.round(headerEl.getBoundingClientRect().height);
      if (h > 0) root.style.setProperty('--hero-header-h', h + 'px');
    };

    /* إذابة خلفية الهيدر تُكتب inline بـ important على العناصر نفسها.

       القاعدة في ملف الستايل لا تكفي هنا: خلفية الهيدر يرسمها أكثر من ملف،
       وبعضها يُحقن في نهاية الصفحة بـ important وبانتقائية أعلى — فتفوز
       عليها مهما كتبنا. والسطر inline لا يعلوه شيء. */
    var HEADER_PARTS = [
      '.veloura-header-tabs-stack__surface',
      '.store-header',
      '.store-header #mainnav',
      '.store-header .main-nav-container',
      '.store-header .main-nav-container > .inner',
      '.store-header #mainnav > .inner'
    ];

    var CLEARED = ['background', 'background-color', 'background-image', 'box-shadow',
                   'border-color', 'backdrop-filter', '-webkit-backdrop-filter'];

    var dissolve = function (on) {
      HEADER_PARTS.forEach(function (sel) {
        var nodes = document.querySelectorAll(sel);
        for (var i = 0; i < nodes.length; i++) {
          var el = nodes[i];
          if (on) {
            el.style.setProperty('background', 'transparent', 'important');
            el.style.setProperty('background-color', 'transparent', 'important');
            el.style.setProperty('background-image', 'none', 'important');
            el.style.setProperty('box-shadow', 'none', 'important');
            el.style.setProperty('border-color', 'transparent', 'important');
            el.style.setProperty('backdrop-filter', 'none', 'important');
            el.style.setProperty('-webkit-backdrop-filter', 'none', 'important');
          } else {
            for (var c = 0; c < CLEARED.length; c++) el.style.removeProperty(CLEARED[c]);
          }
        }
      });
    };

    var atTop = null;
    var paint = function () {
      var top = (window.pageYOffset || document.documentElement.scrollTop) < 8;
      if (top === atTop) return;
      atTop = top;
      document.body.classList.toggle('veloura-hero-merged', top);
      dissolve(top);
    };

    measure();
    paint();
    /* العناصر المتأخرة (الهيدر المثبّت، لوحات تُحقن بعد التحميل) تُلتقط هنا. */
    [200, 900, 2500].forEach(function (t) {
      setTimeout(function () { measure(); if (atTop) dissolve(true); }, t);
    });

    var rafPending = false;
    addEventListener('scroll', function () {
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(function () { rafPending = false; paint(); });
    }, { passive: true });

    var resizeTimer;
    addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(measure, 200);
    }, { passive: true });
  }

  /* الفيديو: لا يُحمَّل على الجوال ولا لمن يفضّل تقليل الحركة */
  var vid = root.querySelector('[data-hero-video]');
  if (vid && !reduced && window.innerWidth >= 768) {
    vid.src = vid.getAttribute('data-src');
    vid.play().catch(function () {});
  }
})();
</script>
{% endif %}