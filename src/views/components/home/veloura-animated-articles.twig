{# VELOURA HOME TAB ASSIGNMENT START #}
{% set veloura_home_tab_key = component.veloura_home_tab_name_2026|default('') %}
{% if veloura_home_tab_key.value is defined %}{% set veloura_home_tab_key = veloura_home_tab_key.value %}{% endif %}
{% if not veloura_home_tab_key %}{% set veloura_home_tab_key = 'always' %}{% endif %}
{# VELOURA HOME TAB ASSIGNMENT END #}

{% if not component.veloura_articles_hide %}

  {% set radius_map = {
    'sharp': '0px',
    'soft': '8px',
    'medium': '16px',
    'large': '28px',
    'round': '999px',
    '40': '999px'
  } %}

  {% set article_radius = radius_map[component.veloura_articles_radius|default('medium')]|default((component.veloura_articles_radius|default('medium') ~ '' == '' ? '16' : component.veloura_articles_radius|default('medium')) ~ 'px') %}

  {% set art_no_dots = component.veloura_articles_hide_pagination|default(false) %}
  {% if art_no_dots.value is defined %}{% set art_no_dots = art_no_dots.value %}{% endif %}
  {% set art_no_dots = art_no_dots is same as(true) or art_no_dots in ['true', '1', 1, 'on'] %}

<style>
/* ---------- المقالات المتحركة ----------
   داخل الكونتينر تماماً على الجوال واللابتوب: الفجوة بين البطاقات حشوة داخل
   كل شريحة، والشريط ممدود بنصف فجوة من كل جهة ثم يُقص عند حدود الكونتينر
   بالضبط (clip-path يعمل حتى لو لم يُطبَّق overflow على عنصر سلة). القص
   مفتوح من الأعلى والأسفل ليتسع لارتفاع الصورة فوق البطاقة وظلها ونقاط
   التنقل. */
.veloura-animated-articles { --art-gap: 16px; }
@media (min-width: 768px) { .veloura-animated-articles { --art-gap: 24px; } }

.veloura-animated-articles .veloura-animated-articles__slider {
  display: block !important;
  overflow: visible !important;
  padding: 26px 0 0 !important;
  margin: 0 !important;
}

.veloura-animated-articles .veloura-animated-articles__slider.has-dots {
  padding-bottom: 44px !important;
}

.veloura-animated-articles .veloura-animated-articles__slider:not(.has-dots) {
  padding-bottom: 28px !important;
}

.veloura-animated-articles .veloura-animated-articles__slider .s-slider-wrapper,
.veloura-animated-articles .veloura-animated-articles__slider .s-slider-block {
  padding: 0 !important;
  margin: 0 !important;
  overflow: visible !important;
}

.veloura-animated-articles .veloura-animated-articles__slider .swiper,
.veloura-animated-articles .veloura-animated-articles__slider.carousel-slider .swiper {
  width: auto !important;
  max-width: none !important;
  padding: 0 !important;
  margin-left: calc(var(--art-gap) / -2) !important;
  margin-right: calc(var(--art-gap) / -2) !important;
  overflow: visible !important;
  clip-path: inset(-30px calc(var(--art-gap) / 2) -60px calc(var(--art-gap) / 2));
}

.veloura-animated-articles .veloura-animated-articles__slider .swiper-wrapper > .swiper-slide,
.veloura-animated-articles .veloura-animated-articles__slider.carousel-slider .swiper-wrapper > div {
  padding-left: calc(var(--art-gap) / 2) !important;
  padding-right: calc(var(--art-gap) / 2) !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
  box-sizing: border-box !important;
}

/* نقاط التنقل: تحت البطاقات داخل المساحة المحجوزة لها، أو مخفية بالخيار. */
.veloura-animated-articles .veloura-animated-articles__slider:not(.has-dots) :is(.swiper-pagination, .s-slider-pagination) {
  display: none !important;
}

/* ---------- الوضع الداكن ----------
   البطاقة بالخلفية الثانوية للداكن، والعناوين والنصوص بألوانه. */
html.dark .veloura-animated-articles .veloura-animated-articles__card,
html body.dark .veloura-animated-articles .veloura-animated-articles__card {
  background: var(--veloura-dark-secondary-bg, #010612) !important;
  border-color: color-mix(in srgb, var(--veloura-dark-primary-text, #ffffff) 8%, transparent) !important;
  box-shadow: 0 8px 22px rgba(0, 0, 0, .35) !important;
}

html.dark .veloura-animated-articles .veloura-animated-articles__card h3 a,
html body.dark .veloura-animated-articles .veloura-animated-articles__card h3 a,
html.dark .veloura-animated-articles .veloura-animated-articles__heading h2,
html body.dark .veloura-animated-articles .veloura-animated-articles__heading h2 {
  color: var(--veloura-dark-primary-text, #ffffff) !important;
}

html.dark .veloura-animated-articles .veloura-animated-articles__card p,
html body.dark .veloura-animated-articles .veloura-animated-articles__card p,
html.dark .veloura-animated-articles .veloura-animated-articles__heading p,
html body.dark .veloura-animated-articles .veloura-animated-articles__heading p {
  color: var(--veloura-dark-secondary-text, #ededed) !important;
}

/* ---------- العنوان ----------
   بلون النصوص (من إعدادات العنصر في الفاتح، وألوان الداكن في الداكن) مثل
   الروابط السريعة، لا بلون المتجر، وأقرب إلى المقالات. */
.veloura-animated-articles .veloura-animated-articles__heading {
  margin-bottom: 12px !important;
}

.veloura-animated-articles .veloura-animated-articles__heading h2 {
  margin: 0 0 6px !important;
  color: var(--art-title-color, #111111) !important;
}

.veloura-animated-articles .veloura-animated-articles__heading p {
  color: var(--art-subtitle-color, #6b6b6b) !important;
}

/* ---------- الوضع الفاتح ----------
   البطاقة بالخلفية الثانوية للفاتح (نفس المتغير الذي تقرأه بقية عناصر فيلورا). */
.veloura-animated-articles .veloura-animated-articles__card {
  background: var(--veloura-site-second-bg, var(--color-secondary, #f4f5f7)) !important;
}

/* لا خلفية خلف الصورة في الوضعين: الصورة تملأ إطارها مقصوصة (cover)،
   فلا يظهر حولها لون شفاف. */
.veloura-animated-articles .veloura-animated-articles__image {
  background: transparent !important;
}

.veloura-animated-articles .veloura-animated-articles__image img {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
}
</style>

  {% set section_classes = [
    's-block',
  'veloura-animated-articles',
  component.veloura_articles_mobile_only ? 'veloura-animated-articles--mobile-only' : '',
  component.veloura_articles_desktop_only ? 'veloura-animated-articles--desktop-only' : '',
  component.veloura_articles_custom_spacing ? 'has-spacing' : '',
  component.veloura_articles_custom_classes ?: ''
  ]|join(' ') %}

  <section data-veloura-home-tab="{{ veloura_home_tab_key|e }}"
    class="{{ section_classes }}"
    style="
      --article-radius: {{ article_radius }};
      --art-title-color: {{ component.veloura_articles_title_color|default('#111111') }};
      --art-subtitle-color: {{ component.veloura_articles_subtitle_color|default('#6b6b6b') }};
      --veloura-articles-spacing: {{ component.veloura_articles_custom_spacing ? component.veloura_articles_spacing|default(0) : 0 }}px;
    "
  >
    {% if component.veloura_articles_custom_spacing %}
  <div class="veloura-animated-articles__container">
{% else %}
  <div class="container veloura-animated-articles__container">
{% endif %}

      {% if component.veloura_articles_title or component.veloura_articles_subtitle %}
        <div class="veloura-animated-articles__heading veloura-component-title" data-veloura-section-heading>
          {% if component.veloura_articles_title %}
            <h2>{{ component.veloura_articles_title }}</h2>
          {% endif %}

          {% if component.veloura_articles_subtitle %}
            <p>{{ component.veloura_articles_subtitle }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if component.veloura_articles_collection|length %}
        <salla-slider
          id="veloura-animated-articles-{{ position }}"
          class="veloura-animated-articles__slider {{ art_no_dots ? '' : 'has-dots' }}"
          type="carousel"
          {% if not art_no_dots %}pagination{% endif %}
          {% if component.veloura_articles_autoplay %}auto-play{% endif %}
          {% if component.veloura_articles_hide_arrows %}show-controls="false"{% endif %}
          slider-config='{
            "slidesPerView": 1.3,
            "spaceBetween": 0,
            "speed": 700,
            "loop": false,
            "watchOverflow": true,
            "allowTouchMove": true,
            "autoplay": {{ component.veloura_articles_autoplay ? '{"delay": 2600, "disableOnInteraction": false}' : 'false' }},
            "breakpoints": {
              "768": {
                "slidesPerView": 2.3,
                "spaceBetween": 0
              },
              "1024": {
                "slidesPerView": 3.3,
                "spaceBetween": 0
              }
            }
          }'
        >
          <div slot="items">
            {% for article in component.veloura_articles_collection %}
              {% set article_url = article.url.url|default('#') %}

              <div class="swiper-slide">
                <article class="veloura-animated-articles__card">
                  <a href="{{ article_url }}" class="veloura-animated-articles__image">
                    {% if article.image %}
                      <img
                        src="{{ article.image.url|default(article.image) }}"
                        alt="{{ article.title|default(store.name) }}"
                        loading="lazy"
                      >
                    {% endif %}
                  </a>

                  <div class="veloura-animated-articles__content">
                    {% if article.title %}
                      <h3>
                        <a href="{{ article_url }}">
                          {{ article.title }}
                        </a>
                      </h3>
                    {% endif %}

                    {% if article.excerpt %}
                      <p>{{ article.excerpt }}</p>
                    {% endif %}

                    {% if article.button_text %}
                      <a href="{{ article_url }}" class="veloura-animated-articles__more">
                        {{ article.button_text }}
                      </a>
                    {% endif %}
                  </div>
                </article>
              </div>
            {% endfor %}
          </div>
        </salla-slider>
      {% endif %}

    </div>
  </section>

{% endif %}