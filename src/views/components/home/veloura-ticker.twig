{# VELOURA HOME TAB ASSIGNMENT START #}
{% set veloura_home_tab_key = component.veloura_home_tab_name_2026|default('') %}
{% if veloura_home_tab_key.value is defined %}{% set veloura_home_tab_key = veloura_home_tab_key.value %}{% endif %}
{% if not veloura_home_tab_key %}{% set veloura_home_tab_key = 'always' %}{% endif %}
{# VELOURA HOME TAB ASSIGNMENT END #}

{% if not component.veloura_tkr_hide %}

{# ==========================================================================
   شريط إعلاني (فيلورا)

   The stylesheet is inline and every class carries its own name, because on
   this store the published Twig and the built app.css have repeatedly been a
   version apart, and new markup under old rules is how a layout breaks with
   nobody touching it.

   No JavaScript, and no macros either: the loop is a CSS animation over a list
   repeated enough times to fill the band, and the settings are unwrapped with
   {% set %} alone. A macro plus {% import _self %} inside this section's own
   {% if %} once took the whole component off the page.
   ========================================================================== #}
<style>
/* ==========================================================================
   شريط إعلاني (فيلورا) — scoped entirely to .veloura-tkr
   ========================================================================== */
.veloura-tkr {
  --tkr-height: 46px;
  --tkr-size: 14px;
  --tkr-gap: 26px;
  --tkr-speed: 26s;
  --tkr-angle: 3deg;

  /* A tilted band is wider than the viewport, so the section must clip it —
     without this every screen gains a horizontal scrollbar. */
  overflow: hidden;

  /* The theme paints .s-block as a white card with a rounding of its own, and
     that card is what was showing around the ribbon — the rounded ends in the
     screenshot belong to the block, not to the band. The section carries
     nothing; the band carries everything. */
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

.veloura-tkr [hidden] { display: none !important; }

/* One gutter, in one place — the same arrangement the featured product uses.

   The ribbon sits in the theme's own .container, so on a laptop it lines up
   with every other section instead of running visibly wider than them, and the
   side setting is nothing but that container's padding: zero puts the ribbon
   against the screen edges on a phone, any number walks it back in. The section
   is forced to zero because the theme styles .s-block with a `padding`
   shorthand, which would otherwise outrank a padding-inline of equal weight. */
.veloura-tkr { padding-inline: 0 !important; }
.veloura-tkr > .container { padding-inline: var(--tkr-gutter, 0px) !important; }

.veloura-tkr .tkr__wrap { position: relative; }

/* A tilted band leans out of its own line, so the wrap makes room for the
   corners instead of cutting them off — the angle is fixed, and the room it
   needs is a share of the viewport's width. */
.veloura-tkr.tkr--tilt .tkr__wrap { padding-block: 3.2vw; }



/* ------------------------------------------------------------- the band -- */
.veloura-tkr .tkr__band {
  display: flex;
  align-items: center;
  width: 130%;
  margin-inline-start: -15%;
  min-height: var(--tkr-height);
  overflow: hidden;
  /* The rounding is the BAND's, which is the thing the merchant sees; putting
     it on the wrap rounded the whole element around the ribbon. */
  border-radius: var(--tkr-radius, 16px);
  background: linear-gradient(90deg, var(--band-from), var(--band-to));
  color: var(--band-text);
  box-shadow: 0 10px 30px rgba(15, 23, 42, .18);
  /* A hairline along the top and bottom only. It costs nothing when the width
     is 0, and it is what gives the glass mode an edge to catch the light. */
  border-top: var(--tkr-edge, 0px) solid var(--tkr-edge-color, transparent);
  border-bottom: var(--tkr-edge, 0px) solid var(--tkr-edge-color, transparent);
}

.veloura-tkr.tkr--straight .tkr__band { width: 100%; margin-inline-start: 0; }
.veloura-tkr.tkr--bleed .tkr__band { border-radius: 0; }

/* The track carries N copies of the list and slides exactly ONE copy's width,
   so the moment it resets, copy 2 is standing where copy 1 began and the seam
   is invisible. The count is decided in the template from how many items the
   merchant wrote — a short list gets more copies — and arrives as --tkr-shift,
   which is why the keyframes read it from a variable instead of hard-coding
   -50%: with two copies and three words, the band ran out of content and the
   ribbon showed a gap on every pass. */
.veloura-tkr .tkr__track {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  flex: 0 0 auto;
  width: max-content;
  gap: var(--tkr-gap);
  padding-inline-end: var(--tkr-gap);
  animation: veloura-tkr-scroll var(--band-speed, var(--tkr-speed)) linear infinite;
}

.veloura-tkr .tkr__band--b .tkr__track { animation-direction: reverse; }
.veloura-tkr .tkr__band:hover .tkr__track { animation-play-state: paused; }

@keyframes veloura-tkr-scroll {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(var(--tkr-shift, -50%), 0, 0); }
}

/* The slide follows the page direction, and this is not cosmetic: in an RTL
   flex row the first copy sits at the RIGHT edge and the rest to its left, so
   sliding further left drags every copy out of the band and leaves a coloured
   ribbon with no words in it. */
@keyframes veloura-tkr-scroll-rtl {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(var(--tkr-shift-rtl, 50%), 0, 0); }
}

html[dir="rtl"] .veloura-tkr .tkr__track,
body[dir="rtl"] .veloura-tkr .tkr__track {
  animation-name: veloura-tkr-scroll-rtl;
}

.veloura-tkr .tkr__item {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
  gap: 8px;
  flex: 0 0 auto;
  color: inherit;
  font-size: var(--tkr-size);
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.veloura-tkr a.tkr__item:hover { text-decoration: underline; }

/* A gradient that travels through the letters instead of a flat colour.

   The gradient is painted on the text itself and clipped to the glyphs, and
   only the background POSITION animates — no layout, no repaint of anything
   else. background-clip: text needs the -webkit- prefix to work in Safari and
   in Chrome, so both are written. The icons keep the plain text colour: a
   clipped gradient on an icon font renders as a smear. */
.veloura-tkr.tkr--shine .tkr__item > span {
  background-image: linear-gradient(
    100deg,
    var(--band-text) 0%,
    var(--tkr-shine, #ffe9a8) 20%,
    var(--tkr-shine, #ffe9a8) 32%,
    var(--band-text) 50%,
    var(--band-text) 100%
  );
  background-size: 250% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
  animation: veloura-tkr-shine 4.5s linear infinite;
}

@keyframes veloura-tkr-shine {
  from { background-position: 250% 0; }
  to { background-position: -50% 0; }
}

@media (prefers-reduced-motion: reduce) {
  .veloura-tkr.tkr--shine .tkr__item > span {
    animation: none;
    background: none;
    color: var(--band-text);
    -webkit-text-fill-color: var(--band-text);
  }
}
.veloura-tkr .tkr__item i { font-size: calc(var(--tkr-size) + 3px); opacity: .9; }

.veloura-tkr .tkr__sep {
  flex: 0 0 auto;
  opacity: .55;
  font-size: calc(var(--tkr-size) - 1px);
}

/* ---------------------------------------------------------------- glass -- */
/* The theme's own tokens — the same ones the header, the search panel and the
   floating bottom menu use — so the ribbon follows dark mode with them.

   The merchant's colours are laid over that glass at a strength they set, and
   the default is high: at 22% the ribbon washed out to a pale smear, which is
   not what "زجاجي" is supposed to look like. The blur still reads because the
   layer stays translucent — it is the colour that is strong, not opaque. */
.veloura-tkr.tkr--glass .tkr__band {
  background-color: var(--veloura-glass-surface, rgba(248, 250, 252, .72));
  -webkit-backdrop-filter: var(--veloura-filter, blur(20px) saturate(124%));
  backdrop-filter: var(--veloura-filter, blur(20px) saturate(124%));
  border-top: 1px solid var(--veloura-glass-edge-top, rgba(100, 116, 139, .20));
  border-bottom: 1px solid var(--veloura-glass-edge-bottom, rgba(100, 116, 139, .12));
  box-shadow: 0 10px 30px var(--veloura-glass-shadow, rgba(15, 23, 42, .10));
  background-image: linear-gradient(
    90deg,
    color-mix(in srgb, var(--band-from) var(--band-tint, 70%), transparent),
    color-mix(in srgb, var(--band-to) var(--band-tint, 70%), transparent)
  );
}

/* Per band, because each one has its own switch. */
.veloura-tkr .tkr__band.is-glass {
  background-color: var(--veloura-glass-surface, rgba(248, 250, 252, .72));
  -webkit-backdrop-filter: var(--veloura-filter, blur(20px) saturate(124%));
  backdrop-filter: var(--veloura-filter, blur(20px) saturate(124%));
  border-top: 1px solid var(--veloura-glass-edge-top, rgba(100, 116, 139, .20));
  border-bottom: 1px solid var(--veloura-glass-edge-bottom, rgba(100, 116, 139, .12));
  background-image: linear-gradient(
    90deg,
    color-mix(in srgb, var(--band-from) var(--band-tint, 70%), transparent),
    color-mix(in srgb, var(--band-to) var(--band-tint, 70%), transparent)
  );
}

/* -------------------------------------------------------------- tilted --- */
.veloura-tkr.tkr--tilt .tkr__band { transform: rotate(calc(var(--tkr-angle) * -1)); }

/* Two bands crossing, in a stage tall enough to hold both without either one
   dragging the page taller. */
.veloura-tkr.tkr--cross .tkr__wrap {
  position: relative;
  height: max(calc(var(--tkr-height) * 2.9), calc(var(--tkr-height) + 7vw));
}

.veloura-tkr.tkr--cross .tkr__band {
  position: absolute;
  inset-inline: 0;
  top: 50%;
}

.veloura-tkr.tkr--cross .tkr__band--a { transform: translateY(-50%) rotate(calc(var(--tkr-angle) * -1)); z-index: 2; }
.veloura-tkr.tkr--cross .tkr__band--b { transform: translateY(-50%) rotate(var(--tkr-angle)); z-index: 1; }

/* One copy of the list is what a cycle travels, and on a phone that copy is
   physically narrower — smaller type, tighter gaps — so the same duration works
   out to fewer pixels per second and the ribbon crawls. The duration is scaled
   down to compensate; measured px/s at 1280 and at 390 come out within a few
   percent of each other with this factor. */
@media (max-width: 639px) {
  .veloura-tkr { --tkr-height: 40px; --tkr-size: 12.5px; --tkr-gap: 18px; }

  .veloura-tkr .tkr__track {
    animation-duration: calc(var(--band-speed, var(--tkr-speed)) * var(--tkr-mobile-speed, .5));
  }
  .veloura-tkr.tkr--cross .tkr__wrap { height: max(calc(var(--tkr-height) * 2.6), calc(var(--tkr-height) + 9vw)); }
}

/* Motion off in the system means a readable band, not a frozen half-scrolled
   one: the animation stops at the start. */
@media (prefers-reduced-motion: reduce) {
  .veloura-tkr .tkr__track { animation: none; transform: none; }
  .veloura-tkr .tkr__band { justify-content: center; }
}

</style>

  {# ---- the layout, unwrapped shape by shape ---------------------------- #}
  {% set tkr_raw = component.veloura_tkr_layout|default('') %}
  {% if tkr_raw.selected is defined %}{% set tkr_raw = tkr_raw.selected %}{% endif %}
  {% if tkr_raw is iterable and tkr_raw.value is not defined %}{% set tkr_raw = tkr_raw|first %}{% endif %}
  {% if tkr_raw.value is defined %}{% set tkr_raw = tkr_raw.value %}{% endif %}
  {% set tkr_layout = tkr_raw|default('cross') %}
  {% if tkr_layout is iterable or tkr_layout == '' %}{% set tkr_layout = 'cross' %}{% endif %}

  {% set tkr_is_tilted = tkr_layout == 'cross' or tkr_layout == 'tilt' %}
  {% set tkr_two = tkr_layout == 'cross' %}

  {# ---- the separator, same treatment ----------------------------------- #}
  {% set tkr_sraw = component.veloura_tkr_separator|default('') %}
  {% if tkr_sraw.selected is defined %}{% set tkr_sraw = tkr_sraw.selected %}{% endif %}
  {% if tkr_sraw is iterable and tkr_sraw.value is not defined %}{% set tkr_sraw = tkr_sraw|first %}{% endif %}
  {% if tkr_sraw.value is defined %}{% set tkr_sraw = tkr_sraw.value %}{% endif %}
  {% set tkr_sep_key = tkr_sraw|default('star') %}
  {% if tkr_sep_key is iterable or tkr_sep_key == '' %}{% set tkr_sep_key = 'star' %}{% endif %}
  {# Trimmed before the lookup: a key that arrives as "dot " misses the map and
     falls back to the star, which is indistinguishable from the setting being
     ignored. #}
  {% set tkr_sep_key = tkr_sep_key|trim %}
  {# The map is keyed by BOTH the stored value and the label the editor shows,
     and anything else short is taken literally. A dropdown can hand back the
     label instead of the value, and a key the map does not know falls through
     to the star — which is indistinguishable from the setting being ignored,
     and is what "الفاصل ما تغيّر" actually was. #}
  {% set tkr_sep_map = {
    'star': '✦', 'dot': '•', 'slash': '/', 'diamond': '◆', 'none': '',
    'نجمة ✦': '✦', 'نقطة •': '•', 'معيّن ◆': '◆', 'شرطة مائلة /': '/', 'بلا فاصل': ''
  } %}
  {% if tkr_sep_key in tkr_sep_map|keys %}
    {% set tkr_sep = tkr_sep_map[tkr_sep_key] %}
  {% elseif tkr_sep_key|length <= 3 %}
    {% set tkr_sep = tkr_sep_key %}
  {% else %}
    {% set tkr_sep = '✦' %}
  {% endif %}

  {# ---- the items -------------------------------------------------------- #}
  {% set tkr_items = component.veloura_tkr_items|default([]) %}
  {% if tkr_items is empty %}
    {# A section that renders nothing looks exactly like a broken one, and an
       instance saved before these fields existed carries no items at all. #}
    {% set tkr_items = [
      { 'icon': 'sicon-medal', 'text': 'ضمان الجودة' },
      { 'icon': 'sicon-shipping-fast', 'text': 'تسليم سريع' },
      { 'icon': 'sicon-star', 'text': 'تقييم 5 نجوم' },
      { 'icon': 'sicon-users', 'text': 'آلاف العملاء' },
      { 'icon': 'sicon-chat-conversation-alt', 'text': 'دعم 24/7' }
    ] %}
  {% endif %}

  {# The second band writes its own words; empty means "same as the first". #}
  {% set tkr_items_b = component.veloura_tkr2_items|default([]) %}
  {% if tkr_items_b is empty %}{% set tkr_items_b = tkr_items %}{% endif %}

  {# ---- how many copies each track needs ---------------------------------
     One copy is what the animation slides, so the track has to hold enough
     copies to cover the widest screen with content left over. Three words
     twice over do not reach across a desktop — that is the gap the ribbon
     showed on every pass — so the count grows as the list shrinks. #}
  {% set tkr_copies = max(3, (18 / (tkr_items|length))|round(0, 'ceil')) %}
  {% set tkr_copies_b = max(3, (18 / (tkr_items_b|length))|round(0, 'ceil')) %}
  {% set tkr_shift = (100 / tkr_copies)|round(4) %}
  {% set tkr_shift_b = (100 / tkr_copies_b)|round(4) %}

  {# The gutter, decided in one place: a custom number when the merchant set
     one, otherwise nothing at all while the ribbon is flush with the edges
     (the default) and the theme's own 10px when it is not. #}
  {% set tkr_gutter = 10 %}
  {% if component.veloura_tkr_full_width %}{% set tkr_gutter = 0 %}{% endif %}
  {% if component.veloura_tkr_custom_space %}{% set tkr_gutter = component.veloura_tkr_side_space|default(0) %}{% endif %}

  <section
    data-veloura-home-tab="{{ veloura_home_tab_key|e }}"
    id="veloura-ticker-{{ position }}"
    class="s-block veloura-tkr
      tkr--{{ tkr_layout }}
      {{ tkr_is_tilted ? 'tkr--tilted' : '' }}
      {{ component.veloura_tkr_full_width ? 'tkr--bleed' : 'tkr--boxed' }}
      tkr--shine
      {{ component.veloura_tkr_mobile_only ? 'veloura-mobile-only' : '' }}
      {{ component.veloura_tkr_desktop_only ? 'veloura-desktop-only' : '' }}
      {{ component.veloura_tkr_custom_classes }}"
    style="
      --tkr-height: {{ component.veloura_tkr_height|default(46) }}px;
      --tkr-size: {{ component.veloura_tkr_font_size|default(14) }}px;
      --tkr-gap: {{ component.veloura_tkr_gap|default(26) }}px;
      --tkr-speed: {{ component.veloura_tkr_speed|default(26) }}s;
      --tkr-radius: {{ component.veloura_tkr_radius|default(16) }}px;
      --tkr-edge: {{ component.veloura_tkr_border ? (component.veloura_tkr_border_width|default(1)) : 0 }}px;
      --tkr-edge-color: {{ component.veloura_tkr_border_color|default('rgba(255,255,255,.35)') }};
      --tkr-shine: {{ component.veloura_tkr_shine_color|default('#ffe9a8') }};
      --tkr-mobile-speed: {{ (component.veloura_tkr_mobile_speed|default(50)) / 100 }};
      --tkr-gutter: {{ tkr_gutter }}px;
    "
  >
    <div class="container">
    <div class="tkr__wrap">

      <div class="tkr__band tkr__band--a {{ component.veloura_tkr_glass ? 'is-glass' : '' }}"
        style="
          --band-from: {{ component.veloura_tkr_color_from|default('#7c3aed') }};
          --band-to: {{ component.veloura_tkr_color_to|default('#ec4899') }};
          --band-text: {{ component.veloura_tkr_text_color|default('#ffffff') }};
          --band-tint: {{ component.veloura_tkr_glass_tint|default(70) }}%;
          --tkr-shift: -{{ tkr_shift }}%;
          --tkr-shift-rtl: {{ tkr_shift }}%;
        ">
        <div class="tkr__track">
          {% for pass in 1..tkr_copies %}
            {% for item in tkr_items %}
              {% if item.text %}
                {% if item.url %}
                  <a class="tkr__item" href="{{ item.url }}">
                    {% if item.icon %}<i class="{{ item.icon }}" aria-hidden="true"></i>{% endif %}
                    <span>{{ item.text }}</span>
                  </a>
                {% else %}
                  <span class="tkr__item">
                    {% if item.icon %}<i class="{{ item.icon }}" aria-hidden="true"></i>{% endif %}
                    <span>{{ item.text }}</span>
                  </span>
                {% endif %}
                {% if tkr_sep %}<span class="tkr__sep" aria-hidden="true">{{ tkr_sep }}</span>{% endif %}
              {% endif %}
            {% endfor %}
          {% endfor %}
        </div>
      </div>

      {% if tkr_two %}
        {# Resolved in plain sets: a default nested inside another default is
           the kind of expression that quietly evaluates to nothing, and an
           empty --band-from makes the whole gradient invalid — which is a band
           that renders as two hairlines with no colour between them. #}
        {% set tkr2_from = component.veloura_tkr2_color_from %}
        {% if not tkr2_from %}{% set tkr2_from = component.veloura_tkr_color_to %}{% endif %}
        {% if not tkr2_from %}{% set tkr2_from = '#ec4899' %}{% endif %}
        {% set tkr2_to = component.veloura_tkr2_color_to %}
        {% if not tkr2_to %}{% set tkr2_to = component.veloura_tkr_color_from %}{% endif %}
        {% if not tkr2_to %}{% set tkr2_to = '#7c3aed' %}{% endif %}
        {% set tkr2_text = component.veloura_tkr2_text_color %}
        {% if not tkr2_text %}{% set tkr2_text = component.veloura_tkr_text_color %}{% endif %}
        {% if not tkr2_text %}{% set tkr2_text = '#ffffff' %}{% endif %}
        {% set tkr2_speed = component.veloura_tkr2_speed %}
        {% if not tkr2_speed %}{% set tkr2_speed = component.veloura_tkr_speed %}{% endif %}
        {% if not tkr2_speed %}{% set tkr2_speed = 26 %}{% endif %}

        <div class="tkr__band tkr__band--b {{ component.veloura_tkr2_glass ? 'is-glass' : '' }}"
          style="
            --band-from: {{ tkr2_from }};
            --band-to: {{ tkr2_to }};
            --band-text: {{ tkr2_text }};
            --band-tint: {{ component.veloura_tkr2_glass_tint|default(70) }}%;
            --band-speed: {{ tkr2_speed }}s;
            --tkr-shift: -{{ tkr_shift_b }}%;
            --tkr-shift-rtl: {{ tkr_shift_b }}%;
          " aria-hidden="true">
          <div class="tkr__track">
            {% for pass in 1..tkr_copies_b %}
              {% for item in tkr_items_b %}
                {% if item.text %}
                  <span class="tkr__item">
                    {% if item.icon %}<i class="{{ item.icon }}" aria-hidden="true"></i>{% endif %}
                    <span>{{ item.text }}</span>
                  </span>
                  {% if tkr_sep %}<span class="tkr__sep">{{ tkr_sep }}</span>{% endif %}
                {% endif %}
              {% endfor %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
    </div>
  </section>
{% endif %}