{# VELOURA HOME TAB ASSIGNMENT START #}
{% set veloura_home_tab_key = component.veloura_home_tab_name_2026|default('') %}
{% if veloura_home_tab_key.value is defined %}{% set veloura_home_tab_key = veloura_home_tab_key.value %}{% endif %}
{% if not veloura_home_tab_key %}{% set veloura_home_tab_key = 'always' %}{% endif %}
{# VELOURA HOME TAB ASSIGNMENT END #}

{# القيم الرقمية من لوحة الإعدادات تصل أحياناً ملفوفة في كائن ({value: 4})
   لا كرقم. طباعتها كما هي تنتج «px» بلا رقم، فتسقط الخاصية ويعود المتصفح
   للقيمة الافتراضية — وهذا هو سبب «الإعداد لا يعطي أي تأثير». هنا تُفكّ
   أولاً، ثم تُطبع. #}
{% set ultra_mcols = component.ultra_mobile_columns %}
{% if ultra_mcols.value is defined %}{% set ultra_mcols = ultra_mcols.value %}{% endif %}
{% if ultra_mcols.selected is defined %}{% set ultra_mcols = ultra_mcols.selected %}{% endif %}
{% if ultra_mcols is iterable %}{% set ultra_mcols = ultra_mcols|first %}{% endif %}
{% if ultra_mcols.value is defined %}{% set ultra_mcols = ultra_mcols.value %}{% endif %}
{% if ultra_mcols is iterable or ultra_mcols ~ '' == '' %}{% set ultra_mcols = 2 %}{% endif %}

{% set ultra_dcols = component.ultra_desktop_columns %}
{% if ultra_dcols.value is defined %}{% set ultra_dcols = ultra_dcols.value %}{% endif %}
{% if ultra_dcols.selected is defined %}{% set ultra_dcols = ultra_dcols.selected %}{% endif %}
{% if ultra_dcols is iterable %}{% set ultra_dcols = ultra_dcols|first %}{% endif %}
{% if ultra_dcols.value is defined %}{% set ultra_dcols = ultra_dcols.value %}{% endif %}
{% if ultra_dcols is iterable or ultra_dcols ~ '' == '' %}{% set ultra_dcols = 4 %}{% endif %}

{# المفاتيح تصل أحياناً ككائن ({value: false})، والكائن «صحيح» دائماً في
   الشرط — فيصير المفتاح مُفعّلاً وإن أطفأه التاجر. تُفكّ هنا إلى قيمة
   منطقية حقيقية قبل استعمالها. #}
{% set ultra_is_grid = component.ultra_display_grid %}
{% if ultra_is_grid.value is defined %}{% set ultra_is_grid = ultra_is_grid.value %}{% endif %}
{% if ultra_is_grid.selected is defined %}{% set ultra_is_grid = ultra_is_grid.selected %}{% endif %}
{% if ultra_is_grid is iterable %}{% set ultra_is_grid = ultra_is_grid|first %}{% endif %}
{% if ultra_is_grid.value is defined %}{% set ultra_is_grid = ultra_is_grid.value %}{% endif %}
{% set ultra_is_grid = ultra_is_grid == true or ultra_is_grid == 1 or ultra_is_grid == '1' or ultra_is_grid == 'true' or ultra_is_grid == 'on' %}

{% set ultra_is_masonry = component.ultra_masonry_layout %}
{% if ultra_is_masonry.value is defined %}{% set ultra_is_masonry = ultra_is_masonry.value %}{% endif %}
{% if ultra_is_masonry.selected is defined %}{% set ultra_is_masonry = ultra_is_masonry.selected %}{% endif %}
{% if ultra_is_masonry is iterable %}{% set ultra_is_masonry = ultra_is_masonry|first %}{% endif %}
{% if ultra_is_masonry.value is defined %}{% set ultra_is_masonry = ultra_is_masonry.value %}{% endif %}
{% set ultra_is_masonry = ultra_is_masonry == true or ultra_is_masonry == 1 or ultra_is_masonry == '1' or ultra_is_masonry == 'true' or ultra_is_masonry == 'on' %}

{% set ultra_peek = component.ultra_slider_show_partial %}
{% if ultra_peek.value is defined %}{% set ultra_peek = ultra_peek.value %}{% endif %}
{% if ultra_peek.selected is defined %}{% set ultra_peek = ultra_peek.selected %}{% endif %}
{% if ultra_peek is iterable %}{% set ultra_peek = ultra_peek|first %}{% endif %}
{% if ultra_peek.value is defined %}{% set ultra_peek = ultra_peek.value %}{% endif %}
{% set ultra_peek = ultra_peek == true or ultra_peek == 1 or ultra_peek == '1' or ultra_peek == 'true' or ultra_peek == 'on' %}

{# الفجوة كانت تُطبع كما تصل: لو وصلت ككائن خرج «--ultra-gap: Arraypx»،
   وهي قيمة غير صالحة تُفسد كل calc يعتمد عليها فيسقط العرض ويرجع كل عنصر
   لحجمه الطبيعي — وهذا هو سبب تضخّم الصور وتداخلها. #}
{% set ultra_gap = component.ultra_images_gap %}
{% if ultra_gap.value is defined %}{% set ultra_gap = ultra_gap.value %}{% endif %}
{% if ultra_gap.selected is defined %}{% set ultra_gap = ultra_gap.selected %}{% endif %}
{% if ultra_gap is iterable %}{% set ultra_gap = ultra_gap|first %}{% endif %}
{% if ultra_gap.value is defined %}{% set ultra_gap = ultra_gap.value %}{% endif %}
{% if ultra_gap is iterable or ultra_gap ~ '' == '' %}{% set ultra_gap = 16 %}{% endif %}
{% set ultra_gap = ultra_gap + 0 %}

{% set ultra_mcols = ultra_mcols + 0 %}
{% set ultra_dcols = ultra_dcols + 0 %}
{% if ultra_mcols < 1 %}{% set ultra_mcols = 1 %}{% endif %}
{% if ultra_dcols < 1 %}{% set ultra_dcols = 1 %}{% endif %}

{% set ultra_id = 'veloura-ultra-' ~ position %}

{% set radius_map = {
  'sharp': '0px',
  'soft': '8px',
  'medium': '16px',
  'large': '28px',
  'round': '999px',
  '40': '999px'
} %}

{% set title_size_map = {
  'xs': '12px',
  'sm': '14px',
  'md': '18px',
  'lg': '22px',
  'xl': '28px',
  'xxl': '36px'
} %}

{% set subtitle_size_map = {
  'xs': '11px',
  'sm': '13px',
  'md': '15px',
  'lg': '18px',
  'xl': '22px'
} %}

{% set radius_key = component.ultra_image_radius|default('medium') %}
{% if radius_key is iterable and radius_key[0].value is defined %}
  {% set radius_key = radius_key[0].value %}
{% elseif radius_key.value is defined %}
  {% set radius_key = radius_key.value %}
{% endif %}

{% set section_classes = [
  's-block',
  'ultra-square-images',
  ultra_is_grid ? 'is-grid' : 'is-slider',
  ultra_is_masonry and ultra_is_grid ? 'is-masonry' : '',
  component.ultra_custom_horizontal_spacing ? 'has-spacing' : '',
  component.ultra_show_mobile_only ? 'ultra-mobile-only' : '',
  component.ultra_show_desktop_only ? 'ultra-desktop-only' : '',
  component.ultra_custom_classes ?: ''
]|join(' ') %}

{% if not component.ultra_hide_section %}
<style>
/* الأعمدة تُكتب هنا بأرقامها الصريحة لا عبر متغيّرات CSS:

   • القاعدة التي تقرأها في ملف الستايل المبني قد تكون أقدم من القالب على
     المتجر فلا توجد أصلاً.
   • والمتغيّر إن وصلته قيمة غير صالحة أسقط الحساب كله وأعاد كل صورة إلى
     حجمها الطبيعي — وهو ما كان يضخّم الصور ويجعلها تتداخل.

   والمعرّف يخص هذا القسم وحده، فلا يؤثر على نسخة أخرى منه في الصفحة. */
#{{ ultra_id }} img { max-width: 100%; }

#{{ ultra_id }}:not(.is-masonry) .ultra-square-images__grid {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: {{ ultra_gap }}px !important;
  align-items: stretch;
}

#{{ ultra_id }}:not(.is-masonry) .ultra-square-images__grid > .ultra-square-images__item {
  width: calc((100% - ({{ ultra_gap }}px * {{ ultra_mcols - 1 }})) / {{ ultra_mcols }}) !important;
  max-width: none !important;
  flex: 0 0 auto !important;
  grid-column: auto !important;
  grid-row: auto !important;
}

#{{ ultra_id }}.is-masonry .ultra-square-images__grid {
  display: grid !important;
  grid-template-columns: repeat({{ ultra_mcols }}, minmax(0, 1fr)) !important;
  gap: {{ ultra_gap }}px !important;
}

#{{ ultra_id }}.is-masonry .ultra-square-images__grid > .ultra-square-images__item { width: auto !important; }

@media (min-width: 768px) {
  #{{ ultra_id }}:not(.is-masonry) .ultra-square-images__grid > .ultra-square-images__item {
    width: calc((100% - ({{ ultra_gap }}px * {{ ultra_dcols - 1 }})) / {{ ultra_dcols }}) !important;
  }

  #{{ ultra_id }}.is-masonry .ultra-square-images__grid {
    grid-template-columns: repeat({{ ultra_dcols }}, minmax(0, 1fr)) !important;
  }
}
</style>


<section data-veloura-home-tab="{{ veloura_home_tab_key|e }}"
  id="{{ ultra_id }}"
  class="{{ section_classes }}"
  data-ultra-gap="{{ ultra_gap }}"
  data-ultra-cols="{{ ultra_mcols }}/{{ ultra_dcols }}"
  data-ultra-mode="{{ ultra_is_grid ? (ultra_is_masonry ? 'masonry' : 'grid') : 'slider' }}"
  style="
    --ultra-gap: {{ ultra_gap }}px;
    --ultra-radius: {{ radius_map[radius_key]|default((radius_key ~ '' == '' ? '16' : radius_key) ~ 'px') }};
    --ultra-mobile-columns: {{ ultra_mcols }};
    --ultra-desktop-columns: {{ ultra_dcols }};
    --ultra-horizontal-spacing: {{ component.ultra_custom_horizontal_spacing ? component.ultra_horizontal_spacing|default(0) : 0 }}px;
  "
>
  {% if component.ultra_custom_horizontal_spacing %}
    <div class="ultra-square-images__container">
  {% else %}
    <div class="container ultra-square-images__container">
  {% endif %}

    {% if component.ultra_section_title or component.ultra_section_subtitle %}
      <div class="ultra-square-images__heading veloura-component-title" data-veloura-section-heading>
        {% if component.ultra_section_title %}
          <h2 style="color: {{ component.ultra_section_text_color|default('#222222') }};">
            {{ component.ultra_section_title }}
          </h2>
        {% endif %}

        {% if component.ultra_section_subtitle %}
          <p style="color: {{ component.ultra_section_text_color|default('#222222') }};">
            {{ component.ultra_section_subtitle }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    {% if ultra_is_grid %}
      <div
        class="ultra-square-images__grid"
        style="justify-content: {{ component.ultra_rows_center ? 'center' : 'flex-start' }};"
      >
        {% for banner in component.ultra_banners %}
          {% set image_src = banner.image %}
          {% if banner.use_image_url and banner.image_url %}
            {% set image_src = banner.image_url %}
          {% endif %}

          {% set sizes = ['tall', 'short', 'normal', 'tall', 'large', 'normal', 'wide', 'short'] %}
{% set card_size = sizes[loop.index0 % sizes|length] %}

          {% if image_src %}
            <div class="ultra-square-images__item ultra-square-images__item--{{ card_size }}">
              <a href="{{ banner.url ?: '#' }}" class="ultra-square-images__card">
                <img src="{{ image_src }}" alt="{{ banner.title ?: 'image' }}" loading="lazy">

                {% if component.ultra_text_on_image and (banner.title or banner.description) %}
                  <div class="ultra-square-images__content is-on-image {{ component.ultra_title_overlay ? 'has-overlay' : '' }} {{ component.ultra_center_text ? 'is-centered' : 'is-start' }}">
                    {% if banner.title %}
                      <h3 dir="auto" style="font-size: {{ title_size_map[component.ultra_title_size|default('md')]|default('18px') }};">
                        {{ banner.title|raw }}
                      </h3>
                    {% endif %}

                    {% if banner.description %}
                      <p dir="auto" style="font-size: {{ subtitle_size_map[component.ultra_subtitle_size|default('sm')]|default('13px') }};">
                        {{ banner.description|raw }}
                      </p>
                    {% endif %}
                  </div>
                {% endif %}
              </a>

              {% if not component.ultra_text_on_image and (banner.title or banner.description) %}
                <div class="ultra-square-images__content is-below-image {{ component.ultra_center_text ? 'is-centered' : 'is-start' }}">
                  {% if banner.title %}
                    <h3 dir="auto" style="font-size: {{ title_size_map[component.ultra_title_size|default('md')]|default('18px') }};">
                      {{ banner.title|raw }}
                    </h3>
                  {% endif %}

                  {% if banner.description %}
                    <p dir="auto" style="font-size: {{ subtitle_size_map[component.ultra_subtitle_size|default('sm')]|default('13px') }};">
                      {{ banner.description|raw }}
                    </p>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <salla-slider
        id="ultra-square-images-{{ position }}"
        pagination
        {% if component.ultra_slider_autoplay %}auto-play{% endif %}
        {% if component.ultra_slider_loop %}loop{% endif %}
        {{ component.ultra_slider_hide_arrows ? 'show-controls="false"' : '' }}
        static-when-single
        slider-config='{
          {# «إظهار جزء من التالية» كان يفرض 1.35 على الجوال مهما كان العدد،
             فيبتلع الإعداد تماماً. صار يضيف كسراً للعدد المختار لا يستبدله. #}
          "slidesPerView": {{ ultra_peek ? ultra_mcols + 0.35 : ultra_mcols }},
          "spaceBetween": {{ ultra_gap }},
          "freeMode": {{ component.ultra_slider_free_mode ? "true" : "false" }},
          "autoplay": {{ component.ultra_slider_autoplay ? "{\"delay\": 1200, \"disableOnInteraction\": false}" : "false" }},
          "breakpoints": {
            "768": {
              "slidesPerView": {{ ultra_peek ? ultra_dcols + 0.35 : ultra_dcols }},
              "spaceBetween": {{ ultra_gap }}
            }
          }
        }'
      >
        <div slot="items">
          {% for banner in component.ultra_banners %}
            {% set image_src = banner.image %}
            {% if banner.use_image_url and banner.image_url %}
              {% set image_src = banner.image_url %}
            {% endif %}

            {% if image_src %}
              <div class="swiper-slide">
                <div class="ultra-square-images__item">
                  <a href="{{ banner.url ?: '#' }}" class="ultra-square-images__card">
                    <img src="{{ image_src }}" alt="{{ banner.title ?: 'image' }}" loading="lazy">

                    {% if component.ultra_text_on_image and (banner.title or banner.description) %}
                      <div class="ultra-square-images__content is-on-image {{ component.ultra_title_overlay ? 'has-overlay' : '' }} {{ component.ultra_center_text ? 'is-centered' : 'is-start' }}">
                        {% if banner.title %}
                          <h3 dir="auto" style="font-size: {{ title_size_map[component.ultra_title_size|default('md')]|default('18px') }};">
                            {{ banner.title|raw }}
                          </h3>
                        {% endif %}

                        {% if banner.description %}
                          <p dir="auto" style="font-size: {{ subtitle_size_map[component.ultra_subtitle_size|default('sm')]|default('13px') }};">
                            {{ banner.description|raw }}
                          </p>
                        {% endif %}
                      </div>
                    {% endif %}
                  </a>

                  {% if not component.ultra_text_on_image and (banner.title or banner.description) %}
                    <div class="ultra-square-images__content is-below-image {{ component.ultra_center_text ? 'is-centered' : 'is-start' }}">
                      {% if banner.title %}
                        <h3 dir="auto" style="font-size: {{ title_size_map[component.ultra_title_size|default('md')]|default('18px') }};">
                          {{ banner.title|raw }}
                        </h3>
                      {% endif %}

                      {% if banner.description %}
                        <p dir="auto" style="font-size: {{ subtitle_size_map[component.ultra_subtitle_size|default('sm')]|default('13px') }};">
                          {{ banner.description|raw }}
                        </p>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </salla-slider>
    {% endif %}

  </div>
</section>
{% endif %}