<section id="veloura-newsletter" aria-labelledby="veloura-newsletter-heading" dir="rtl" data-glass="{{ vn_glass ? 'true' : 'false' }}" style="--vn-width:{{ vn_width }}px;--vn-radius:{{ vn_radius }}px;--vn-bg:{{ vn_bg }};--vn-dark-bg:{{ vn_dark_bg }};--vn-text:{{ vn_text }};--vn-dark-text:{{ vn_dark_text }};--vn-button-bg:{{ vn_button_bg }};--vn-button-text:{{ vn_button_text }};--vn-field-bg:{{ vn_field_bg }};--vn-field-text:{{ vn_field_text }};--vn-opacity:{{ vn_opacity }}%;">
  <div class="vn-card">
    {% if vn_image %}<div class="vn-image" style="background-image:url('{{ vn_image|e('html_attr') }}')" aria-hidden="true"></div>{% endif %}
    <div class="vn-content">
      {% if vn_icon %}<span class="vn-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></svg></span>{% endif %}
      <div class="vn-copy"><h2 id="veloura-newsletter-heading">{{ vn_title|e }}</h2>{% if vn_description %}<p>{{ vn_description|e }}</p>{% endif %}</div>
      <form class="vn-form">
        <label class="sr-only" for="veloura-newsletter-email">البريد الإلكتروني</label>
        <div class="vn-input-row"><input id="veloura-newsletter-email" type="email" inputmode="email" autocomplete="email" placeholder="{{ vn_placeholder|e('html_attr') }}" required aria-describedby="veloura-newsletter-note"><button type="submit">{{ vn_button|e }}<span aria-hidden="true">←</span></button></div>
        <p id="veloura-newsletter-note" class="vn-note" role="status" aria-live="polite">معاينة تجريبية — الاشتراك غير متاح بعد.</p>
      </form>
