<script id="veloura-footer-match-header-v60">
(() => {
const footer=document.getElementById('veloura-footer');
if(!footer)return;
let observed=null,frame=0;
const sync=()=>{
 frame=0;
 const header=document.querySelector('.veloura-header-tabs-stack__surface');
 if(!header)return;
 if(observed!==header){if(observed)observer.unobserve(observed);observed=header;observer.observe(header);}
 const width=header.getBoundingClientRect().width;
 if(width>0)footer.style.setProperty('--veloura-footer-frame-width',width+'px');
};
const schedule=()=>{if(!frame)frame=requestAnimationFrame(sync);};
const observer=new ResizeObserver(schedule);
sync();document.addEventListener('DOMContentLoaded',schedule,{once:true});window.addEventListener('load',schedule,{once:true});window.addEventListener('resize',schedule,{passive:true});
})();
</script>

