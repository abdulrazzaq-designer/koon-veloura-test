  {{ search_detached ? 'veloura-top-search-detached' : '' }}
  {# Bug fixed 2026-09: this used to require "not search_detached", so
     detaching the search dropped .veloura-header-balanced-search and the
     header fell back to an older grid (grid-template-areas: 'left logo
     right') that targets grid children named .veloura-header-left /
     .veloura-header-right directly. Those elements are nested a level
     deeper now, inside .veloura-header__tools, so that fallback grid had no
     element to place in either named area and the header's whole layout
     (icon grouping, logo centering) broke. The balanced-search grid
     (V63/V64 below) has no such assumption — when detached, its search
     track (column 1) is simply empty, which is harmless in CSS Grid — so
     applying it unconditionally for bar/bar_sticky_icon fixes detached
     search without a fallback layout to keep in sync. #}
  {{ desktop_search in ['bar', 'bar_sticky_icon'] ? 'veloura-header-balanced-search' : '' }}
  {{ hide_lang_desktop ? 'veloura-top-hide-lang-desktop' : '' }}
  {{ top_hide_on_scroll ? 'veloura-hide-top-on-scroll' : '' }}

  veloura-top-border-{{ top_border }}
  veloura-top-icons-{{ icons_size }}

  veloura-mobile-search-{{ mobile_search }}
  veloura-desktop-search-{{ desktop_search }}
  veloura-desktop-menu-{{ desktop_menu_mode }}
  "
  data-veloura-header="true"
  data-veloura-floating="{{ top_floating ? 'true' : 'false' }}"
  data-veloura-compact="{{ top_compact_on_scroll ? 'true' : 'false' }}"
  data-veloura-blur="{{ top_blur ? 'true' : 'false' }}"
  data-veloura-hide-scroll="{{ top_hide_on_scroll ? 'true' : 'false' }}"
  data-veloura-search-detached="{{ search_detached ? 'true' : 'false' }}"
  style="
    --veloura-top-bg: {{ top_bg }};
    --veloura-header-solid-bg: {{ top_bg }};
    --veloura-top-text: {{ top_text }};
    --veloura-top-cart-bg: {{ top_cart_bg }};
    --veloura-top-logo-size: {{ top_logo_size_px }}px;
  "
>
  <div id="mainnav" class="main-nav-container">
    <div class="inner w-full">
      <div class="veloura-header-container">
        <div class="veloura-header-grid">

          <div class="veloura-header__tools">
            <div class="veloura-header-left">
              {# Mobile/desktop physical LEFT group: cart → login. #}
              <salla-cart-summary class="veloura-header__cart veloura-cart-summary {{ hide_cart_total_mobile ? 'veloura-cart-hide-total veloura-cart-icon-only-mobile' : 'veloura-cart-total-visible' }}">
                <span slot="icon" class="veloura-cart-custom-icon">
                  <i class="{{ top_cart_icon }}"></i>
                </span>
              </salla-cart-summary>

              <button type="button" class="veloura-header-icon veloura-login-btn" onclick="salla.event.dispatch('login::open')" aria-label="تسجيل الدخول">
                <i class="{{ top_login_icon }}"></i>
                {# Desktop shows the words beside the icon, in a pill that matches
                   the language/currency control. CSS hides the label on mobile. #}
                <span class="veloura-login-btn__label">تسجيل الدخول</span>
              </button>

              {% if mobile_search == 'icon_left' %}
                <button type="button" class="veloura-header-icon veloura-search-toggle" onclick="window.__velouraOpenSearch ? window.__velouraOpenSearch() : salla.event.dispatch('search::open')" aria-label="بحث">
                  <i class="sicon-search"></i>
                </button>
              {% endif %}

              {% if dark_enabled and dark_toggle_enabled and dark_pos == 'left' %}
                <button type="button" class="veloura-header-icon veloura-dark-toggle" aria-label="تبديل الوضع الداكن">
                  <i class="sicon-moon veloura-dark-toggle__icon"></i>
                </button>
              {% endif %}
            </div>

            <div class="veloura-header-right">
              {# Physical RIGHT group: menu → dark → language → search/wishlist toward the logo. #}
              <div class="veloura-header__menu">
                <a class="veloura-header-icon veloura-menu-trigger-mobile mburger mburger--collapse" href="#mobile-menu" aria-label="فتح القائمة">
                  <i class="{{ top_menu_icon }}"></i>
                </a>
              </div>

              {% if dark_enabled and dark_toggle_enabled and dark_pos == 'right' %}
                <button type="button" class="veloura-header-icon veloura-dark-toggle" aria-label="تبديل الوضع الداكن">
                  <i class="sicon-moon veloura-dark-toggle__icon"></i>
                </button>
              {% endif %}

              {% if show_mobile_lang and localization_available %}
                <button type="button" class="veloura-header-icon veloura-lang-mobile" data-veloura-localization-trigger aria-label="اللغة والعملة">
                  <i class="sicon-earth"></i>
                </button>
              {% endif %}

              {# Always rendered now: bar/bar_sticky_icon modes need this icon
                 too, as the fallback shown once the header compacts on
                 scroll (the search bar always collapses to an icon then —
                 see header.scss / header-tabs.scss). CSS hides it whenever
                 the full bar is visible. #}
              {# ONE search button, rendered into the cluster the MOBILE setting
                 asks for. Never two: two buttons both carrying
                 salla.event.dispatch('search::open') opened two dialogs.

                 Why the mobile setting decides the markup, and the laptop
                 setting does not:

                   mobile  — .veloura-header-left / -right are real boxes
                             (measured: x=27 and x=181, display:flex), and every
                             order is 0. Nothing but the DOM decides the side,
                             and no CSS property moves a node between parents.
                   laptop  — the same two elements are display:contents, so they
                             dissolve into one flat row and `order` alone
                             decides position, whichever cluster the button was
                             printed into.

                 So the template answers mobile and the stylesheet answers the
                 laptop, and neither has to fight the other.

                 V24: the onclick now calls window.__velouraOpenSearch() when it
                 exists — that is the bottom-nav's rounded glass search panel,
                 exposed globally in app.js so every trigger in the document
                 opens the SAME styled panel instead of the shared component's
                 own bare default modal. It only exists when the bottom nav
                 feature is on; otherwise this falls back to the plain
                 dispatch, same as before. #}
              {% if mobile_search != 'icon_left' %}
                <button type="button" class="veloura-header-icon veloura-search-toggle" onclick="window.__velouraOpenSearch ? window.__velouraOpenSearch() : salla.event.dispatch('search::open')" aria-label="بحث">
                  <i class="sicon-search"></i>
                </button>
              {% endif %}

              {% if show_wishlist %}
                <a class="veloura-header-icon veloura-wishlist-btn" href="{{ store.url }}/wishlist" aria-label="المفضلة">
                  <i class="sicon-heart"></i>
                </a>
              {% endif %}

              {% if localization_available and not hide_lang_desktop %}
                <button type="button" class="veloura-header-icon veloura-lang-desktop veloura-localization-pill" data-veloura-localization-trigger aria-label="اللغة والعملة">
                  <span class="veloura-localization-pill__language" data-veloura-language-label>{{ language.code == 'ar' ? 'العربية' : 'English' }}</span>
                  <span class="veloura-localization-pill__divider" aria-hidden="true"></span>
                  <span class="veloura-localization-pill__currency" data-veloura-currency-label></span>
                </button>
              {% endif %}
            </div>
          </div>

          <a class="navbar-brand veloura-header-logo" href="{{ store.url }}">
            {% if top_logo_is_video %}
              <video class="veloura-store-logo veloura-store-logo-video" src="{{ top_logo }}" autoplay muted loop playsinline data-light-logo="{{ top_logo }}" data-dark-logo="{{ theme.settings.get('veloura_dark_logo_2026') }}" aria-label="{{ store.name }} logo"></video>
            {% else %}
              <img fetchpriority="high" width="100%" height="100%" loading="eager" src="{{ top_logo }}" data-light-logo="{{ top_logo }}" data-dark-logo="{{ theme.settings.get('veloura_dark_logo_2026') }}" class="veloura-store-logo" alt="{{ store.name }} logo">
            {% endif %}

            {% if is_page('index') %}
              <h1 class="sr-only">{{ store.name }}</h1>
            {% else %}
              <h2 class="sr-only">{{ store.name }}</h2>
            {% endif %}
          </a>

          <div class="veloura-menu-links-wrap" data-veloura-desktop-menu-links>
            {# The menu is a web component rendered by JS, so the setting is
               handed to it as an attribute rather than baked into markup. #}
            <custom-main-menu data-veloura-menu-icons="{{ menu_desktop_icons ? 'true' : 'false' }}"></custom-main-menu>
          </div>

          {# ==========================================================
             Side-menu extras: the store logo at the head of the drawer and
             the three items pinned to its bottom.

             Rendered here, hidden, and moved into the drawer by app.js once
             mmenu-light has built it. It cannot be written directly into the
             drawer: #mobile-menu is generated by custom-main-menu in JS, and
             mmenu then rebuilds that markup into its own panel structure, so
             anything placed inside it up front is either rebuilt or dropped.
             Rendering in Twig keeps the content server-side, which is what
             gives us the logo, the settings and Salla's own components
             without re-fetching anything.

             The two expandable rows are <details>, so opening and closing
             them is the browser's own behaviour — no JS, and it keeps
             working even if the script never runs. Content comes from the
             same Salla components the footer already uses. ========== #}
          {# Normalised one switch at a time, deliberately WITHOUT a {% for %}.
             Twig scopes a for block: anything {% set %} inside it is local to
             the loop and is gone after {% endfor %}, so building these flags in
             a loop left every one of them undefined — the whole block then
             evaluated as false and nothing rendered at all.

             A switch can come back as a bare value, as {value: …}, or wrapped
             in {selected: …}; the two-step read below covers all three, and is
             the same shape footer.twig already uses. #}
          {% set vsm_logo_raw = theme.settings.get('veloura_side_menu_logo_2026', true) %}
          {% if vsm_logo_raw.value is defined %}{% set vsm_logo_raw = vsm_logo_raw.value %}
          {% elseif vsm_logo_raw.selected is defined %}{% set vsm_logo_raw = vsm_logo_raw.selected %}{% endif %}
          {% set vsm_logo = vsm_logo_raw in [true, 1, '1', 'true', 'on'] %}

          {% set vsm_links_raw = theme.settings.get('veloura_side_menu_links_2026', true) %}
          {% if vsm_links_raw.value is defined %}{% set vsm_links_raw = vsm_links_raw.value %}
          {% elseif vsm_links_raw.selected is defined %}{% set vsm_links_raw = vsm_links_raw.selected %}{% endif %}
          {% set vsm_links = vsm_links_raw in [true, 1, '1', 'true', 'on'] %}

          {% set vsm_support_raw = theme.settings.get('veloura_side_menu_support_2026', true) %}
          {% if vsm_support_raw.value is defined %}{% set vsm_support_raw = vsm_support_raw.value %}
          {% elseif vsm_support_raw.selected is defined %}{% set vsm_support_raw = vsm_support_raw.selected %}{% endif %}
          {% set vsm_support = vsm_support_raw in [true, 1, '1', 'true', 'on'] %}

          {% set vsm_currency_raw = theme.settings.get('veloura_side_menu_currency_2026', true) %}
          {% if vsm_currency_raw.value is defined %}{% set vsm_currency_raw = vsm_currency_raw.value %}
          {% elseif vsm_currency_raw.selected is defined %}{% set vsm_currency_raw = vsm_currency_raw.selected %}{% endif %}
          {% set vsm_currency = vsm_currency_raw in [true, 1, '1', 'true', 'on'] %}

          {% if vsm_logo or vsm_links or vsm_support or vsm_currency %}
            <div id="veloura-side-menu-extras" data-veloura-side-menu-extras hidden aria-hidden="true">

              {% if vsm_logo and top_logo %}
                <div class="veloura-side-menu-logo" data-veloura-side-menu-logo>
                  <a href="{{ store.url }}" aria-label="{{ store.name }}">
                    <img src="{{ top_logo }}"
                         data-light-logo="{{ top_logo }}"
                         data-dark-logo="{{ theme.settings.get('veloura_dark_logo_2026') }}"
                         class="veloura-store-logo"
                         loading="lazy"
                         alt="{{ store.name }} logo">
                  </a>
                </div>
              {% endif %}

              {% if vsm_links or vsm_support or vsm_currency %}
                <div class="veloura-side-menu-pinned" data-veloura-side-menu-pinned>

                  {% if vsm_links %}
                    <details class="veloura-side-menu-row" data-veloura-side-row="links">
                      <summary class="veloura-side-menu-row__head">
                        <i class="sicon-link veloura-side-menu-row__icon" aria-hidden="true"></i>
                        <span class="veloura-side-menu-row__label">{{ theme.settings.get('veloura_side_menu_links_title_2026') ?: 'روابط تهمك' }}</span>
                        <i class="sicon-keyboard_arrow_left veloura-side-menu-row__chevron" aria-hidden="true"></i>
                      </summary>
                      <div class="veloura-side-menu-row__panel">
                        {# Same source the footer uses for the informational pages. #}
                        <salla-menu source="footer"></salla-menu>
                      </div>
                    </details>
                  {% endif %}

                  {% if vsm_support %}
                    <details class="veloura-side-menu-row" data-veloura-side-row="support">
                      <summary class="veloura-side-menu-row__head">
                        <i class="sicon-chat-conversation-alt veloura-side-menu-row__icon" aria-hidden="true"></i>
                        <span class="veloura-side-menu-row__label">{{ theme.settings.get('veloura_side_menu_support_title_2026') ?: 'خدمة العملاء' }}</span>
                        <i class="sicon-keyboard_arrow_left veloura-side-menu-row__chevron" aria-hidden="true"></i>
                      </summary>
                      <div class="veloura-side-menu-row__panel">
                        {# The store's own contact channels, as in the footer. #}
                        <salla-contacts></salla-contacts>
                      </div>
                    </details>
                  {% endif %}

                  {% if vsm_currency and localization_available %}
                    {# No chevron: this opens the language/currency dialog the
                       header already uses, rather than expanding in place. #}
                    <button type="button"
                            class="veloura-side-menu-row veloura-side-menu-row--action"
                            data-veloura-side-row="currency"
                            data-veloura-localization-trigger>
                      <span class="veloura-side-menu-row__head">
                        <i class="sicon-wallet veloura-side-menu-row__icon" aria-hidden="true"></i>
                        <span class="veloura-side-menu-row__label">{{ theme.settings.get('veloura_side_menu_currency_title_2026') ?: 'العملة' }}</span>
                      </span>
                    </button>
                  {% endif %}

                </div>
              {% endif %}
            </div>
          {% endif %}

          {# SINGLE-SEARCH CONTRACT (see master.twig #veloura-search-park).

             Every <salla-search> instance registers its OWN
             salla.event.on('search::open') listener in its constructor, and
             every instance — `inline` ones included — renders its own
             <salla-modal>. Rendering a mobile bar and a desktop bar here (plus
             the page modal and the bottom-nav panel) therefore meant one click
             on the search icon opened FOUR or FIVE stacked dialogs.

             These wrappers are now empty placement slots. app.js keeps exactly
             one <salla-search> in the document and moves it into whichever slot
             is currently visible, so the layout rules below (which are keyed on
             .veloura-mobile-search-bar / .veloura-desktop-search-bar) are
             untouched while only one dialog can ever open. #}
          {% if not search_detached %}
            <div
              class="veloura-mobile-search-bar veloura-search-surface"
              data-veloura-search-slot="header-mobile"
              data-veloura-search-height="36"
            ></div>

            <div
              class="veloura-desktop-search-bar veloura-search-surface"
              data-veloura-search-slot="header-desktop"
              data-veloura-search-height="36"
            ></div>
          {% endif %}

        </div>
      </div>
    </div>
  </div>

  {% if localization_available %}
    <salla-localization-modal class="veloura-localization-modal-host"></salla-localization-modal>
  {% endif %}
</header>