<header
  class="store-header
  veloura-top-enabled
  {{ top_floating ? 'veloura-top-floating' : '' }}
  {{ top_compact_on_scroll ? 'veloura-top-compact-on-scroll' : '' }}
  {{ top_blur ? 'veloura-top-blur' : '' }}
  {{ top_logo_center ? 'veloura-top-logo-centered' : '' }}
